---
import Base from '../../layouts/Base.astro';
import '../../styles/account.css';

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3001';
---

<Base title="set new password — whittly" description="Set a new password for your whittly account.">
  <div class="ac-auth-wrap">
    <div class="ac-auth-card">
      <div class="ac-auth-top">
        <div class="ac-auth-tag">// account</div>
        <h1 class="ac-auth-title">set new password</h1>
      </div>

      <div class="ac-auth-body">
        <div class="ac-error-msg" id="errMsg"></div>
        <div class="ac-success-msg" id="okMsg"></div>

        <div class="ac-field">
          <label for="password">new password <span style="color:var(--ink-faint);font-size:10px;">(min 8 chars)</span></label>
          <input class="ac-input" id="password" type="password" autocomplete="new-password" placeholder="••••••••" />
        </div>

        <button class="ac-btn" id="submitBtn">set password</button>
      </div>
    </div>
  </div>
</Base>

<script is:inline define:vars={{ API }}>
(function () {
  var passEl   = document.getElementById('password');
  var submitEl = document.getElementById('submitBtn');
  var errEl    = document.getElementById('errMsg');
  var okEl     = document.getElementById('okMsg');

  var token = new URLSearchParams(location.search).get('token');
  if (!token) {
    document.getElementById('errMsg').textContent = 'invalid or missing reset token';
    document.getElementById('errMsg').classList.add('visible');
    submitEl.disabled = true;
  }

  function showError(msg) { errEl.textContent = msg; errEl.classList.add('visible'); }
  function showOk(msg)    { okEl.textContent  = msg; okEl.classList.add('visible'); }

  async function submit() {
    errEl.classList.remove('visible');
    var password = passEl.value;
    if (password.length < 8) { showError('password must be at least 8 characters'); return; }

    submitEl.disabled = true;
    submitEl.textContent = 'saving…';

    try {
      var res  = await fetch(API + '/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token, password }),
      });
      var data = await res.json();

      if (!res.ok) { showError(data.error ?? 'something went wrong'); submitEl.disabled = false; submitEl.textContent = 'set password'; return; }

      showOk('password updated — redirecting to sign in…');
      setTimeout(function () { location.replace('/account/login/'); }, 2000);
    } catch {
      showError('server unavailable — please try again in a moment');
      submitEl.disabled = false;
      submitEl.textContent = 'set password';
    }
  }

  submitEl.addEventListener('click', submit);
  passEl.addEventListener('keydown', function (e) { if (e.key === 'Enter') submit(); });
})();
</script>
