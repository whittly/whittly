---
import Base from '../../../layouts/Base.astro';
import '../../../styles/account.css';

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3001';
---

<Base title="войти — whittly" description="Войдите в аккаунт whittly.">
  <div class="ac-auth-wrap">
    <div class="ac-auth-card">
      <div class="ac-auth-top">
        <div class="ac-auth-tag">// аккаунт</div>
        <h1 class="ac-auth-title">войти</h1>
      </div>

      <div class="ac-auth-body">
        <div class="ac-error-msg" id="errMsg"></div>

        <div class="ac-field">
          <label for="email">email</label>
          <input class="ac-input" id="email" type="email" autocomplete="email" spellcheck="false" placeholder="you@example.com" />
        </div>

        <div class="ac-field">
          <label for="password">пароль</label>
          <input class="ac-input" id="password" type="password" autocomplete="current-password" placeholder="••••••••" />
        </div>

        <button class="ac-btn" id="submitBtn">войти</button>

        <div class="ac-footer-row">
          <a class="ac-footer-link" href="/ru/account/signup/">нет аккаунта? <em>создать →</em></a>
        </div>
      </div>
    </div>
  </div>
</Base>

<script is:inline define:vars={{ API }}>
(function () {
  if (localStorage.getItem('wh_access')) {
    location.replace('/ru/account/');
    return;
  }

  var emailEl  = document.getElementById('email');
  var passEl   = document.getElementById('password');
  var submitEl = document.getElementById('submitBtn');
  var errEl    = document.getElementById('errMsg');

  function showError(msg) {
    errEl.textContent = msg;
    errEl.classList.add('visible');
  }

  async function submit() {
    errEl.classList.remove('visible');
    var email    = emailEl.value.trim();
    var password = passEl.value;
    if (!email || !password) { showError('заполните все поля'); return; }

    submitEl.disabled = true;
    submitEl.textContent = 'входим…';

    try {
      var res  = await fetch(API + '/auth/login', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ email, password }),
      });
      var data = await res.json();

      if (!res.ok) { showError(data.error ?? 'что-то пошло не так'); return; }

      localStorage.setItem('wh_access',  data.accessToken);
      localStorage.setItem('wh_refresh', data.refreshToken);
      localStorage.setItem('wh_user',    JSON.stringify(data.user));
      location.replace('/ru/account/');
    } catch (e) {
      showError('сервер недоступен — попробуй позже');
    } finally {
      submitEl.disabled = false;
      submitEl.textContent = 'войти';
    }
  }

  submitEl.addEventListener('click', submit);
  [emailEl, passEl].forEach(function (el) {
    el.addEventListener('keydown', function (e) { if (e.key === 'Enter') submit(); });
  });
})();
</script>
