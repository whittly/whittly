---
import Base from '../../layouts/Base.astro';
import { CATALOG, CAT_META, CAT_ORDER, toolSlug } from '../../data/catalog';
import '../../styles/tools-index.css';
import pkg from '../../../package.json';

const catalogWithSlugs = CATALOG.map((t) => ({ ...t, slug: toolSlug(t) }));
const totalTools = CATALOG.filter((t) => !t.soon).length;
const version = pkg.version;
---

<Base
  title="tools — whittly"
  description="Browse all developer tools — formatters, encoders, generators, parsers. Every tool runs locally in your browser. No signup required."
>
  <header class="tools-header">
    <div>
      <div class="badge">
        <span class="badge-dot"></span><span>{`${totalTools} tools · v${version}`}</span>
      </div>
      <h1>every <em>tool</em>, one keystroke away.</h1>
    </div>
    <p class="subhead">
      browse the full catalog. all tools run locally — pick one and start. press <span class="kbd"
        >/</span
      > from anywhere to jump.
    </p>
  </header>

  <div class="filter-bar">
    <div class="search filter-search">
      <i class="ti ti-search"></i>
      <input type="text" id="toolSearch" placeholder="filter — try 'json', 'jwt', 'base64'..." />
      <span class="kbd">/</span>
    </div>
    <div class="filter-chips" id="filterChips">
      <div class="filter-chip active" data-cat="all">
        all<span class="count">{totalTools}</span>
      </div>
      {
        CAT_ORDER.filter((cat) => CATALOG.some((t) => t.cat === cat)).map((cat) => {
          const count = CATALOG.filter((t) => t.cat === cat && !t.soon).length;
          return (
            <div class="filter-chip" data-cat={cat}>
              {CAT_META[cat].label}
              <span class="count">{count}</span>
            </div>
          );
        })
      }
    </div>
  </div>

  <div id="pinnedSection" style="display:none">
    <section class="cat-section" id="pinnedCat">
      <div class="cat-head">
        <span class="cat-name">pinned</span>
        <span class="cat-count" id="pinnedCount"></span>
      </div>
      <div class="tool-list" id="pinnedList"></div>
    </section>
  </div>

  <div id="catalog"></div>

  <div class="empty" id="empty" style="display:none;">
    <div class="em">∅</div>
    <div>no tools match — try a different keyword</div>
  </div>
</Base>

<script
  is:inline
  define:vars={{ catalog: catalogWithSlugs, catMeta: CAT_META, catOrder: CAT_ORDER }}
>
  const PINNED_KEY = 'wh_pinned';
  function getPinned() {
    try { return JSON.parse(localStorage.getItem(PINNED_KEY) || '[]'); } catch { return []; }
  }
  function setPinned(arr) { localStorage.setItem(PINNED_KEY, JSON.stringify(arr)); }

  function renderPinned() {
    const section = document.getElementById('pinnedSection');
    const list = document.getElementById('pinnedList');
    const countEl = document.getElementById('pinnedCount');
    if (!section || !list) return;
    const pinned = getPinned();
    const tools = catalog.filter((t) => pinned.includes(t.slug) && !t.soon);
    if (!tools.length) { section.style.display = 'none'; return; }
    section.style.display = '';
    if (countEl) countEl.textContent = tools.length + (tools.length === 1 ? ' tool' : ' tools');
    list.innerHTML = tools.map((t) => `
      <a class="tool-row" href="/tools/${t.slug}/">
        <i class="ti ${t.icon} icon"></i>
        <div class="body">
          <div class="name">${t.name}${t.new ? '<span class="new">new</span>' : ''}</div>
          <div class="desc">${t.desc}</div>
        </div>
        <button class="tool-pin pinned" data-slug="${t.slug}" type="button" title="Unpin"><i class="ti ti-star-filled"></i></button>
      </a>`).join('');
  }

  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.tool-pin');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    const slug = btn.dataset.slug;
    const pinned = getPinned();
    const idx = pinned.indexOf(slug);
    if (idx === -1) pinned.push(slug); else pinned.splice(idx, 1);
    setPinned(pinned);
    renderPinned();
    document.querySelectorAll(`.tool-pin[data-slug="${slug}"]`).forEach((b) => {
      const p = pinned.includes(slug);
      b.classList.toggle('pinned', p);
      b.innerHTML = `<i class="ti ti-star${p ? '-filled' : ''}"></i>`;
    });
  });

  const catalogEl = document.getElementById('catalog');
  const emptyEl = document.getElementById('empty');
  const searchInput = document.getElementById('toolSearch');
  let activeCat = 'all';
  let query = '';

  const urlParams = new URLSearchParams(location.search);

  const urlCat = urlParams.get('cat');
  if (urlCat) {
    activeCat = urlCat;
    document.querySelectorAll('.filter-chip').forEach((c) => {
      c.classList.toggle('active', c.dataset.cat === urlCat);
    });
  }

  const urlQ = urlParams.get('q');
  if (urlQ) {
    query = urlQ;
    searchInput.value = urlQ;
  }

  function render() {
    const filtered = catalog.filter((t) => {
      const matchesCat = activeCat === 'all' || t.cat === activeCat;
      const q = query.toLowerCase().trim();
      const matchesQ =
        !q ||
        t.name.toLowerCase().includes(q) ||
        t.desc.toLowerCase().includes(q) ||
        t.cat.toLowerCase().includes(q);
      return matchesCat && matchesQ;
    });

    if (filtered.length === 0) {
      catalogEl.innerHTML = '';
      emptyEl.style.display = 'block';
      return;
    }
    emptyEl.style.display = 'none';

    const groups = {};
    filtered.forEach((t) => {
      (groups[t.cat] = groups[t.cat] || []).push(t);
    });

    catalogEl.innerHTML = catOrder
      .filter((c) => groups[c])
      .map((c) => {
        const tools = groups[c];
        const meta = catMeta[c];
        const rows = tools
          .map((t) =>
            t.soon
              ? `
        <div class="tool-row soon">
          <i class="ti ${t.icon} icon"></i>
          <div class="body">
            <div class="name">${t.name}<span class="soon-badge">soon</span></div>
            <div class="desc">${t.desc}</div>
          </div>
        </div>
      `
              : `
        <a class="tool-row" href="/tools/${t.slug}/">
          <i class="ti ${t.icon} icon"></i>
          <div class="body">
            <div class="name">${t.name}${t.new ? '<span class="new">new</span>' : ''}</div>
            <div class="desc">${t.desc}</div>
          </div>
          <button class="tool-pin${getPinned().includes(t.slug) ? ' pinned' : ''}" data-slug="${t.slug}" type="button" title="Pin"><i class="ti ti-star${getPinned().includes(t.slug) ? '-filled' : ''}"></i></button>
        </a>
      `
          )
          .join('');

        return `
        <section class="cat-section">
          <div class="cat-head">
            <span class="cat-name">${meta.label}</span>
            <span class="cat-count">${tools.length} ${tools.length === 1 ? 'tool' : 'tools'}</span>
            <span class="cat-desc">${meta.desc}</span>
          </div>
          <div class="tool-list">${rows}</div>
        </section>
      `;
      })
      .join('');
  }

  document.getElementById('filterChips').addEventListener('click', (e) => {
    const chip = e.target.closest('.filter-chip');
    if (!chip) return;
    document.querySelectorAll('.filter-chip').forEach((c) => c.classList.remove('active'));
    chip.classList.add('active');
    activeCat = chip.dataset.cat;
    render();
  });

  searchInput.addEventListener('input', (e) => {
    query = e.target.value;
    render();
  });
  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const first = catalogEl.querySelector('.tool-row');
      if (first) window.location.href = first.href;
    }
  });

  document.addEventListener('keydown', (e) => {
    if (
      e.key === '/' &&
      document.activeElement.tagName !== 'INPUT' &&
      document.activeElement.tagName !== 'TEXTAREA'
    ) {
      e.preventDefault();
      searchInput.focus();
    }
  });

  render();
  renderPinned();
</script>
