---
import '../styles/global.css';
import { CATALOG, toolSlug } from '../data/catalog';
import { toolNameRu, toolDescRu, catLabelRu } from '../data/ru';
import pkg from '../../package.json';
import CommandPalette from '../components/CommandPalette.astro';
import HistorySidebar from '../components/HistorySidebar.astro';
const version = pkg.version;
const buildDate = import.meta.env.VITE_BUILD_DATE ?? null;

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3001';

const isRu = import.meta.env.PUBLIC_SITE_DOMAIN === 'ru.whittly.dev';
const SITE = isRu ? 'https://ru.whittly.dev' : 'https://whittly.dev';
const ANALYTICS_SITE = 'https://analytics.whittly.dev';
const UMAMI_WEBSITE_ID = isRu
  ? (import.meta.env.PUBLIC_UMAMI_WEBSITE_ID_RU ?? import.meta.env.PUBLIC_UMAMI_WEBSITE_ID)
  : (import.meta.env.PUBLIC_UMAMI_WEBSITE_ID_DEV ?? import.meta.env.PUBLIC_UMAMI_WEBSITE_ID);
const pathname = Astro.url.pathname;
const canonical = SITE + pathname;
const altSite = isRu ? 'https://whittly.dev' : 'https://ru.whittly.dev';
const altUrl = isRu ? altSite + pathname + '?noredir=1' : altSite + pathname;
const altLabel = isRu ? 'EN' : 'RU';

const catalog = CATALOG.map((t) => {
  const name = isRu ? (toolNameRu[t.name] ?? t.name) : t.name;
  const desc = isRu ? (toolDescRu[t.name] ?? t.desc) : t.desc;
  const cat = isRu ? (catLabelRu[t.cat] ?? t.cat) : (t.cat as string);
  const search = [name, t.name, desc, t.desc, cat, t.cat].join(' ').toLowerCase();
  return {
    name,
    slug: toolSlug(t),
    desc,
    cat,
    icon: t.icon,
    search,
  };
});
---

<style is:global>
  .nav-pro {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
    background: linear-gradient(135deg, #c44520 0%, #d4a030 100%);
    color: white !important;
    text-decoration: none !important;
    letter-spacing: 0.06em;
    transition: opacity 0.15s;
    white-space: nowrap;
  }
  .nav-pro:hover {
    opacity: 0.82;
  }
  .nav-pro-cs {
    opacity: 0.45;
    cursor: default;
  }
  .nav-pro-cs:hover {
    opacity: 0.45;
  }

  .nav-lang {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-faint);
    border: 0.5px solid var(--line);
    border-radius: 5px;
    padding: 3px 8px;
    text-decoration: none;
    transition: all 0.12s;
    white-space: nowrap;
  }
  .nav-lang:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .nav-account {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-faint);
    border: 0.5px solid var(--line);
    border-radius: 5px;
    padding: 3px 8px;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: all 0.12s;
    white-space: nowrap;
  }
  .nav-account:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .nav-account.authed {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
</style>

<html lang={isRu ? 'ru' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline define:vars={{ isRu }}>
      if (!isRu)
        (function () {
          try {
            if (sessionStorage.getItem('wh_skip_redir')) return;
            var params = new URLSearchParams(location.search);
            if (params.has('noredir')) {
              sessionStorage.setItem('wh_skip_redir', '1');
              params.delete('noredir');
              var qs = params.toString();
              history.replaceState(null, '', location.pathname + (qs ? '?' + qs : ''));
              return;
            }
            var lang = (navigator.language || '').toLowerCase();
            if (!/^(ru|uk|be|kk|hy|az|ka|uz|tg|ky|tk)/.test(lang)) return;
            location.replace('https://ru.whittly.dev' + location.pathname + location.search);
          } catch (e) {}
        })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/whittly-logo.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:site_name" content="whittly" />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={`${SITE}/og.png`} />

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="alternate" hreflang={isRu ? 'ru' : 'en'} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css"
    />
    {
      import.meta.env.PROD && UMAMI_WEBSITE_ID && (
        <script
          is:inline
          defer
          src={`${ANALYTICS_SITE}/script.js`}
          data-website-id={UMAMI_WEBSITE_ID}
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <!-- Globals: must be defined before <slot /> and component scripts -->
    <script is:inline define:vars={{ API }}>
      (function () {
        var API_URL = API;

        function getJwtPlan() {
          var jwtPlan = null;
          try {
            var token = localStorage.getItem('wh_access');
            if (token) {
              var payload = JSON.parse(
                atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))
              );
              jwtPlan = payload.plan || 'free';
            }
          } catch (e) {}
          if (jwtPlan && jwtPlan !== 'free') return jwtPlan;
          try {
            var u = JSON.parse(localStorage.getItem('wh_user') || 'null');
            if (u && (u.plan === 'pro' || u.plan === 'api')) {
              var exp = u.planExpiresAt ? new Date(u.planExpiresAt).getTime() : Infinity;
              if (exp > Date.now()) return u.plan;
            }
          } catch (e2) {}
          return jwtPlan || 'free';
        }

        window.whRefreshAuth = function () {
          var rt = localStorage.getItem('wh_refresh');
          if (!rt) return Promise.resolve(null);
          return fetch(API_URL + '/auth/refresh', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ refreshToken: rt }),
          })
            .then(function (r) {
              return r.ok ? r.json() : null;
            })
            .then(function (data) {
              if (!data) {
                localStorage.removeItem('wh_access');
                localStorage.removeItem('wh_refresh');
                return null;
              }
              localStorage.setItem('wh_access', data.accessToken);
              localStorage.setItem('wh_refresh', data.refreshToken);
              return data.accessToken;
            })
            .catch(function () {
              return null;
            });
        };

        window.whApi = {
          getToken: function () {
            return localStorage.getItem('wh_access') || '';
          },
          getPlan: getJwtPlan,
          fetch: function (path, opts) {
            opts = opts || {};
            var doFetch = function (tok) {
              return fetch(
                API_URL + path,
                Object.assign({}, opts, {
                  headers: Object.assign({}, opts.headers || {}, {
                    Authorization: 'Bearer ' + tok,
                  }),
                })
              );
            };
            return doFetch(localStorage.getItem('wh_access') || '').then(function (r) {
              if (r.status !== 401 || !window.whRefreshAuth) return r;
              return window.whRefreshAuth().then(function (t) {
                return t ? doFetch(t) : r;
              });
            });
          },
        };
      })();
    </script>

    <div class="container">
      <nav>
        <a class="logo" href="/">
          <span class="logo-mark">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 48 48"
              width="28"
              height="28"
              fill="currentColor"
            >
              <text
                x="24"
                y="38"
                font-family="Georgia, serif"
                font-size="44"
                font-weight="400"
                text-anchor="middle">{'{}'}</text
              >
            </svg>
          </span>
          <span>whittly</span>
        </a>

        <button class="nav-search" id="navCmdK" type="button">
          <i class="ti ti-search"></i>
          <span class="nav-search-ph">{isRu ? 'поиск инструментов…' : 'search tools…'}</span>
          <kbd class="nav-search-kbd" id="kbdHint">⌘K</kbd>
        </button>

        <div class="nav-util">
          <a href={altUrl} class="nav-lang">{altLabel}</a>
          <a class="nav-account" id="navAccount" href="/account/login/">
            <i class="ti ti-user-circle"></i>
            <span id="navAccountLabel">{isRu ? 'войти' : 'sign in'}</span>
          </a>
        </div>
      </nav>

      <slot />

      <footer>
        <div class="footer-row-main">
          <span
            >{
              isRu
                ? 'сделано с заботой о разработчиках · '
                : 'made with care for fellow developers · '
            }<a class="by" href="https://popelyshko.com" target="_blank" rel="noopener"
              >popelyshko.com</a
            ></span
          >
          <nav class="footer-nav">
            <a href="/tools/" class="meta-link">{isRu ? 'инструменты' : 'tools'}</a>
            <a href="/about/" class="meta-link">{isRu ? 'о проекте' : 'about'}</a>
            <a href="/premium/" class="meta-link">pro</a>
            <a href="/privacy/" class="meta-link">{isRu ? 'конфиденциальность' : 'privacy'}</a>
            <a href="/terms/" class="meta-link">{isRu ? 'условия' : 'terms'}</a>
          </nav>
          <span class="meta"
            >v{version}{buildDate ? ` · ${buildDate}` : ''} · <a
              href="https://github.com/whittly"
              target="_blank"
              rel="noopener"
              class="meta-link">github ↗</a
            ></span
          >
        </div>
        <div class="footer-row-legal">
          <div class="footer-legal-links">
            <span class="footer-legal-name">Попелышко Дмитрий Иванович · ИНН 402906501480</span>
            <a href="/oferta/" class="meta-link">публичная оферта</a>
            <a href={isRu ? '/privacy/' : '/privacy-ru/'} class="meta-link"
              >политика конфиденциальности</a
            >
          </div>
          <a href="mailto:support@whittly.dev" class="meta-link">support</a>
        </div>
      </footer>
    </div>

    <CommandPalette isRu={isRu} catalog={catalog} />
    <HistorySidebar isRu={isRu} catalog={catalog} />

    <script is:inline>
      (function () {
        /* ─── Account nav ─── */
        var isRu = document.documentElement.lang === 'ru';
        var navAccount = document.getElementById('navAccount');
        var navAccountLabel = document.getElementById('navAccountLabel');
        if (navAccount && navAccountLabel && localStorage.getItem('wh_access')) {
          navAccount.href = '/account/';
          navAccount.classList.add('authed');
          navAccountLabel.textContent = isRu ? 'аккаунт' : 'account';
        }
      })();
    </script>
  </body>
</html>
