---
import Base from '../../layouts/Base.astro';
import '../../styles/account.css';

interface Props {
  lang: 'en' | 'ru';
}
const { lang } = Astro.props;
const isRu = lang === 'ru';
---

<Base title={isRu ? 'api ключи — whittly' : 'api keys — whittly'}>
  <div class="ac-page">
    <div class="ac-loading" id="acLoading">
      <i class="ti ti-loader-2" style="animation: spin 1s linear infinite;"></i>
      {isRu ? 'загрузка…' : 'loading…'}
    </div>

    <div id="acContent" style="display:none">
      <div class="ac-header">
        <div>
          <div class="ac-breadcrumb">
            <a href="/account/">{isRu ? 'аккаунт' : 'account'}</a>
            <span class="sep">/</span>
            <span>{isRu ? 'api ключи' : 'api keys'}</span>
          </div>
          <h1 style="font-size:24px; margin:0;">{isRu ? 'API ключи' : 'API keys'}</h1>
        </div>
        <div style="display:flex; gap:8px; align-items:center;">
          <button class="ac-btn-ghost" id="signOutBtn">
            <i class="ti ti-logout"></i>
            {isRu ? 'выйти' : 'sign out'}
          </button>
          <span class="ac-keys-cs-badge">
            <i class="ti ti-lock"></i>
            {isRu ? 'developer — скоро' : 'developer — coming soon'}
          </span>
        </div>
      </div>

      <!-- Keys list -->
      <div class="ac-keys-list" id="keysList">
        <div class="ac-keys-empty">
          {
            isRu
              ? 'api ключи доступны в тарифе developer — скоро'
              : 'api keys are available on the developer plan — coming soon'
          }
        </div>
      </div>
    </div>
  </div>
</Base>

<style is:global>
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .ac-keys-cs-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--ink-faint);
    border: 0.5px solid var(--line);
    border-radius: 5px;
    padding: 5px 10px;
    cursor: default;
  }
</style>

<script is:inline define:vars={{ isRu }}>
  (function () {
    if (!localStorage.getItem('wh_access')) {
      location.replace('/account/login/');
      return;
    }

    var loadingEl = document.getElementById('acLoading');
    var contentEl = document.getElementById('acContent');
    var keysListEl = document.getElementById('keysList');
    var signOutBtn = document.getElementById('signOutBtn');

    function logout() {
      var rt = localStorage.getItem('wh_refresh');
      if (rt)
        window.whApi
          .fetch('/auth/logout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ refreshToken: rt }),
          })
          .catch(function () {});
      localStorage.removeItem('wh_access');
      localStorage.removeItem('wh_refresh');
      localStorage.removeItem('wh_user');
      location.replace('/account/login/');
    }
    signOutBtn.addEventListener('click', logout);

    async function authFetch(path, opts) {
      var res = await window.whApi.fetch(path, opts);
      if (res.status === 401) {
        logout();
        return null;
      }
      return res;
    }

    function formatDate(iso) {
      return isRu
        ? new Date(iso).toLocaleDateString('ru', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
          })
        : new Date(iso).toLocaleDateString('en', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
          });
    }

    function renderKeys(keys) {
      keysListEl.innerHTML = '';
      if (!keys.length) {
        var empty = document.createElement('div');
        empty.className = 'ac-keys-empty';
        empty.textContent = isRu
          ? 'api ключи доступны в тарифе developer — скоро'
          : 'api keys are available on the developer plan — coming soon';
        keysListEl.appendChild(empty);
        return;
      }
      keys.forEach(function (k) {
        var row = document.createElement('div');
        row.className = 'ac-key-row' + (k.revokedAt ? ' revoked' : '');

        var prefix = document.createElement('span');
        prefix.className = 'ac-key-prefix';
        prefix.textContent = k.keyPrefix + '…';

        var info = document.createElement('div');
        info.className = 'ac-key-info';

        var nameEl = document.createElement('div');
        nameEl.className = 'ac-key-name';
        nameEl.textContent = k.name;

        var meta = document.createElement('div');
        meta.className = 'ac-key-meta';
        var createdLabel = isRu ? 'создан ' : 'created ';
        var lastUsedLabel = isRu ? ' · последнее использование: ' : ' · last used: ';
        var neverLabel = isRu ? 'никогда' : 'never';
        meta.textContent =
          createdLabel +
          formatDate(k.createdAt) +
          lastUsedLabel +
          (k.lastUsedAt ? formatDate(k.lastUsedAt) : neverLabel);

        info.appendChild(nameEl);
        info.appendChild(meta);

        var status = document.createElement('span');
        status.className = 'ac-key-status ' + (k.revokedAt ? 'revoked' : 'active');
        status.textContent = k.revokedAt
          ? isRu
            ? 'отозван'
            : 'revoked'
          : isRu
            ? 'активен'
            : 'active';

        row.appendChild(prefix);
        row.appendChild(info);
        row.appendChild(status);

        if (!k.revokedAt) {
          var revokeBtn = document.createElement('button');
          revokeBtn.className = 'ac-btn-danger';
          revokeBtn.textContent = isRu ? 'отозвать' : 'revoke';
          revokeBtn.addEventListener('click', async function () {
            var msg = isRu
              ? 'Отозвать этот ключ? Он сразу перестанет работать.'
              : 'Revoke this key? It will stop working immediately.';
            if (!confirm(msg)) return;
            var res = await authFetch('/user/keys/' + k.id, { method: 'DELETE' });
            if (res && res.ok) loadKeys();
          });
          row.appendChild(revokeBtn);
        }

        keysListEl.appendChild(row);
      });
    }

    async function loadKeys() {
      var res = await authFetch('/user/keys');
      if (!res) return;
      var data = await res.json();
      renderKeys(data.keys || []);
    }

    // Init
    (async function () {
      try {
        await loadKeys();
        loadingEl.style.display = 'none';
        contentEl.style.display = '';
      } catch (e) {
        loadingEl.innerHTML = isRu
          ? '<span style="color:var(--bad)">// ошибка загрузки</span>'
          : '<span style="color:var(--bad)">// failed to load</span>';
      }
    })();
  })();
</script>
