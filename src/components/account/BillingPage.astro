---
import Base from '../../layouts/Base.astro';
import '../../styles/account.css';

interface Props {
  lang: 'en' | 'ru';
}
const { lang } = Astro.props;
const isRu = lang === 'ru';

const accountHref = isRu ? '/ru/account/' : '/account/';
---

<Base title={isRu ? 'биллинг — whittly' : 'billing — whittly'}>
  <div class="ac-page" id="acPage">
    <div class="ac-loading" id="acLoading">
      <i class="ti ti-loader-2" style="animation:spin 1s linear infinite;"></i>
      {isRu ? 'загрузка…' : 'loading…'}
    </div>

    <div id="acContent" style="display:none">
      <!-- payment success banner -->
      <div class="ac-payment-banner" id="paymentBanner" style="display:none">
        <i class="ti ti-circle-check"></i>
        <span id="paymentBannerText"></span>
      </div>

      <div class="bill">
        <div class="breadcrumb">
          <a href={accountHref}>{isRu ? 'аккаунт' : 'account'}</a>
          <span class="sep">/</span>
          <span>{isRu ? 'биллинг' : 'billing'}</span>
        </div>

        <div class="bill-head">
          <h1>{isRu ? 'биллинг' : 'billing'}</h1>
          <a class="btn-ghost" href={accountHref}>
            <i class="ti ti-arrow-left"></i>
            {isRu ? 'назад' : 'back to account'}
          </a>
        </div>

        <!-- subscription + payment -->
        <div class="bill-grid">
          <div class="card">
            <div class="card-head">
              <span class="panel-title">{isRu ? '// подписка' : '// subscription'}</span>
            </div>
            <div id="subContent">
              <!-- rendered by JS -->
            </div>
          </div>

          <div class="card">
            <div class="card-head">
              <span class="panel-title">{isRu ? '// аккаунт' : '// account'}</span>
            </div>
            <div class="pm-row">
              <span class="pm-brand"><i class="ti ti-user"></i></span>
              <div>
                <div class="pm-num" id="acCardEmail">—</div>
                <div class="pm-exp" id="acCardSince">—</div>
              </div>
            </div>
          </div>
        </div>

        <!-- next renewal banner -->
        <div class="next-charge" id="nextChargeBanner" style="display:none">
          <i class="ti ti-receipt"></i>
          <span id="nextChargeText"></span>
          <span class="when" id="nextChargeWhen"></span>
        </div>

        <!-- change plan -->
        <div id="change-plan" style="height:1px;margin-top:-1px"></div>
        <div class="sec-head">
          <span class="panel-title" style="font-size:11px">
            {isRu ? '// сменить тариф' : '// change plan'}
          </span>
          <div class="bt-wrap" id="billingToggle">
            <button class="bt-opt" data-period="mo" type="button">
              {isRu ? 'ежемесячно' : 'monthly'}
            </button>
            <button class="bt-opt active" data-period="yr" type="button">
              {isRu ? 'ежегодно' : 'annual'}
              <span class="bt-save">{isRu ? '−30%' : 'save 30%'}</span>
            </button>
          </div>
        </div>

        <div class="plans-grid">
          <!-- free -->
          <div class="bill-plan" id="planFree">
            <div>
              <div class="bill-plan-tier">{isRu ? 'бесплатно · всегда' : 'free · always'}</div>
              <div class="bill-plan-name">{isRu ? 'базовые' : 'core tools'}</div>
              <div class="bill-plan-cap">{isRu ? 'в браузере' : 'runs in your browser'}</div>
            </div>
            <div class="bill-plan-price">
              <span class="bill-plan-amount">{isRu ? '0 ₽' : '$0'}</span>
            </div>
            <div class="bill-plan-note">&nbsp;</div>
            <ul class="bill-plan-feats">
              <li>
                <i class="ti ti-check"></i>{
                  isRu ? 'все инструменты, в браузере' : 'all tools, in your browser'
                }
              </li>
              <li>
                <i class="ti ti-check"></i>{
                  isRu ? '5 записей · 3 пресета' : '5 history entries · 3 presets'
                }
              </li>
              <li><i class="ti ti-check"></i>{isRu ? 'файлы до 5 МБ' : 'files up to 5 MB'}</li>
            </ul>
            <button class="bill-plan-btn" id="downgradeBtn" type="button">
              {isRu ? 'перейти на бесплатный' : 'downgrade to free'}
            </button>
          </div>

          <!-- pro -->
          <div class="bill-plan" id="planPro">
            <div>
              <div class="bill-plan-tier" id="proTier">{isRu ? 'популярный' : 'popular'}</div>
              <div class="bill-plan-name">pro</div>
              <div class="bill-plan-cap">
                {isRu ? 'синхронизация, для ежедневной работы' : 'synced, for daily work'}
              </div>
            </div>
            <div class="bill-plan-price">
              <span
                class="bill-plan-amount"
                data-mo={isRu ? '390 ₽' : '$6'}
                data-yr={isRu ? '2 900 ₽' : '$49'}>{isRu ? '2 900 ₽' : '$49'}</span
              >
              <span
                class="bill-plan-period"
                data-mo={isRu ? '/ мес' : '/ mo'}
                data-yr={isRu ? '/ год' : '/ yr'}>{isRu ? '/ год' : '/ yr'}</span
              >
            </div>
            <div class="bill-plan-note" id="proNote">
              {isRu ? '≈ 242 ₽ / мес, при оплате за год' : '≈ $4.08 / mo, billed annually'}
            </div>
            <ul class="bill-plan-feats">
              <li>
                <i class="ti ti-check"></i>{
                  isRu ? 'история — 500 записей, синхронно' : 'history — 500 entries, synced'
                }
              </li>
              <li>
                <i class="ti ti-check"></i>{
                  isRu ? 'пресеты без ограничений + экспорт' : 'unlimited presets + export'
                }
              </li>
              <li>
                <i class="ti ti-check"></i>{
                  isRu ? 'пакетная обработка — до 500' : 'batch — up to 500 items'
                }
              </li>
              <li><i class="ti ti-check"></i>{isRu ? 'файлы до 100 МБ' : 'files up to 100 MB'}</li>
            </ul>
            <button class="bill-plan-btn filled" id="proBtn" type="button">
              <i class="ti ti-bolt"></i>
              {isRu ? 'выбрать pro' : 'get pro'}
            </button>
          </div>

          <!-- api — coming soon -->
          <div class="bill-plan" id="planApi">
            <div>
              <div class="bill-plan-tier">{isRu ? 'скоро' : 'coming soon'}</div>
              <div class="bill-plan-name">api</div>
              <div class="bill-plan-cap">
                {isRu ? 'личные ключи · программный доступ' : 'personal keys · programmatic access'}
              </div>
            </div>
            <div class="bill-plan-price">
              <span
                class="bill-plan-amount"
                data-mo={isRu ? '1 990 ₽' : '$24'}
                data-yr={isRu ? '14 900 ₽' : '$199'}>{isRu ? '14 900 ₽' : '$199'}</span
              >
              <span
                class="bill-plan-period"
                data-mo={isRu ? '/ мес' : '/ mo'}
                data-yr={isRu ? '/ год' : '/ yr'}>{isRu ? '/ год' : '/ yr'}</span
              >
            </div>
            <div class="bill-plan-note" id="apiNote">
              {isRu ? '≈ 1 242 ₽ / мес, при оплате за год' : '≈ $16.58 / mo, billed annually'}
            </div>
            <ul class="bill-plan-feats">
              <li><i class="ti ti-check"></i>{isRu ? 'всё из pro' : 'everything in pro'}</li>
              <li><i class="ti ti-check"></i>{isRu ? 'личные API ключи' : 'personal API keys'}</li>
              <li>
                <i class="ti ti-check"></i>{
                  isRu ? '50 000 запросов / месяц' : '50,000 requests / month'
                }
              </li>
              <li>
                <i class="ti ti-check"></i>{isRu ? 'программный доступ' : 'programmatic access'}
              </li>
            </ul>
            <span class="bill-plan-btn is-soon">
              <i class="ti ti-lock"></i>
              {isRu ? 'скоро' : 'coming soon'}
            </span>
          </div>
        </div>

        <!-- billing history -->
        <div class="card-head" style="margin-bottom:14px">
          <span class="panel-title">{isRu ? '// история платежей' : '// billing history'}</span>
        </div>
        <div class="inv">
          <div class="inv-row head">
            <span>{isRu ? 'дата' : 'date'}</span>
            <span>{isRu ? 'описание' : 'description'}</span>
            <span>{isRu ? 'сумма' : 'amount'}</span>
            <span>{isRu ? 'статус' : 'status'}</span>
            <span></span>
          </div>
          <div id="invList"><!-- rendered by JS --></div>
        </div>

        <!-- danger zone -->
        <div class="danger-zone" id="dangerZone" style="display:none">
          <div class="dz-txt">
            <strong>{isRu ? 'отменить подписку.' : 'cancel subscription.'}</strong>
            {
              isRu
                ? ' вы сохраните pro до истечения срока, затем перейдёте на бесплатный тариф. история сверх 5 записей и пресеты сверх 3 станут read-only.'
                : " you'll keep pro until it expires, then drop to free. synced history over 5 entries and presets over 3 become read-only."
            }
          </div>
          <button class="card-cta" id="cancelBtn" disabled>
            <i class="ti ti-x"></i>
            {isRu ? 'отменить подписку' : 'cancel subscription'}
            <span style="font-size:9.5px;opacity:0.55;margin-left:2px">
              {isRu ? '(скоро)' : '(soon)'}
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>
</Base>

<style is:global>
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script is:inline define:vars={{ isRu, accountHref }}>
  (function () {
    if (!localStorage.getItem('wh_access')) {
      location.replace('/account/login/');
      return;
    }

    // payment success banner
    var urlParams = new URLSearchParams(location.search);
    if (urlParams.has('InvId')) {
      var banner = document.getElementById('paymentBanner');
      var bannerText = document.getElementById('paymentBannerText');
      bannerText.textContent = isRu
        ? 'оплата принята — ваша подписка активна!'
        : 'payment confirmed — your subscription is now active!';
      banner.style.display = 'flex';
      history.replaceState(null, '', location.pathname);
      setTimeout(function () {
        banner.style.opacity = '0';
        setTimeout(function () {
          banner.style.display = 'none';
        }, 400);
      }, 6000);
    }

    var loadingEl = document.getElementById('acLoading');
    var contentEl = document.getElementById('acContent');
    var isAnnual = true;

    // theme sync (nav button)
    (function () {
      var themeIcon = document.getElementById('navThemeIcon');
      function getPref() {
        return localStorage.getItem('wh_theme') || 'system';
      }
      function resolved(p) {
        return p === 'system'
          ? window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light'
          : p;
      }
      function apply(p) {
        var r = resolved(p);
        document.documentElement.setAttribute('data-theme', r);
        if (themeIcon) themeIcon.className = r === 'dark' ? 'ti ti-sun' : 'ti ti-moon';
      }
      apply(getPref());
      var navThemeBtn = document.getElementById('navThemeBtn');
      if (navThemeBtn) {
        navThemeBtn.addEventListener('click', function () {
          var n = resolved(getPref()) === 'dark' ? 'light' : 'dark';
          localStorage.setItem('wh_theme', n);
          apply(n);
        });
      }
    })();

    function formatDateShort(iso) {
      return isRu
        ? new Date(iso).toLocaleDateString('ru', { day: 'numeric', month: 'long', year: 'numeric' })
        : new Date(iso).toLocaleDateString('en', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
          });
    }

    async function authFetch(path, opts) {
      var res = await window.whApi.fetch(path, opts);
      if (res.status === 401) {
        location.replace('/account/login/');
        return null;
      }
      return res;
    }

    // billing period toggle
    var toggle = document.getElementById('billingToggle');
    toggle.addEventListener('click', function (e) {
      var btn = e.target.closest('.bt-opt');
      if (!btn) return;
      isAnnual = btn.dataset.period === 'yr';
      toggle.querySelectorAll('.bt-opt').forEach(function (b) {
        b.classList.remove('active');
      });
      btn.classList.add('active');
      updatePrices();
    });

    function updatePrices() {
      document.querySelectorAll('.bill-plan-amount[data-mo]').forEach(function (el) {
        el.textContent = isAnnual ? el.dataset.yr : el.dataset.mo;
      });
      document.querySelectorAll('.bill-plan-period[data-mo]').forEach(function (el) {
        el.textContent = isAnnual ? el.dataset.yr : el.dataset.mo;
      });
      var proNote = document.getElementById('proNote');
      var apiNote = document.getElementById('apiNote');
      if (proNote)
        proNote.textContent = isAnnual
          ? isRu
            ? '≈ 242 ₽ / мес, при оплате за год'
            : '≈ $4.08 / mo, billed annually'
          : isRu
            ? 'оплата ежемесячно'
            : 'billed monthly';
      if (apiNote)
        apiNote.textContent = isAnnual
          ? isRu
            ? '≈ 1 242 ₽ / мес, при оплате за год'
            : '≈ $16.58 / mo, billed annually'
          : isRu
            ? 'оплата ежемесячно'
            : 'billed monthly';
    }

    async function initPayment(plan) {
      var btnId = plan === 'pro' ? 'proBtn' : 'apiBtn';
      var btn = document.getElementById(btnId);
      var originalHtml = btn ? btn.innerHTML : '';
      if (btn) {
        btn.disabled = true;
        btn.innerHTML =
          '<i class="ti ti-loader-2" style="animation:spin 0.8s linear infinite"></i> ' +
          (isRu ? 'подождите…' : 'loading…');
      }
      try {
        var period = isAnnual ? 'annual' : 'monthly';
        var res = await window.whApi.fetch('/billing/robokassa/init', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ plan: plan, period: period, lang: isRu ? 'ru' : 'en' }),
        });
        var data = await res.json();
        if (!data.ok) throw new Error('init failed');
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = data.action;
        Object.keys(data.fields).forEach(function (k) {
          var input = document.createElement('input');
          input.type = 'hidden';
          input.name = k;
          input.value = data.fields[k];
          form.appendChild(input);
        });
        document.body.appendChild(form);
        form.submit();
      } catch (err) {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = originalHtml;
        }
      }
    }

    document.getElementById('proBtn').addEventListener('click', function () {
      initPayment('pro');
    });

    function renderHistory(pmts) {
      var el = document.getElementById('invList');
      if (!el) return;
      if (!pmts || pmts.length === 0) {
        el.innerHTML =
          '<div class="inv-empty"><i class="ti ti-mail"></i> ' +
          (isRu
            ? 'чеки отправляются на ваш email после каждого платежа'
            : 'receipts are sent to your email after each payment') +
          '</div>';
        return;
      }
      var planLabel = { pro: 'Pro', developer: 'Developer' };
      var periodLabel = isRu
        ? { monthly: 'ежемесячно', annual: 'ежегодно' }
        : { monthly: 'monthly', annual: 'annual' };
      el.innerHTML = pmts
        .map(function (p) {
          var date = p.paidAt
            ? new Date(p.paidAt).toLocaleDateString(isRu ? 'ru' : 'en', {
                day: 'numeric',
                month: 'short',
                year: 'numeric',
              })
            : '—';
          var desc =
            'Whittly ' +
            (planLabel[p.plan] || p.plan) +
            ' · ' +
            (periodLabel[p.period] || p.period);
          var amt = p.amount.toLocaleString(isRu ? 'ru-RU' : 'en') + ' ₽';
          return (
            '<div class="inv-row">' +
            '<span class="inv-date">' +
            date +
            '</span>' +
            '<span class="inv-desc">' +
            desc +
            '</span>' +
            '<span class="inv-amt">' +
            amt +
            '</span>' +
            '<span class="inv-status">' +
            (isRu ? 'оплачено' : 'paid') +
            '</span>' +
            '<span></span>' +
            '</div>'
          );
        })
        .join('');
    }

    async function load() {
      try {
        var [meRes, paymentsRes] = await Promise.all([
          authFetch('/user/me'),
          authFetch('/billing/payments'),
        ]);
        if (!meRes) return;
        var me = (await meRes.json()).user;
        var pmtsData = paymentsRes ? await paymentsRes.json() : null;
        renderHistory(pmtsData && pmtsData.ok ? pmtsData.payments : []);

        var now = Date.now();
        var isExpired = me.planExpiresAt && new Date(me.planExpiresAt).getTime() < now;
        var effectivePlan = isExpired ? 'free' : me.plan || 'free';

        // set billing toggle to user's actual period
        if (me.planPeriod && effectivePlan !== 'free') {
          isAnnual = me.planPeriod === 'annual';
          toggle.querySelectorAll('.bt-opt').forEach(function (b) {
            b.classList.toggle('active', b.dataset.period === (isAnnual ? 'yr' : 'mo'));
          });
          updatePrices();
        }

        // account card
        var acCardEmail = document.getElementById('acCardEmail');
        var acCardSince = document.getElementById('acCardSince');
        if (acCardEmail) acCardEmail.textContent = me.email || '—';
        if (acCardSince)
          acCardSince.textContent =
            (isRu ? 'участник с ' : 'member since ') + formatDateShort(me.createdAt);

        // subscription card
        var subContent = document.getElementById('subContent');
        if (subContent) {
          var html = '';
          if (effectivePlan === 'free') {
            html =
              '<div class="sub-badge free"><i class="ti ti-user"></i> FREE</div>' +
              '<div class="sub-line">' +
              (isRu ? 'подписка не активна' : 'no active subscription') +
              '</div>' +
              '<div class="sub-actions"><a class="card-cta primary" href="#change-plan"><i class="ti ti-bolt"></i> ' +
              (isRu ? 'выбрать тариф →' : 'choose a plan →') +
              '</a></div>';
          } else {
            var label = effectivePlan === 'api' ? 'API' : 'PRO';
            var expStr = me.planExpiresAt ? formatDateShort(me.planExpiresAt) : '—';
            var statusLine = isExpired
              ? '<span style="color:var(--bad)">⚠ ' +
                (isRu ? 'истекла ' : 'expired ') +
                expStr +
                '</span>'
              : (isRu
                  ? 'активна · <span class="muted">продление</span> '
                  : 'active · <span class="muted">auto-renews</span> ') + expStr;
            html =
              '<div class="sub-badge"><i class="ti ti-bolt"></i> ' +
              label +
              '</div>' +
              '<div class="sub-line">' +
              statusLine +
              '</div>' +
              '<div class="sub-actions"><a class="card-cta primary" href="#change-plan"><i class="ti ti-repeat"></i> ' +
              (isRu ? 'сменить тариф' : 'change plan') +
              '</a></div>';
          }
          subContent.innerHTML = html;
        }

        // next renewal banner
        if (effectivePlan !== 'free' && me.planExpiresAt && !isExpired) {
          var nb = document.getElementById('nextChargeBanner');
          var nt = document.getElementById('nextChargeText');
          var nw = document.getElementById('nextChargeWhen');
          var planStr = effectivePlan === 'api' ? 'api' : 'pro';
          if (nt)
            nt.innerHTML =
              (isRu ? 'следующее продление · ' : 'subscription renews · ') +
              '<b>' +
              planStr +
              '</b>';
          if (nw) nw.textContent = formatDateShort(me.planExpiresAt);
          if (nb) nb.style.display = 'flex';
        }

        // mark current plan card + update buttons
        var planFreeEl = document.getElementById('planFree');
        var planProEl = document.getElementById('planPro');
        var proBtn = document.getElementById('proBtn');
        var downgradeBtn = document.getElementById('downgradeBtn');

        if (effectivePlan === 'free') {
          // free = current
          if (planFreeEl) {
            planFreeEl.classList.add('current');
            var tag = document.createElement('div');
            tag.className = 'bill-plan-tag';
            tag.textContent = isRu ? 'ваш тариф' : 'current plan';
            planFreeEl.insertBefore(tag, planFreeEl.firstChild);
          }
          if (downgradeBtn) {
            downgradeBtn.className = 'bill-plan-btn is-current';
            downgradeBtn.innerHTML =
              '<i class="ti ti-check"></i> ' + (isRu ? 'ваш тариф' : 'your plan');
          }
          if (proBtn) {
            proBtn.className = 'bill-plan-btn filled';
          }
          var proTierEl = document.getElementById('proTier');
          if (proTierEl) proTierEl.textContent = isRu ? 'популярный' : 'popular';
        } else if (effectivePlan === 'pro') {
          // pro = current
          if (planProEl) {
            planProEl.classList.add('current');
            var tag2 = document.createElement('div');
            tag2.className = 'bill-plan-tag';
            tag2.textContent = isRu ? 'ваш тариф' : 'current plan';
            planProEl.insertBefore(tag2, planProEl.firstChild);
          }
          if (proBtn) {
            proBtn.className = 'bill-plan-btn is-current';
            proBtn.innerHTML = '<i class="ti ti-check"></i> ' + (isRu ? 'ваш тариф' : 'your plan');
          }
          var proTierEl2 = document.getElementById('proTier');
          if (proTierEl2) proTierEl2.textContent = isRu ? 'ваш тариф' : 'subscribed';
          // downgrade: disabled (cancel API not live yet)
          if (downgradeBtn) {
            downgradeBtn.disabled = true;
            downgradeBtn.title = isRu
              ? 'управление отменой — скоро'
              : 'cancellation management coming soon';
          }
          // show danger zone
          var dz = document.getElementById('dangerZone');
          if (dz) dz.style.display = 'flex';
        } else if (effectivePlan === 'api') {
          // api = current — future path
          if (planFreeEl && downgradeBtn) {
            downgradeBtn.disabled = true;
          }
          if (proBtn) {
            proBtn.className = 'bill-plan-btn';
          }
          var planApiEl = document.getElementById('planApi');
          if (planApiEl) {
            planApiEl.classList.add('current');
            var tag3 = document.createElement('div');
            tag3.className = 'bill-plan-tag';
            tag3.textContent = isRu ? 'ваш тариф' : 'current plan';
            planApiEl.insertBefore(tag3, planApiEl.firstChild);
          }
          var dz2 = document.getElementById('dangerZone');
          if (dz2) dz2.style.display = 'flex';
        }

        loadingEl.style.display = 'none';
        contentEl.style.display = '';
      } catch (e) {
        loadingEl.innerHTML =
          '<span style="color:var(--bad)">' +
          (isRu
            ? '// ошибка загрузки — проверьте подключение'
            : '// failed to load — check connection') +
          '</span>';
      }
    }

    load();
  })();
</script>
