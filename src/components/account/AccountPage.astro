---
import Base from '../../layouts/Base.astro';
import '../../styles/account.css';

interface Props {
  lang: 'en' | 'ru';
}
const { lang } = Astro.props;
const isRu = lang === 'ru';
---

<Base title={isRu ? 'аккаунт — whittly' : 'account — whittly'}>
  <div class="ac-page" id="acPage">
    <div class="ac-loading" id="acLoading">
      <i class="ti ti-loader-2" style="animation: spin 1s linear infinite;"></i>
      {isRu ? 'загрузка…' : 'loading…'}
    </div>

    <div id="acContent" style="display:none">
      <div class="ac-payment-banner" id="paymentBanner" style="display:none">
        <i class="ti ti-circle-check"></i>
        <span id="paymentBannerText"></span>
      </div>

      <div class="ac-verify-banner" id="verifyBanner" style="display:none">
        <div class="ac-verify-banner-left">
          <i class="ti ti-mail"></i>
          <span
            >{
              isRu
                ? 'пожалуйста, подтвердите адрес электронной почты.'
                : 'please verify your email address.'
            }</span
          >
        </div>
        <button id="resendBtn" class="ac-verify-resend">{isRu ? 'отправить →' : 'resend →'}</button>
      </div>

      <div class="ac-header">
        <div>
          <div class="ac-heading">{isRu ? '// аккаунт' : '// account'}</div>
          <h1 id="acEmail" style="font-size:24px; margin:0;"></h1>
        </div>
        <button class="ac-btn-ghost" id="signOutBtn">
          <i class="ti ti-logout"></i>
          {isRu ? 'выйти' : 'sign out'}
        </button>
      </div>

      <div class="ac-top-row">
        <!-- Plan card -->
        <div class="ac-card">
          <div class="ac-card-label">{isRu ? 'тариф' : 'plan'}</div>
          <div class="ac-plan-badge" id="planBadge">—</div>
          <div class="ac-plan-expires" id="planExpires"></div>
          <div id="upgradeWrap"></div>
        </div>

        <!-- Stats card -->
        <div class="ac-card">
          <div class="ac-card-label">{isRu ? 'обзор' : 'overview'}</div>
          <div class="ac-stat-grid">
            <div class="ac-stat-row">
              <span class="ac-stat-label">{isRu ? 'api ключи' : 'api keys'}</span>
              <span class="ac-stat-val" id="statKeys">—</span>
            </div>
            <div class="ac-stat-row">
              <span class="ac-stat-label">{isRu ? 'пресеты' : 'saved presets'}</span>
              <span class="ac-stat-val" id="statPresets">—</span>
            </div>
            <div class="ac-stat-row">
              <span class="ac-stat-label">{isRu ? 'с нами с' : 'member since'}</span>
              <span class="ac-stat-val" id="statSince">—</span>
            </div>
          </div>
        </div>
      </div>

      <div class="ac-bottom-row">
        <div class="ac-action-card ac-action-card-cs">
          <div class="ac-action-icon"><i class="ti ti-key"></i></div>
          <div class="ac-action-title">
            {isRu ? 'API ключи' : 'API keys'}
            <span class="ac-action-cs-badge">{isRu ? 'developer — скоро' : 'developer — soon'}</span
            >
          </div>
          <div class="ac-action-desc">
            {isRu ? 'доступно в тарифе developer' : 'available on the developer plan'}
          </div>
          <div class="ac-action-arrow" style="color:var(--ink-faint)">
            {isRu ? 'скоро →' : 'coming soon →'}
          </div>
        </div>

        <div class="ac-action-card" id="presetsCard">
          <div class="ac-action-icon"><i class="ti ti-bookmark"></i></div>
          <div class="ac-action-title">{isRu ? 'сохранённые пресеты' : 'saved presets'}</div>
          <div class="ac-action-desc" id="descPresets">
            {isRu ? 'конфигурации инструментов' : 'tool configurations'}
          </div>
          <div class="ac-action-arrow" id="presetsArrow"></div>
        </div>
      </div>
    </div>
  </div>
</Base>

<style is:global>
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script is:inline define:vars={{ isRu }}>
  (function () {
    if (!localStorage.getItem('wh_access')) {
      location.replace(isRu ? '/ru/account/login/' : '/account/login/');
      return;
    }

    // Show payment success banner if redirected from Robokassa
    var urlParams = new URLSearchParams(location.search);
    if (urlParams.has('InvId')) {
      var paymentBanner = document.getElementById('paymentBanner');
      var paymentBannerText = document.getElementById('paymentBannerText');
      paymentBannerText.textContent = isRu
        ? 'оплата принята — ваша подписка активна!'
        : 'payment confirmed — your subscription is now active!';
      paymentBanner.style.display = 'flex';
      // Clean URL without reloading
      history.replaceState(null, '', location.pathname);
      setTimeout(function () {
        paymentBanner.style.opacity = '0';
        setTimeout(function () {
          paymentBanner.style.display = 'none';
        }, 400);
      }, 6000);
    }

    var loadingEl = document.getElementById('acLoading');
    var contentEl = document.getElementById('acContent');
    var emailEl = document.getElementById('acEmail');
    var planEl = document.getElementById('planBadge');
    var planExpiresEl = document.getElementById('planExpires');
    var upgradeEl = document.getElementById('upgradeWrap');
    var statKeysEl = document.getElementById('statKeys');
    var statPreEl = document.getElementById('statPresets');
    var statSinceEl = document.getElementById('statSince');
    var descPreEl = document.getElementById('descPresets');
    var presetsArrowEl = document.getElementById('presetsArrow');
    var signOutBtn = document.getElementById('signOutBtn');

    function formatDate(iso) {
      return isRu
        ? new Date(iso).toLocaleDateString('ru', { month: 'long', year: 'numeric' })
        : new Date(iso).toLocaleDateString('en', { month: 'short', year: 'numeric' });
    }

    async function authFetch(path) {
      var res = await window.whApi.fetch(path);
      if (res.status === 401) {
        logout();
        return null;
      }
      return res;
    }

    function logout() {
      var rt = localStorage.getItem('wh_refresh');
      if (rt) {
        window.whApi
          .fetch('/auth/logout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ refreshToken: rt }),
          })
          .catch(function () {});
      }
      localStorage.removeItem('wh_access');
      localStorage.removeItem('wh_refresh');
      localStorage.removeItem('wh_user');
      location.replace(isRu ? '/ru/account/login/' : '/account/login/');
    }

    signOutBtn.addEventListener('click', logout);

    async function load() {
      try {
        var [meRes, keysRes, presetsRes] = await Promise.all([
          authFetch('/user/me'),
          authFetch('/user/keys'),
          authFetch('/user/presets'),
        ]);

        if (!meRes) return;
        var me = (await meRes.json()).user;

        localStorage.setItem('wh_user', JSON.stringify(me));
        emailEl.textContent = me.email;

        if (!me.emailVerifiedAt) {
          document.getElementById('verifyBanner').style.display = 'flex';
          document.getElementById('resendBtn').addEventListener('click', async function () {
            var btn = document.getElementById('resendBtn');
            btn.disabled = true;
            btn.textContent = isRu ? 'отправлено ✓' : 'sent ✓';
            try {
              await window.whApi.fetch('/auth/resend-verification', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: me.email }),
              });
            } catch {}
          });
        }

        var now = Date.now();
        var isExpired = me.planExpiresAt && new Date(me.planExpiresAt).getTime() < now;
        var effectivePlan = isExpired ? 'free' : me.plan;

        var planLabel = effectivePlan === 'api' ? 'Developer' : effectivePlan.toUpperCase();
        planEl.textContent = planLabel;
        planEl.className = 'ac-plan-badge ' + effectivePlan;

        if (me.plan !== 'free' && me.planExpiresAt) {
          var expDate = new Date(me.planExpiresAt);
          var expStr = isRu
            ? expDate.toLocaleDateString('ru', { day: 'numeric', month: 'long', year: 'numeric' })
            : expDate.toLocaleDateString('en', { day: 'numeric', month: 'short', year: 'numeric' });
          if (isExpired) {
            planExpiresEl.innerHTML =
              '<span style="color:var(--bad);font-size:11px;">' +
              (isRu ? '⚠ истекла ' : '⚠ expired ') +
              expStr +
              '</span>';
          } else {
            planExpiresEl.innerHTML =
              '<span style="color:var(--ink-faint);font-size:11px;">' +
              (isRu ? 'до ' : 'until ') +
              expStr +
              '</span>';
          }
        }

        if (effectivePlan === 'free') {
          upgradeEl.innerHTML = isRu
            ? '<a class="ac-plan-upgrade" href="/ru/premium/">перейти на pro →</a>'
            : '<a class="ac-plan-upgrade" href="/premium/">upgrade to pro →</a>';
        }

        statSinceEl.textContent = formatDate(me.createdAt);

        var keysData = keysRes ? await keysRes.json() : { keys: [] };
        var presetsData = presetsRes ? await presetsRes.json() : { presets: [] };

        var activeKeys = (keysData.keys || []).filter(function (k) {
          return !k.revokedAt;
        }).length;
        statKeysEl.textContent = isRu ? activeKeys + ' активных' : activeKeys + ' active';

        if (me.plan === 'free') {
          statPreEl.textContent = isRu ? 'нужен pro' : 'pro required';
          descPreEl.textContent = isRu ? 'обновите тариф для пресетов' : 'upgrade to save presets';
          presetsArrowEl.innerHTML = isRu
            ? '<a href="/ru/premium/" style="color:var(--accent);text-decoration:none;font-family:\'JetBrains Mono\',monospace;font-size:11.5px;">обновить →</a>'
            : '<a href="/premium/" style="color:var(--accent);text-decoration:none;font-family:\'JetBrains Mono\',monospace;font-size:11.5px;">upgrade →</a>';
        } else {
          var pCount = (presetsData.presets || []).length;
          if (isRu) {
            statPreEl.textContent = pCount + ' сохранено';
            descPreEl.textContent =
              pCount +
              ' пресет' +
              (pCount === 1 ? '' : pCount < 5 ? 'а' : 'ов') +
              ' в разных инструментах';
            presetsArrowEl.innerHTML =
              '<a href="/ru/account/presets/" style="color:var(--accent);text-decoration:none;font-family:\'JetBrains Mono\',monospace;font-size:11.5px;">смотреть →</a>';
          } else {
            statPreEl.textContent = pCount + ' saved';
            descPreEl.textContent =
              pCount + ' preset' + (pCount === 1 ? '' : 's') + ' across all tools';
            presetsArrowEl.innerHTML =
              '<a href="/account/presets/" style="color:var(--accent);text-decoration:none;font-family:\'JetBrains Mono\',monospace;font-size:11.5px;">manage →</a>';
          }
        }

        loadingEl.style.display = 'none';
        contentEl.style.display = '';
      } catch (e) {
        loadingEl.innerHTML = isRu
          ? '<span style="color:var(--bad)">// ошибка загрузки — проверьте подключение к API</span>'
          : '<span style="color:var(--bad)">// failed to load — check API connection</span>';
      }
    }

    load();
  })();
</script>
