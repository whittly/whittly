---
import Base from '../../layouts/Base.astro';
import '../../styles/account.css';
import { CATALOG, toolSlug } from '../../data/catalog';
import { toolNameRu } from '../../data/ru';

interface Props {
  lang: 'en' | 'ru';
}
const { lang } = Astro.props;
const isRu = lang === 'ru';

const catalogForPinned = Object.fromEntries(
  CATALOG.map((t) => [
    toolSlug(t),
    { name: isRu ? toolNameRu[t.name] || t.name : t.name, icon: t.icon },
  ])
);

// icon lookup by tool name (lowercase) for history timeline
const iconByName = Object.fromEntries(CATALOG.map((t) => [t.name.toLowerCase(), t.icon]));

// quick run chips — 4 popular tools
const quickTools = CATALOG.filter((t) => t.popular && !t.soon).slice(0, 4);
---

<Base title={isRu ? 'аккаунт — whittly' : 'account — whittly'}>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,ital,wght@9..144,0,400;9..144,1,400&display=swap"
    rel="stylesheet"
  />

  <div class="ac-page" id="acPage">
    <div class="ac-loading" id="acLoading">
      <i class="ti ti-loader-2" style="animation: spin 1s linear infinite;"></i>
      {isRu ? 'загрузка…' : 'loading…'}
    </div>

    <div id="acContent" style="display:none">
      <!-- payment success banner -->
      <div class="ac-payment-banner" id="paymentBanner" style="display:none">
        <i class="ti ti-circle-check"></i>
        <span id="paymentBannerText"></span>
      </div>

      <!-- email verification banner -->
      <div class="ac-verify-banner" id="verifyBanner" style="display:none">
        <div class="ac-verify-banner-left">
          <i class="ti ti-mail"></i>
          <span>
            {
              isRu
                ? 'пожалуйста, подтвердите адрес электронной почты.'
                : 'please verify your email address.'
            }
          </span>
        </div>
        <button id="resendBtn" class="ac-verify-resend">{isRu ? 'отправить →' : 'resend →'}</button>
      </div>

      <div class="dash">
        <!-- header -->
        <div class="dash-head">
          <div>
            <div class="eyebrow">{isRu ? '// аккаунт' : '// account'}</div>
            <h1>{isRu ? 'добро пожаловать, ' : 'welcome back, '}<em id="acName">—</em>.</h1>
            <div class="dash-meta">
              <span id="acEmail">—</span>
              <span class="dot"></span>
              <span class="pro" id="acPlanLabel">—</span>
              <span class="dot"></span>
              <span id="acMemberSince">—</span>
            </div>
          </div>
          <div class="dash-head-actions">
            <button class="btn-ghost" id="signOutBtn" type="button">
              <i class="ti ti-logout"></i>
              {isRu ? 'выйти' : 'sign out'}
            </button>
          </div>
        </div>

        <!-- quick run -->
        <div class="quick-row">
          <span class="quick-label">{isRu ? 'запустить' : 'quick run'}</span>
          {
            quickTools.map((t) => (
              <a class="quick-chip" href={`/tools/${toolSlug(t)}/`}>
                <i class={`ti ${t.icon}`} />
                {isRu ? toolNameRu[t.name] || t.name : t.name}
              </a>
            ))
          }
          <button class="quick-chip" id="quickPalette" type="button">
            <i class="ti ti-search"></i>
            {isRu ? 'поиск' : 'search all'}
          </button>
        </div>

        <div class="dash-main">
          <!-- primary column -->
          <div class="dash-col">
            <!-- pick up where you left off -->
            <div class="panel">
              <div class="panel-head">
                <span class="panel-title">
                  {isRu ? '// продолжить' : '// pick up where you left off'}
                </span>
                <a href="/account/history/" class="panel-link">
                  {isRu ? 'вся история →' : 'full history →'}
                </a>
              </div>
              <div class="tl" id="timeline"></div>
            </div>

            <!-- pinned -->
            <div class="panel">
              <div class="panel-head">
                <span class="panel-title">{isRu ? '// закреплённые' : '// pinned'}</span>
                <span class="panel-sub" id="acPinnedCount"></span>
                <a href="/tools/" class="panel-link">{isRu ? 'все инструменты →' : 'manage →'}</a>
              </div>
              <div class="pin-grid" id="acPinnedList"></div>
            </div>
          </div>

          <!-- rail -->
          <div class="dash-col">
            <!-- plan -->
            <div class="panel">
              <div class="panel-head">
                <span class="panel-title">{isRu ? '// тариф' : '// plan'}</span>
              </div>
              <div class="plan-badge" id="planBadge">—</div>
              <div class="plan-renew" id="planRenew"></div>
              <div class="plan-feats" id="planFeats"></div>
              <div id="planUsage"></div>
              <div id="upgradeWrap"></div>
              <a class="btn-block" href="/account/billing/" id="billingBtn">
                <i class="ti ti-credit-card"></i>
                {isRu ? 'управление подпиской' : 'manage billing'}
              </a>
            </div>

            <!-- preferences -->
            <div class="panel">
              <div class="panel-head">
                <span class="panel-title">{isRu ? '// настройки' : '// preferences'}</span>
              </div>
              <div class="pref">
                <div class="pref-row">
                  <div>
                    <div class="pref-name">{isRu ? 'тема' : 'theme'}</div>
                    <div class="pref-desc">
                      {isRu ? 'как выглядит whittly' : 'how whittly looks'}
                    </div>
                  </div>
                  <div class="seg" id="prefTheme" data-pref="theme">
                    <button data-val="light">{isRu ? 'свет' : 'light'}</button>
                    <button data-val="dark">{isRu ? 'тёмн' : 'dark'}</button>
                    <button data-val="system">{isRu ? 'сист' : 'system'}</button>
                  </div>
                </div>
                <div class="pref-row">
                  <div>
                    <div class="pref-name">{isRu ? 'отступы' : 'default indent'}</div>
                    <div class="pref-desc">
                      {isRu ? 'json, html, css' : 'json, html, css output'}
                    </div>
                  </div>
                  <div class="seg" id="prefIndent" data-pref="indent">
                    <button data-val="2">2</button>
                    <button data-val="4">4</button>
                    <button data-val="tab">tab</button>
                  </div>
                </div>
                <div class="pref-row">
                  <div>
                    <div class="pref-name">{isRu ? 'автокопирование' : 'auto-copy result'}</div>
                    <div class="pref-desc">
                      {isRu ? 'копировать при вводе' : 'copy output as you type'}
                    </div>
                  </div>
                  <div class="sw" id="prefAutocopy" data-pref="autocopy" role="switch" tabindex="0">
                  </div>
                </div>
                <div class="pref-row">
                  <div>
                    <div class="pref-name">{isRu ? 'сохранять историю' : 'save to history'}</div>
                    <div class="pref-desc">
                      {
                        isRu
                          ? 'синхронизация между устройствами'
                          : 'keep runs synced across devices'
                      }
                    </div>
                  </div>
                  <div
                    class="sw on"
                    id="prefHistory"
                    data-pref="history"
                    role="switch"
                    tabindex="0"
                  >
                  </div>
                </div>
                <div class="pref-row">
                  <div>
                    <div class="pref-name">{isRu ? 'перенос строк' : 'word wrap'}</div>
                    <div class="pref-desc">
                      {isRu ? 'переносить длинные строки в выводе' : 'wrap long lines in output'}
                    </div>
                  </div>
                  <div class="sw" id="prefWrap" data-pref="wrap" role="switch" tabindex="0"></div>
                </div>
                <div class="pref-row">
                  <div>
                    <div class="pref-name">{isRu ? 'размер вывода' : 'output font size'}</div>
                    <div class="pref-desc">
                      {isRu ? 'шрифт в области вывода' : 'monospace text in tools'}
                    </div>
                  </div>
                  <div class="seg" id="prefFontSize">
                    <button data-val="sm">{isRu ? 'мал' : 'S'}</button>
                    <button data-val="md" class="on">{isRu ? 'ср' : 'M'}</button>
                    <button data-val="lg">{isRu ? 'бол' : 'L'}</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- api keys — full width, coming soon -->
        <div class="panel" style="margin-top:16px">
          <div class="panel-head">
            <span class="panel-title">{isRu ? '// api ключи' : '// api keys'}</span>
            <span class="cs-badge">
              <i class="ti ti-lock"></i>
              {isRu ? 'скоро' : 'coming soon'}
            </span>
          </div>
          <div class="ak-relative">
            <div class="ak-content" aria-hidden="true">
              <div class="ak-top">
                <div class="ak-intro">
                  {
                    isRu
                      ? 'вызывайте любой инструмент программно с личным ключом. ключи scoped, revocable и rate-limited.'
                      : 'call any tool programmatically with a personal key. scoped, revocable, and rate-limited per key — keep it secret, keep it server-side.'
                  }
                </div>
                <button class="ak-gen" type="button" tabindex="-1">
                  <i class="ti ti-plus"></i>
                  {isRu ? 'создать ключ' : 'generate key'}
                </button>
              </div>
              <div>
                <div class="ak-usage-row">
                  <span>{isRu ? 'запросы за месяц' : 'requests this month'}</span>
                  <span>— / 50,000</span>
                </div>
                <div class="meter"><span style="width:0%"></span></div>
              </div>
              <div class="ak-list">
                <div class="ak-row">
                  <code class="ak-key">wht_live_••••••••••••••••</code>
                  <div>
                    <div class="ak-name">production</div>
                    <div class="ak-meta">{isRu ? 'пример ключа' : 'example key'}</div>
                  </div>
                  <span class="ak-status">{isRu ? 'активен' : 'active'}</span>
                  <div class="ak-actions">
                    <button class="ak-act" tabindex="-1"><i class="ti ti-eye"></i></button>
                    <button class="ak-act" tabindex="-1"><i class="ti ti-copy"></i></button>
                    <button class="ak-act" tabindex="-1">{isRu ? 'отозвать' : 'revoke'}</button>
                  </div>
                </div>
              </div>
            </div>
            <div class="ak-lock">
              <div class="ak-lock-ic"><i class="ti ti-lock"></i></div>
              <div class="ak-lock-txt">
                {isRu ? 'личные ключи доступны в тарифе ' : 'personal keys ship with the '}
                <strong>api</strong>
                {isRu ? ' — скоро' : ' plan — coming soon'}
              </div>
              <button class="ak-notify" id="akNotify" type="button">
                <i class="ti ti-bell"></i>
                {isRu ? 'уведомить, когда будет готово' : "notify me when it's ready"}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<style is:global>
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script is:inline define:vars={{ isRu, catalogForPinned, iconByName }}>
  (function () {
    if (!localStorage.getItem('wh_access')) {
      location.replace('/account/login/');
      return;
    }

    // payment success banner from Robokassa redirect
    var urlParams = new URLSearchParams(location.search);
    if (urlParams.has('InvId')) {
      var paymentBanner = document.getElementById('paymentBanner');
      var paymentBannerText = document.getElementById('paymentBannerText');
      paymentBannerText.textContent = isRu
        ? 'оплата принята — ваша подписка активна!'
        : 'payment confirmed — your subscription is now active!';
      paymentBanner.style.display = 'flex';
      history.replaceState(null, '', location.pathname);
      setTimeout(function () {
        paymentBanner.style.opacity = '0';
        setTimeout(function () {
          paymentBanner.style.display = 'none';
        }, 400);
      }, 6000);
    }

    var loadingEl = document.getElementById('acLoading');
    var contentEl = document.getElementById('acContent');
    var nameEl = document.getElementById('acName');
    var emailEl = document.getElementById('acEmail');
    var planLabelEl = document.getElementById('acPlanLabel');
    var memberSinceEl = document.getElementById('acMemberSince');
    var planEl = document.getElementById('planBadge');
    var planRenewEl = document.getElementById('planRenew');
    var planFeatsEl = document.getElementById('planFeats');
    var planUsageEl = document.getElementById('planUsage');
    var upgradeEl = document.getElementById('upgradeWrap');
    var signOutBtn = document.getElementById('signOutBtn');
    var billingBtn = document.getElementById('billingBtn');

    function formatDate(iso) {
      return isRu
        ? new Date(iso).toLocaleDateString('ru', { month: 'long', year: 'numeric' })
        : new Date(iso).toLocaleDateString('en', { month: 'short', year: 'numeric' });
    }

    function formatDateShort(iso) {
      return isRu
        ? new Date(iso).toLocaleDateString('ru', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
          })
        : new Date(iso).toLocaleDateString('en', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
          });
    }

    async function authFetch(path) {
      var res = await window.whApi.fetch(path);
      if (res.status === 401) {
        logout();
        return null;
      }
      return res;
    }

    function logout() {
      var rt = localStorage.getItem('wh_refresh');
      if (rt) {
        window.whApi
          .fetch('/auth/logout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ refreshToken: rt }),
          })
          .catch(function () {});
      }
      localStorage.removeItem('wh_access');
      localStorage.removeItem('wh_refresh');
      localStorage.removeItem('wh_user');
      location.replace('/account/login/');
    }

    signOutBtn.addEventListener('click', logout);

    // quick palette button wires into nav ⌘K
    var quickPaletteBtn = document.getElementById('quickPalette');
    if (quickPaletteBtn) {
      quickPaletteBtn.addEventListener('click', function () {
        document.dispatchEvent(
          new KeyboardEvent('keydown', { key: 'k', metaKey: true, bubbles: true })
        );
      });
    }

    // api keys notify button
    var akNotify = document.getElementById('akNotify');
    if (akNotify) {
      akNotify.addEventListener('click', function () {
        akNotify.disabled = true;
        window.whApi
          .fetch('/user/waitlist', { method: 'POST' })
          .then(function () {
            akNotify.classList.add('done');
            akNotify.innerHTML =
              '<i class="ti ti-check"></i> ' +
              (isRu ? 'уведомим по email' : "we'll email you when it ships");
          })
          .catch(function () {
            akNotify.disabled = false;
          });
      });
    }

    // ── theme (nav button + pref segment stay in sync) ──
    var Theme = (function () {
      var themeIcon = document.getElementById('navThemeIcon');
      function getPref() {
        return localStorage.getItem('wh_theme') || 'system';
      }
      function resolved(p) {
        return p === 'system'
          ? window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light'
          : p;
      }
      function apply(p) {
        var r = resolved(p);
        document.documentElement.setAttribute('data-theme', r);
        if (themeIcon) themeIcon.className = r === 'dark' ? 'ti ti-sun' : 'ti ti-moon';
        document.querySelectorAll('#prefTheme button').forEach(function (b) {
          b.classList.toggle('on', b.dataset.val === p);
        });
      }
      function set(p) {
        localStorage.setItem('wh_theme', p);
        apply(p);
      }
      apply(getPref());
      return {
        get: getPref,
        set: set,
        toggle: function () {
          set(resolved(getPref()) === 'dark' ? 'light' : 'dark');
        },
      };
    })();

    var navThemeBtn = document.getElementById('navThemeBtn');
    if (navThemeBtn) navThemeBtn.addEventListener('click', Theme.toggle);

    var prefTheme = document.getElementById('prefTheme');
    if (prefTheme) {
      prefTheme.addEventListener('click', function (e) {
        var b = e.target.closest('button');
        if (b) Theme.set(b.dataset.val);
      });
    }

    // ── indent + switches ──
    (function () {
      var indent = document.getElementById('prefIndent');
      var savedIndent = localStorage.getItem('wh_indent') || '2';
      if (indent) {
        indent.querySelectorAll('button').forEach(function (b) {
          b.classList.toggle('on', b.dataset.val === savedIndent);
        });
        indent.addEventListener('click', function (e) {
          var b = e.target.closest('button');
          if (!b) return;
          indent.querySelectorAll('button').forEach(function (x) {
            x.classList.remove('on');
          });
          b.classList.add('on');
          localStorage.setItem('wh_indent', b.dataset.val);
        });
      }

      var fontSize = document.getElementById('prefFontSize');
      var savedFontSize = localStorage.getItem('wh_font_size') || 'md';
      if (fontSize) {
        fontSize.querySelectorAll('button').forEach(function (b) {
          b.classList.toggle('on', b.dataset.val === savedFontSize);
        });
        fontSize.addEventListener('click', function (e) {
          var b = e.target.closest('button');
          if (!b) return;
          fontSize.querySelectorAll('button').forEach(function (x) {
            x.classList.remove('on');
          });
          b.classList.add('on');
          localStorage.setItem('wh_font_size', b.dataset.val);
          document.documentElement.setAttribute('data-font-size', b.dataset.val);
        });
      }

      document.querySelectorAll('.sw').forEach(function (sw) {
        var key = 'wh_' + sw.dataset.pref;
        var saved = localStorage.getItem(key);
        if (saved !== null) sw.classList.toggle('on', saved === '1');
        function flip() {
          sw.classList.toggle('on');
          var val = sw.classList.contains('on') ? '1' : '0';
          localStorage.setItem(key, val);
          if (sw.dataset.pref === 'wrap') {
            document.documentElement.setAttribute('data-wrap', val);
          }
        }
        sw.addEventListener('click', flip);
        sw.addEventListener('keydown', function (e) {
          if (e.key === ' ' || e.key === 'Enter') {
            e.preventDefault();
            flip();
          }
        });
      });
    })();

    async function load() {
      try {
        var [meRes] = await Promise.all([authFetch('/user/me')]);

        if (!meRes) return;
        var me = (await meRes.json()).user;
        localStorage.setItem('wh_user', JSON.stringify(me));

        // name from email
        var namePart = me.email ? me.email.split('@')[0] : '—';
        if (nameEl) nameEl.textContent = namePart;
        if (emailEl) emailEl.textContent = me.email;

        // email verification banner
        if (!me.emailVerifiedAt) {
          var verifyBanner = document.getElementById('verifyBanner');
          if (verifyBanner) verifyBanner.style.display = 'flex';
          var resendBtn = document.getElementById('resendBtn');
          if (resendBtn) {
            resendBtn.addEventListener('click', async function () {
              resendBtn.disabled = true;
              resendBtn.textContent = isRu ? 'отправлено ✓' : 'sent ✓';
              try {
                await window.whApi.fetch('/auth/resend-verification', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ email: me.email }),
                });
              } catch {}
            });
          }
        }

        var now = Date.now();
        var isExpired = me.planExpiresAt && new Date(me.planExpiresAt).getTime() < now;
        var effectivePlan = isExpired ? 'free' : me.plan;

        // plan badge
        var planLabel = effectivePlan === 'api' ? 'API' : effectivePlan === 'pro' ? 'PRO' : 'FREE';
        var planIcon = effectivePlan === 'free' ? 'ti-user' : 'ti-bolt';
        if (planEl) {
          planEl.innerHTML = '<i class="ti ' + planIcon + '"></i> ' + planLabel;
          planEl.className = 'plan-badge' + (effectivePlan === 'free' ? ' free' : '');
        }
        if (planLabelEl) {
          planLabelEl.textContent = effectivePlan;
          planLabelEl.style.color = effectivePlan === 'free' ? 'var(--ink-faint)' : '';
        }

        // plan renew / expiry
        if (planRenewEl) {
          if (effectivePlan !== 'free' && me.planExpiresAt) {
            var expStr = formatDateShort(me.planExpiresAt);
            if (isExpired) {
              planRenewEl.innerHTML =
                '<span style="color:var(--bad)">⚠ ' +
                (isRu ? 'истекла ' : 'expired ') +
                expStr +
                '</span>';
            } else {
              var period = me.planPeriod || 'annual';
              var price;
              if (isRu) {
                if (effectivePlan === 'api') {
                  price = period === 'monthly' ? '1 990 ₽ / мес' : '14 900 ₽ / год';
                } else {
                  price = period === 'monthly' ? '390 ₽ / мес' : '2 900 ₽ / год';
                }
              } else {
                if (effectivePlan === 'api') {
                  price = period === 'monthly' ? '$24 / mo' : '$199 / yr';
                } else {
                  price = period === 'monthly' ? '$6 / mo' : '$49 / yr';
                }
              }
              planRenewEl.textContent =
                (isRu ? 'продление ' : 'auto-renews ') + expStr + ' · ' + price;
            }
          }
        }

        // plan features list
        if (planFeatsEl) {
          var feats = [];
          if (effectivePlan === 'pro' || effectivePlan === 'api') {
            feats = isRu
              ? [
                  'batch — до 500 элементов',
                  'большие файлы — до 100 MB',
                  'история — 500 записей',
                  'пресеты — без ограничений',
                ]
              : [
                  'batch — up to 500 items',
                  'large files — up to 100 MB',
                  'synced history — 500 entries',
                  'saved presets — unlimited',
                ];
          }
          if (effectivePlan === 'api') {
            feats.push(isRu ? 'api ключи — 50 000 запросов / мес' : 'api keys — 50,000 req / mo');
          }
          planFeatsEl.innerHTML = feats
            .map(function (f) {
              return '<div class="plan-feat"><i class="ti ti-circle-check"></i>' + f + '</div>';
            })
            .join('');
        }

        // usage meter (history)
        var histCount = 0;
        try {
          histCount = JSON.parse(localStorage.getItem('wh_hist') || '[]').length;
        } catch {}
        var histMax = effectivePlan === 'pro' || effectivePlan === 'api' ? 500 : 5;
        if (planUsageEl) {
          var pct = Math.min(100, Math.round((histCount / histMax) * 100));
          planUsageEl.innerHTML =
            '<div class="plan-usage-row"><span>' +
            (isRu ? 'история' : 'synced history') +
            '</span><span>' +
            histCount +
            ' / ' +
            histMax +
            '</span></div>' +
            '<div class="meter"><span style="width:' +
            pct +
            '%"></span></div>';
        }

        // upgrade link for free plan
        if (effectivePlan === 'free') {
          var billingHref = '/account/billing/';
          if (upgradeEl) {
            upgradeEl.innerHTML = isRu
              ? '<a class="ac-plan-upgrade" href="' +
                billingHref +
                '" style="font-family:\'JetBrains Mono\',monospace;font-size:11.5px;color:var(--accent);text-decoration:none;">перейти на pro →</a>'
              : '<a class="ac-plan-upgrade" href="' +
                billingHref +
                '" style="font-family:\'JetBrains Mono\',monospace;font-size:11.5px;color:var(--accent);text-decoration:none;">upgrade to pro →</a>';
          }
          if (billingBtn) {
            billingBtn.href = billingHref;
            billingBtn.textContent = isRu ? 'посмотреть тарифы →' : 'view plans →';
          }
        }

        // member since
        if (memberSinceEl) {
          memberSinceEl.textContent =
            (isRu ? 'с нами с ' : 'member since ') + formatDate(me.createdAt);
        }

        // ── pinned tools (localStorage) ──
        var pinnedSlugs = [];
        try {
          pinnedSlugs = JSON.parse(localStorage.getItem('wh_pinned') || '[]');
        } catch {}
        var acPinnedCountEl = document.getElementById('acPinnedCount');
        var acPinnedListEl = document.getElementById('acPinnedList');
        if (acPinnedCountEl) acPinnedCountEl.textContent = pinnedSlugs.length || '';
        if (acPinnedListEl) {
          if (!pinnedSlugs.length) {
            acPinnedListEl.innerHTML =
              '<a class="pin-card pin-add" href="/tools/"><i class="ti ti-plus"></i>' +
              (isRu ? 'закрепить инструмент' : 'pin a tool') +
              '</a>';
          } else {
            var chips = pinnedSlugs
              .map(function (s) {
                var t = catalogForPinned[s] || { name: s, icon: 'ti-tool' };
                return (
                  '<a class="pin-card" href="/tools/' +
                  s +
                  '/"><i class="ti ' +
                  t.icon +
                  '"></i>' +
                  t.name +
                  '</a>'
                );
              })
              .join('');
            chips +=
              '<a class="pin-card pin-add" href="/tools/"><i class="ti ti-plus"></i>' +
              (isRu ? 'ещё' : 'add') +
              '</a>';
            acPinnedListEl.innerHTML = chips;
          }
        }

        // ── recent history timeline (localStorage) ──
        var histEntries = [];
        try {
          histEntries = JSON.parse(localStorage.getItem('wh_hist') || '[]').slice(0, 6);
        } catch {}
        var timelineEl = document.getElementById('timeline');
        if (timelineEl) {
          if (!histEntries.length) {
            timelineEl.innerHTML =
              '<div class="tl-empty">' +
              (isRu
                ? 'история пуста — используйте инструменты, чтобы она появилась'
                : 'no history yet — run a few tools to see them here') +
              '</div>';
          } else {
            function timeAgoShort(ts) {
              var diff = Date.now() - ts;
              var m = Math.floor(diff / 60000);
              if (m < 1) return isRu ? 'только что' : 'now';
              if (m < 60) return m + (isRu ? 'м' : 'm');
              var h = Math.floor(m / 60);
              if (h < 24) return h + (isRu ? 'ч' : 'h');
              return Math.floor(h / 24) + (isRu ? 'д' : 'd');
            }
            function esc(s) {
              return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            }
            timelineEl.innerHTML = histEntries
              .map(function (e) {
                var toolPath = e.path;
                if (!toolPath && e.tool) {
                  var slug = e.tool
                    .toLowerCase()
                    .replace(/[^a-z0-9]+/g, '-')
                    .replace(/^-+|-+$/g, '');
                  toolPath = '/tools/' + slug + '/';
                }
                var entryPreview = e.inputPreview || e.input || '';
                try {
                  var _ep = JSON.parse(entryPreview);
                  if (_ep && typeof _ep.t === 'string') entryPreview = _ep.t;
                } catch {}
                var hasLink = !!(toolPath && (e.hasInput || e.input || e.inputPreview));
                var icon = iconByName[e.tool ? e.tool.toLowerCase() : ''] || 'ti-tool';
                var toolName = isRu ? e.toolRu || e.tool || '—' : e.tool || '—';
                return (
                  '<a class="tl-row" href="' +
                  esc(toolPath || '#') +
                  '"' +
                  (hasLink
                    ? ' data-path="' +
                      esc(toolPath) +
                      '" data-ts="' +
                      esc(e.ts) +
                      '" data-preview="' +
                      esc(entryPreview) +
                      '"'
                    : '') +
                  '>' +
                  '<span class="tl-ic"><i class="ti ' +
                  esc(icon) +
                  '"></i></span>' +
                  '<span class="tl-tool">' +
                  esc(toolName) +
                  '</span>' +
                  '<span class="tl-sum">' +
                  esc(e.summary || entryPreview || '') +
                  '</span>' +
                  '<span class="tl-meta">' +
                  '<span class="tl-restore"><i class="ti ti-rotate-2" style="font-size:12px"></i> ' +
                  (isRu ? 'открыть' : 'restore') +
                  '</span>' +
                  '<span class="tl-ts">' +
                  timeAgoShort(e.ts) +
                  '</span>' +
                  '</span>' +
                  '</a>'
                );
              })
              .join('');

            timelineEl.addEventListener('click', function (ev) {
              var row = ev.target.closest('.tl-row');
              if (!row || !row.dataset.path) return;
              var ts = row.dataset.ts;
              if (ts) {
                sessionStorage.setItem('wh_restore_ts', ts);
                var preview = row.dataset.preview;
                if (preview) sessionStorage.setItem('wh_restore_preview', preview);
              }
              window.location.href = row.dataset.path;
            });
          }
        }

        loadingEl.style.display = 'none';
        contentEl.style.display = '';
      } catch (e) {
        loadingEl.innerHTML = isRu
          ? '<span style="color:var(--bad)">// ошибка загрузки — проверьте подключение к API</span>'
          : '<span style="color:var(--bad)">// failed to load — check API connection</span>';
      }
    }

    load();
  })();
</script>
