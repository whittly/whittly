---
import PresetsBar from '../PresetsBar.astro';
interface Props {
  lang?: 'en' | 'ru';
}
const { lang = 'en' } = Astro.props;
const isRu = lang === 'ru';
const tLib = {
  libToggle: isRu ? 'библиотека' : 'library',
  libHead: isRu ? '// библиотека паттернов' : '// pattern library',
  libSave: isRu ? 'сохранить текущий' : 'save current',
  libEmpty: isRu ? 'нет сохранённых паттернов' : 'no saved patterns',
  libLoad: isRu ? 'загрузить' : 'load',
  libDelete: isRu ? 'удалить' : 'delete',
  libNamePh: isRu ? 'имя паттерна…' : 'pattern name…',
  libDescPh: isRu ? 'описание (опционально)…' : 'description (optional)…',
  libSaving: isRu ? 'сохраняю…' : 'saving…',
  libSaved: isRu ? 'сохранено' : 'saved',
  libProOnly: isRu ? 'библиотека паттернов — только для Pro' : 'pattern library — Pro only',
  libUpgrade: isRu ? 'улучшить →' : 'upgrade →',
  libLoading: isRu ? 'загрузка…' : 'loading…',
  libError: isRu ? 'ошибка загрузки' : 'load error',
};
const t = {
  statusEmpty: isRu ? '— введите паттерн' : '— enter a pattern',
  noMatches: isRu ? 'нет совпадений' : 'no matches',
  enterPatternAbove: isRu ? '— введите паттерн выше' : '— enter a pattern above',
  matchSuffix: isRu ? ' совп.' : ' match',
  matchesSuffix: isRu ? ' совп.' : ' matches',
  groups: isRu ? '· группы:' : '· groups:',
  refTitle: isRu ? '// справка' : '// reference',
  matchesHead: isRu ? '// совпадения' : '// matches',
  // reference group names
  gChars: isRu ? 'символы' : 'characters',
  gAnchors: isRu ? 'якоря' : 'anchors',
  gQuant: isRu ? 'кванторы' : 'quantifiers',
  gGroups: isRu ? 'группы & наборы' : 'groups &amp; sets',
  // character descriptions
  dDigit: isRu ? 'цифра 0–9' : 'digit 0–9',
  dNonDigit: isRu ? 'не цифра' : 'non-digit',
  dWord: isRu ? 'символ слова' : 'word char',
  dNonWord: isRu ? 'не символ слова' : 'non-word',
  dSpace: isRu ? 'пробельный' : 'whitespace',
  dNonSpace: isRu ? 'не пробельный' : 'non-whitespace',
  dAny: isRu ? 'любой (кроме \\n)' : 'any (not \\n)',
  dNewline: isRu ? 'новая строка' : 'newline',
  dTab: isRu ? 'табуляция' : 'tab',
  dLineStart: isRu ? 'начало строки' : 'line start',
  dLineEnd: isRu ? 'конец строки' : 'line end',
  dBound: isRu ? 'граница слова' : 'word boundary',
  dNonBound: isRu ? 'не граница' : 'non-boundary',
  d0Plus: isRu ? '0+ жадный' : '0+ greedy',
  d1Plus: isRu ? '1+ жадный' : '1+ greedy',
  d0Or1: isRu ? '0 или 1' : '0 or 1',
  dExactN: isRu ? 'ровно n' : 'exactly n',
  dNtoM: isRu ? 'от n до m' : 'n to m',
  d0Lazy: isRu ? '0+ ленивый' : '0+ lazy',
  d1Lazy: isRu ? '1+ ленивый' : '1+ lazy',
  dCapture: isRu ? 'группа захвата' : 'capture',
  dNonCap: isRu ? 'без захвата' : 'non-capture',
  dLook: isRu ? 'опережение' : 'lookahead',
  dNegLook: isRu ? 'neg. опережение' : 'neg lookahead',
  dSet: isRu ? 'набор символов' : 'char set',
  dNegSet: isRu ? 'отрицание набора' : 'negated set',
  dOr: isRu ? 'или' : 'or',
};
---

<style is:global>
  .rx {
    background: var(--surface);
    border: 0.5px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .rx-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 0.5px solid var(--line);
    background: var(--surface-sunken);
    flex-wrap: wrap;
  }

  .rx-pattern-wrap {
    flex: 1;
    min-width: 220px;
    display: flex;
    align-items: center;
    background: var(--bg);
    border: 0.5px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    transition: border-color 0.15s;
  }

  .rx-pattern-wrap:focus-within {
    border-color: var(--accent);
  }
  .rx-pattern-wrap.rx-err {
    border-color: var(--bad);
  }

  .rx-slash {
    font-family: 'JetBrains Mono', monospace;
    font-size: 16px;
    color: var(--ink-faint);
    padding: 0 6px 0 10px;
    user-select: none;
    line-height: 1;
  }

  .rx-input {
    flex: 1;
    font-family: 'JetBrains Mono', monospace;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
    background: transparent;
    border: none;
    outline: none;
    padding: 8px 4px;
    min-width: 0;
  }

  .rx-flags-inline {
    font-family: 'JetBrains Mono', monospace;
    font-size: 14.5px;
    color: var(--ink-faint);
    padding: 0 10px 0 4px;
    user-select: none;
    min-width: 28px;
    letter-spacing: 0.03em;
  }

  .rx-flag-btns {
    display: flex;
    gap: 3px;
  }

  .rx-flag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    padding: 5px 8px;
    border: 0.5px solid var(--line);
    border-radius: 5px;
    background: var(--bg);
    color: var(--ink-faint);
    cursor: pointer;
    transition: all 0.12s;
    font-style: italic;
  }

  .rx-flag:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .rx-flag.active {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }

  .rx-status {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--ink-faint);
    white-space: nowrap;
    padding: 0 4px;
  }

  .rx-status.ok {
    color: var(--good);
  }
  .rx-status.none {
    color: var(--ink-faint);
  }
  .rx-status.err {
    color: var(--bad);
  }

  .rx-panels {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    min-height: 220px;
    max-height: 340px;
  }

  .rx-in {
    padding: 14px 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--ink);
    background: transparent;
    border: none;
    outline: none;
    resize: none;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    overflow: auto;
  }

  .rx-sep {
    background: var(--line);
  }

  .rx-out {
    padding: 14px 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14.5px;
    line-height: 1.65;
    overflow: auto;
    margin: 0;
    background: var(--surface-sunken);
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--ink-soft);
  }

  .rx-out .rx-hl {
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 2px;
    outline: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .rx-out .rx-hl0 {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .rx-out .rx-hl1 {
    background: color-mix(in srgb, var(--good) 18%, transparent);
    color: var(--good);
    outline-color: color-mix(in srgb, var(--good) 30%, transparent);
  }
  .rx-out .rx-hl2 {
    background: color-mix(in srgb, oklch(65% 0.18 60) 18%, transparent);
    color: oklch(55% 0.18 60);
    outline-color: color-mix(in srgb, oklch(65% 0.18 60) 30%, transparent);
  }
  .rx-out .rx-hl3 {
    background: color-mix(in srgb, oklch(65% 0.16 300) 18%, transparent);
    color: oklch(55% 0.16 300);
    outline-color: color-mix(in srgb, oklch(65% 0.16 300) 30%, transparent);
  }

  .rx-out-ph {
    color: var(--ink-faint);
  }

  .rx-matches {
    border-top: 0.5px solid var(--line);
  }

  .rx-matches-head {
    padding: 9px 16px 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.05em;
  }

  .rx-match-list {
    max-height: 200px;
    overflow-y: auto;
    padding: 0 0 10px;
  }

  .rx-match-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 6px 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13.5px;
    border-bottom: 0.5px solid var(--line);
    transition: background 0.1s;
  }

  .rx-match-row:last-child {
    border-bottom: none;
  }
  .rx-match-row:hover {
    background: var(--surface-sunken);
  }

  .rx-match-n {
    color: var(--accent);
    font-size: 10px;
    font-weight: 700;
    width: 22px;
    flex-shrink: 0;
  }
  .rx-match-val {
    color: var(--ink);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rx-match-pos {
    color: var(--ink-faint);
    font-size: 11px;
    flex-shrink: 0;
  }
  .rx-match-grps {
    color: var(--ink-soft);
    font-size: 11px;
    flex-shrink: 0;
  }

  .rx-empty {
    padding: 12px 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13.5px;
    color: var(--ink-faint);
  }

  .rx-ref {
    border-top: 0.5px solid var(--line);
    background: var(--surface-sunken);
  }

  .rx-ref-hd {
    padding: 10px 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.05em;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
    transition: color 0.12s;
  }
  .rx-ref-hd:hover {
    color: var(--ink-soft);
  }

  .rx-ref-body {
    padding: 0 16px 14px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0 20px;
  }

  .rx-ref-gname {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    color: var(--ink-faint);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-bottom: 7px;
    margin-bottom: 4px;
    border-bottom: 0.5px solid var(--line);
  }

  .rx-ref-items {
    display: flex;
    flex-direction: column;
  }

  .rx-ref-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 3px 0;
    border-bottom: 0.5px solid color-mix(in srgb, var(--line) 60%, transparent);
  }
  .rx-ref-item:last-child {
    border-bottom: none;
  }

  .rx-ref-tok {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    background: var(--surface);
    border: 0.5px solid var(--line);
    border-radius: 3px;
    padding: 2px 0;
    color: var(--accent);
    cursor: pointer;
    transition: all 0.1s;
    white-space: nowrap;
    flex-shrink: 0;
    width: 50px;
    text-align: center;
  }
  .rx-ref-tok:hover {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }

  .rx-ref-desc {
    font-size: 11px;
    color: var(--ink-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 760px) {
    .rx-ref-body {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .rx-panels {
      grid-template-columns: 1fr;
      grid-template-rows: 180px 1px 180px;
    }
    .rx-sep {
      width: 100%;
      height: 1px;
    }
    .rx-ref-body {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Regex Library ── */
  .rx-lib-toggle {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    padding: 5px 10px;
    border: 0.5px solid var(--line);
    border-radius: 5px;
    background: var(--bg);
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.12s;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .rx-lib-toggle:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .rx-lib-toggle.active {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .rx-lib {
    border-top: 0.5px solid var(--line);
    background: var(--surface-sunken);
  }

  .rx-lib-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.05em;
  }

  .rx-lib-save-row {
    display: flex;
    gap: 8px;
    padding: 0 16px 12px;
    flex-wrap: wrap;
  }

  .rx-lib-name-input {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    padding: 5px 10px;
    background: var(--bg);
    border: 0.5px solid var(--line);
    border-radius: 5px;
    color: var(--ink);
    outline: none;
    flex: 1;
    min-width: 140px;
    transition: border-color 0.15s;
  }
  .rx-lib-name-input:focus {
    border-color: var(--accent);
  }

  .rx-lib-save-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    padding: 5px 12px;
    border: 0.5px solid var(--accent);
    border-radius: 5px;
    background: var(--accent-soft);
    color: var(--accent);
    cursor: pointer;
    transition: all 0.12s;
    white-space: nowrap;
  }
  .rx-lib-save-btn:hover {
    background: var(--accent);
    color: white;
  }
  .rx-lib-save-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .rx-lib-list {
    padding: 0 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 240px;
    overflow-y: auto;
  }

  .rx-lib-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: var(--surface);
    border: 0.5px solid var(--line);
    border-radius: 6px;
    transition: border-color 0.12s;
  }
  .rx-lib-item:hover {
    border-color: var(--line-strong);
  }

  .rx-lib-item-info {
    flex: 1;
    min-width: 0;
  }

  .rx-lib-item-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    color: var(--ink);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rx-lib-item-pat {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--accent);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rx-lib-item-load {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 3px 8px;
    border: 0.5px solid var(--line);
    border-radius: 4px;
    background: var(--bg);
    color: var(--ink-faint);
    cursor: pointer;
    transition: all 0.12s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .rx-lib-item-load:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .rx-lib-item-del {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 3px 7px;
    border: 0.5px solid var(--line);
    border-radius: 4px;
    background: var(--bg);
    color: var(--ink-faint);
    cursor: pointer;
    transition: all 0.12s;
    flex-shrink: 0;
  }
  .rx-lib-item-del:hover {
    color: var(--bad);
    border-color: var(--bad);
  }

  .rx-lib-empty {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--ink-faint);
    padding: 8px 0;
  }

  .rx-lib-lock {
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--ink-faint);
  }
  .rx-lib-lock a {
    color: var(--accent);
    text-decoration: none;
  }
  .rx-lib-lock a:hover {
    text-decoration: underline;
  }
</style>

<PresetsBar toolName="regex-tester" lang={lang} />
<div class="rx">
  <div class="rx-bar">
    <div class="rx-pattern-wrap" id="rxWrap">
      <span class="rx-slash">/</span>
      <input
        class="rx-input"
        id="rxInput"
        spellcheck="false"
        autocomplete="off"
        autocorrect="off"
        placeholder="pattern"
      />
      <span class="rx-slash rx-flags-inline" id="rxFlagsInline">/g</span>
    </div>
    <div class="rx-flag-btns" id="rxFlagBtns">
      <button class="rx-flag active" data-flag="g" title="global">g</button>
      <button class="rx-flag" data-flag="i" title="ignore case">i</button>
      <button class="rx-flag" data-flag="m" title="multiline">m</button>
      <button class="rx-flag" data-flag="s" title="dot-all">s</button>
    </div>
    <span class="rx-status" id="rxStatus">{t.statusEmpty}</span>
    <span class="local-badge">// client-only</span>
    <button class="rx-lib-toggle" id="rxLibToggleBtn" type="button"
      ><i class="ti ti-books"></i>{tLib.libToggle}</button
    >
  </div>

  <div class="rx-panels">
    <textarea
      class="rx-in"
      id="rxText"
      data-hist-main-input
      spellcheck="false"
      placeholder="test string…"
      >The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs.</textarea
    >
    <div class="rx-sep"></div>
    <pre
      class="rx-out"
      id="rxOut"><span class="rx-out-ph">// {isRu ? 'совпадения появятся здесь' : 'matches appear here'}</span></pre>
  </div>

  <div class="rx-matches">
    <div class="rx-matches-head">{t.matchesHead}</div>
    <div class="rx-match-list" id="rxMatchList">
      <div class="rx-empty">{t.enterPatternAbove}</div>
    </div>
  </div>

  <div class="rx-ref">
    <div class="rx-ref-hd" id="rxRefToggle">
      <span>{t.refTitle}</span>
      <span id="rxRefArrow">−</span>
    </div>
    <div class="rx-ref-body" id="rxRefBody">
      <div class="rx-ref-group">
        <div class="rx-ref-gname">{t.gChars}</div>
        <div class="rx-ref-items">
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="\d">\d</button><span
              class="rx-ref-desc">{t.dDigit}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="\D">\D</button><span
              class="rx-ref-desc">{t.dNonDigit}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="\w">\w</button><span
              class="rx-ref-desc">{t.dWord}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="\W">\W</button><span
              class="rx-ref-desc">{t.dNonWord}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="\s">\s</button><span
              class="rx-ref-desc">{t.dSpace}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="\S">\S</button><span
              class="rx-ref-desc">{t.dNonSpace}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert=".">.</button><span
              class="rx-ref-desc">{t.dAny}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="\n">\n</button><span
              class="rx-ref-desc">{t.dNewline}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="\t">\t</button><span
              class="rx-ref-desc">{t.dTab}</span
            >
          </div>
        </div>
      </div>

      <div class="rx-ref-group">
        <div class="rx-ref-gname">{t.gAnchors}</div>
        <div class="rx-ref-items">
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="^">^</button><span
              class="rx-ref-desc">{t.dLineStart}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="$">$</button><span
              class="rx-ref-desc">{t.dLineEnd}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="\b">\b</button><span
              class="rx-ref-desc">{t.dBound}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="\B">\B</button><span
              class="rx-ref-desc">{t.dNonBound}</span
            >
          </div>
        </div>
      </div>

      <div class="rx-ref-group">
        <div class="rx-ref-gname">{t.gQuant}</div>
        <div class="rx-ref-items">
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="*">*</button><span
              class="rx-ref-desc">{t.d0Plus}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="+">+</button><span
              class="rx-ref-desc">{t.d1Plus}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="?">?</button><span
              class="rx-ref-desc">{t.d0Or1}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert={'{n}'}>&#123;n&#125;</button><span
              class="rx-ref-desc">{t.dExactN}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert={'{n,m}'}>&#123;n,m&#125;</button
            ><span class="rx-ref-desc">{t.dNtoM}</span>
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="*?">*?</button><span
              class="rx-ref-desc">{t.d0Lazy}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="+?">+?</button><span
              class="rx-ref-desc">{t.d1Lazy}</span
            >
          </div>
        </div>
      </div>

      <div class="rx-ref-group">
        <div class="rx-ref-gname" set:html={t.gGroups} />
        <div class="rx-ref-items">
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="()">(…)</button><span
              class="rx-ref-desc">{t.dCapture}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="(?:)">(?:…)</button><span
              class="rx-ref-desc">{t.dNonCap}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="(?=)">(?=…)</button><span
              class="rx-ref-desc">{t.dLook}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="(?!)">(?!…)</button><span
              class="rx-ref-desc">{t.dNegLook}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="[]">[abc]</button><span
              class="rx-ref-desc">{t.dSet}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="[^]">[^abc]</button><span
              class="rx-ref-desc">{t.dNegSet}</span
            >
          </div>
          <div class="rx-ref-item">
            <button type="button" class="rx-ref-tok" data-insert="|">a|b</button><span
              class="rx-ref-desc">{t.dOr}</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="rx-lib" id="rxLib" style="display:none">
    <div class="rx-lib-head">
      <span>{tLib.libHead}</span>
    </div>
    <div id="rxLibInner">
      <!-- populated by JS -->
    </div>
  </div>
</div>

<script is:inline define:vars={{ t, tLib, isRu }}>
  (function () {
    var inputEl = document.getElementById('rxInput');
    var textEl = document.getElementById('rxText');
    var outEl = document.getElementById('rxOut');
    var statusEl = document.getElementById('rxStatus');
    var wrapEl = document.getElementById('rxWrap');
    var listEl = document.getElementById('rxMatchList');
    var flagsEl = document.getElementById('rxFlagsInline');

    var activeFlags = { g: true, i: false, m: false, s: false };

    function esc(s) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function truncate(s, max) {
      return s.length > max ? s.slice(0, max) + '…' : s;
    }

    function getFlags() {
      return Object.keys(activeFlags)
        .filter(function (f) {
          return activeFlags[f];
        })
        .join('');
    }

    function buildOutput(text, matches) {
      if (!matches.length) return '<span class="rx-out-ph">' + esc(text) + '</span>';
      var parts = [];
      var last = 0;
      for (var i = 0; i < matches.length; i++) {
        var m = matches[i];
        var idx = m.index;
        if (idx < last) continue;
        parts.push(esc(text.slice(last, idx)));
        parts.push('<mark class="rx-hl rx-hl' + (i % 4) + '">' + esc(m[0]) + '</mark>');
        last = idx + m[0].length;
      }
      parts.push(esc(text.slice(last)));
      return parts.join('');
    }

    function renderMatches(matches) {
      if (!matches.length) {
        listEl.innerHTML = '<div class="rx-empty">' + t.noMatches + '</div>';
        return;
      }
      listEl.innerHTML = matches
        .map(function (m, i) {
          var end = m.index + m[0].length;
          var grps = m.slice(1).filter(function (g) {
            return g !== undefined;
          });
          var grpStr = grps.length
            ? ' ' +
              t.groups +
              ' ' +
              grps
                .map(function (g, gi) {
                  return (
                    '<span style="color:var(--ink-soft)">[' +
                    (gi + 1) +
                    '] "' +
                    esc(truncate(g, 24)) +
                    '"</span>'
                  );
                })
                .join(' ')
            : '';
          return (
            '<div class="rx-match-row">' +
            '<span class="rx-match-n">' +
            (i + 1) +
            '</span>' +
            '<span class="rx-match-val">"' +
            esc(truncate(m[0], 40)) +
            '"</span>' +
            '<span class="rx-match-pos">' +
            m.index +
            '–' +
            end +
            '</span>' +
            (grpStr ? '<span class="rx-match-grps">' + grpStr + '</span>' : '') +
            '</div>'
          );
        })
        .join('');
    }

    function process() {
      var pattern = inputEl.value;
      var text = textEl.value;
      var flags = getFlags();

      flagsEl.textContent = '/' + flags;

      if (!pattern) {
        outEl.innerHTML = text
          ? esc(text)
          : '<span class="rx-out-ph">// ' +
            (document.documentElement.lang === 'ru'
              ? 'совпадения появятся здесь'
              : 'matches appear here') +
            '</span>';
        statusEl.textContent = t.statusEmpty;
        statusEl.className = 'rx-status';
        listEl.innerHTML = '<div class="rx-empty">' + t.enterPatternAbove + '</div>';
        wrapEl.classList.remove('rx-err');
        return;
      }

      try {
        var re = new RegExp(pattern, flags);
        wrapEl.classList.remove('rx-err');

        var matches = [];
        if (activeFlags.g) {
          var m;
          re.lastIndex = 0;
          while ((m = re.exec(text)) !== null) {
            matches.push(m);
            if (m[0].length === 0) re.lastIndex++;
            if (matches.length > 500) break;
          }
        } else {
          var m2 = re.exec(text);
          if (m2) matches.push(m2);
        }

        outEl.innerHTML = buildOutput(text, matches);
        renderMatches(matches);

        if (matches.length === 0) {
          statusEl.textContent = t.noMatches;
          statusEl.className = 'rx-status none';
        } else {
          statusEl.textContent =
            matches.length + (matches.length !== 1 ? t.matchesSuffix : t.matchSuffix);
          statusEl.className = 'rx-status ok';
          if (window.pushHistory)
            window.pushHistory(
              'regex tester',
              statusEl.textContent +
                ' · /' +
                pattern.slice(0, 24) +
                (pattern.length > 24 ? '…' : '') +
                '/',
              textEl.value.trim()
            );
          outEl.classList.remove('flash-ok');
          void outEl.offsetWidth;
          outEl.classList.add('flash-ok');
        }
      } catch (e) {
        wrapEl.classList.add('rx-err');
        outEl.innerHTML = text
          ? esc(text)
          : '<span class="rx-out-ph">// ' +
            (document.documentElement.lang === 'ru'
              ? 'совпадения появятся здесь'
              : 'matches appear here') +
            '</span>';
        listEl.innerHTML = '<div class="rx-empty">' + esc(e.message) + '</div>';
        statusEl.textContent = e.message;
        statusEl.className = 'rx-status err';
      }
    }

    inputEl.addEventListener('input', process);
    textEl.addEventListener('input', process);

    document.getElementById('rxFlagBtns').addEventListener('click', function (e) {
      var btn = e.target.closest('.rx-flag');
      if (!btn) return;
      var f = btn.dataset.flag;
      activeFlags[f] = !activeFlags[f];
      btn.classList.toggle('active', activeFlags[f]);
      process();
    });

    process();

    document.getElementById('rxRefToggle').addEventListener('click', function () {
      var body = document.getElementById('rxRefBody');
      var arrow = document.getElementById('rxRefArrow');
      var open = body.style.display !== 'none';
      body.style.display = open ? 'none' : 'grid';
      arrow.textContent = open ? '+' : '−';
    });

    document.addEventListener('keydown', function (e) {
      var toolEl = document.querySelector('.rx');
      if (!toolEl || !toolEl.contains(document.activeElement)) return;
      var pal = document.getElementById('whPalette');
      if (pal && pal.classList.contains('active')) return;
      var mod = e.ctrlKey || e.metaKey;
      if (mod && !e.shiftKey && e.key === 'Enter') {
        e.preventDefault();
        process();
      }
      if (e.key === 'Escape' && !mod && !e.shiftKey && !e.altKey) {
        inputEl.value = '';
        process();
        inputEl.focus();
      }
    });

    document.querySelector('.rx-ref').addEventListener('click', function (e) {
      var tok = e.target.closest('.rx-ref-tok');
      if (!tok) return;
      var ins = tok.dataset.insert;
      var s = inputEl.selectionStart;
      var en = inputEl.selectionEnd;
      inputEl.value = inputEl.value.slice(0, s) + ins + inputEl.value.slice(en);
      inputEl.selectionStart = inputEl.selectionEnd = s + ins.length;
      inputEl.focus();
      process();
    });

    window.toolGetPreset = function () {
      return { pattern: inputEl.value, flags: activeFlags, testText: textEl.value };
    };
    window.toolSetPreset = function (cfg) {
      if (cfg.pattern !== undefined) inputEl.value = cfg.pattern;
      if (cfg.testText !== undefined) textEl.value = cfg.testText;
      if (cfg.flags) {
        Object.keys(cfg.flags).forEach(function (f) {
          activeFlags[f] = cfg.flags[f];
          var btn = document.querySelector('.rx-flag[data-flag="' + f + '"]');
          if (btn) btn.classList.toggle('active', !!cfg.flags[f]);
        });
      }
      runMatch();
    };

    function runMatch() {
      process();
    }

    /* ── Regex Library (Pro) ── */
    var libToggleBtn = document.getElementById('rxLibToggleBtn');
    var libEl = document.getElementById('rxLib');
    var libInner = document.getElementById('rxLibInner');
    var libOpen = false;
    var libInitialized = false;

    function esc2(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function renderLibPatterns(patterns) {
      if (!patterns.length) {
        libInner.innerHTML =
          '<div class="rx-lib-save-row">' +
          getSaveRowHtml() +
          '</div>' +
          '<div class="rx-lib-list"><div class="rx-lib-empty">' +
          tLib.libEmpty +
          '</div></div>';
      } else {
        var items = patterns
          .map(function (p) {
            var flags = p.flags ? '/' + esc2(p.flags) : '';
            return (
              '<div class="rx-lib-item" data-id="' +
              esc2(p.id) +
              '">' +
              '<div class="rx-lib-item-info">' +
              '<div class="rx-lib-item-name">' +
              esc2(p.name) +
              '</div>' +
              '<div class="rx-lib-item-pat">/' +
              esc2(p.pattern) +
              flags +
              '</div>' +
              '</div>' +
              '<button class="rx-lib-item-load" data-pattern="' +
              esc2(p.pattern) +
              '" data-flags="' +
              esc2(p.flags || '') +
              '">' +
              tLib.libLoad +
              '</button>' +
              '<button class="rx-lib-item-del" data-id="' +
              esc2(p.id) +
              '"><i class="ti ti-trash"></i></button>' +
              '</div>'
            );
          })
          .join('');
        libInner.innerHTML =
          '<div class="rx-lib-save-row">' +
          getSaveRowHtml() +
          '</div>' +
          '<div class="rx-lib-list">' +
          items +
          '</div>';
      }
      bindLibEvents();
    }

    function getSaveRowHtml() {
      return (
        '<input class="rx-lib-name-input" id="rxLibName" type="text" placeholder="' +
        esc2(tLib.libNamePh) +
        '" spellcheck="false" autocomplete="off" />' +
        '<button class="rx-lib-save-btn" id="rxLibSaveBtn">' +
        tLib.libSave +
        '</button>'
      );
    }

    function loadLibPatterns() {
      libInner.innerHTML =
        '<div class="rx-lib-lock" style="color:var(--ink-faint)">' + tLib.libLoading + '</div>';
      window.whApi
        .fetch('/user/regex-patterns')
        .then(function (r) {
          return r.json();
        })
        .then(function (data) {
          if (data.ok) renderLibPatterns(data.patterns);
          else
            libInner.innerHTML =
              '<div class="rx-lib-lock" style="color:var(--bad)">' +
              esc2(data.error || tLib.libError) +
              '</div>';
        })
        .catch(function (e) {
          libInner.innerHTML =
            '<div class="rx-lib-lock" style="color:var(--bad)">' +
            esc2(e.message || tLib.libError) +
            '</div>';
        });
    }

    function bindLibEvents() {
      var nameInput = document.getElementById('rxLibName');
      var saveBtn = document.getElementById('rxLibSaveBtn');

      if (saveBtn && nameInput) {
        saveBtn.addEventListener('click', function () {
          var name = nameInput.value.trim();
          if (!name || !inputEl.value.trim()) return;
          saveBtn.disabled = true;
          saveBtn.textContent = tLib.libSaving;
          var flags = getFlags();
          window.whApi
            .fetch('/user/regex-patterns', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name: name,
                pattern: inputEl.value,
                flags: flags,
                description: '',
              }),
            })
            .then(function (r) {
              return r.json();
            })
            .then(function (data) {
              if (data.ok) {
                loadLibPatterns();
              } else {
                saveBtn.disabled = false;
                saveBtn.textContent = tLib.libSave;
              }
            })
            .catch(function () {
              saveBtn.disabled = false;
              saveBtn.textContent = tLib.libSave;
            });
        });
      }

      libInner.querySelectorAll('.rx-lib-item-load').forEach(function (btn) {
        btn.addEventListener('click', function () {
          inputEl.value = btn.dataset.pattern || '';
          var flags = (btn.dataset.flags || '').split('');
          Object.keys(activeFlags).forEach(function (f) {
            activeFlags[f] = flags.indexOf(f) !== -1;
            var fb = document.querySelector('.rx-flag[data-flag="' + f + '"]');
            if (fb) fb.classList.toggle('active', activeFlags[f]);
          });
          process();
          inputEl.focus();
        });
      });

      libInner.querySelectorAll('.rx-lib-item-del').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.dataset.id;
          if (!id) return;
          window.whApi
            .fetch('/user/regex-patterns/' + id, { method: 'DELETE' })
            .then(function (r) {
              return r.json();
            })
            .then(function (data) {
              if (data.ok) loadLibPatterns();
            })
            .catch(function () {});
        });
      });
    }

    libToggleBtn.addEventListener('click', function () {
      libOpen = !libOpen;
      libToggleBtn.classList.toggle('active', libOpen);
      libEl.style.display = libOpen ? '' : 'none';

      if (libOpen && !libInitialized) {
        libInitialized = true;
        var plan = window.whApi && window.whApi.getPlan();
        if (plan === 'pro' || plan === 'api') {
          loadLibPatterns();
        } else {
          // Check server-side
          window.whApi
            .fetch('/user/regex-patterns')
            .then(function (r) {
              if (r.ok || r.status === 200) {
                return r.json().then(function (d) {
                  if (d.ok) renderLibPatterns(d.patterns);
                  else throw new Error('not pro');
                });
              } else {
                throw new Error('not pro');
              }
            })
            .catch(function () {
              libInner.innerHTML =
                '<div class="rx-lib-lock"><i class="ti ti-lock"></i>' +
                tLib.libProOnly +
                ' <a href="' +
                (isRu ? '/ru/premium/' : '/premium/') +
                '">' +
                tLib.libUpgrade +
                '</a></div>';
            });
        }
      }
    });
  })();
</script>
