---
interface Props { lang?: 'en' | 'ru'; }
const { lang = 'en' } = Astro.props;
const isRu = lang === 'ru';
const t = {
  parse:      isRu ? 'разобрать'   : 'parse',
  build:      isRu ? 'собрать'     : 'build',
  copy:       isRu ? 'копировать'  : 'copy',
  copied:     isRu ? 'скопировано' : 'copied',
  clear:      isRu ? 'очистить'    : 'clear',
  pasteParse: isRu ? '— вставьте URL или query string' : '— paste a URL or query string',
  pasteBuild: isRu ? '— введите пары key=value'       : '— enter key=value pairs to build',
  phParse:    isRu ? 'https://example.com?key=value&other=hello+world' : 'https://example.com?key=value&other=hello+world',
  phBuild:    isRu ? 'key=value\nother=hello world\n(по одной паре на строку)' : 'key=value\nother=hello world\n(one pair per line)',
  outputPh:   isRu ? '// результат появится здесь' : '// output appears here',
  key:        isRu ? 'ключ'        : 'key',
  value:      isRu ? 'значение'    : 'value',
  params:     isRu ? ' параметров' : ' params',
  built:      isRu ? 'собрано'     : 'built',
};
---
<style is:global>
  .qs {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 0.5px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .qs-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 0.5px solid var(--line);
    background: var(--surface-sunken);
    flex-wrap: wrap;
  }
  .qs-modes { display: flex; gap: 4px; }
  .qs-mode {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    padding: 5px 10px;
    border: 0.5px solid var(--line);
    border-radius: 5px;
    background: var(--bg);
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.12s;
  }
  .qs-mode:hover  { color: var(--ink); border-color: var(--line-strong); }
  .qs-mode.active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .qs-status {
    flex: 1;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    color: var(--ink-faint);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .qs-status.ok  { color: var(--good); }
  .qs-status.err { color: var(--bad); }
  .qs-action {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    padding: 5px 10px;
    border: 0.5px solid var(--line);
    border-radius: 5px;
    background: var(--bg);
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.12s;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .qs-action:hover { color: var(--ink); border-color: var(--line-strong); }
  .qs-action.done  { color: var(--good); border-color: var(--good); }

  .qs-body { padding: 20px 24px; display: flex; flex-direction: column; gap: 14px; }

  .qs-input {
    width: 100%;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    padding: 10px 14px;
    border: 0.5px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--ink);
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.12s;
    resize: vertical;
    min-height: 44px;
  }
  .qs-input:focus { border-color: var(--line-strong); }

  /* parse mode: table */
  .qs-table {
    border: 0.5px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .qs-thead {
    display: grid;
    grid-template-columns: 1fr 1fr 32px;
    padding: 6px 14px;
    gap: 12px;
    background: var(--surface-sunken);
    border-bottom: 0.5px solid var(--line);
  }
  .qs-thead span {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    text-transform: lowercase;
  }
  .qs-trow {
    display: grid;
    grid-template-columns: 1fr 1fr 32px;
    align-items: center;
    padding: 8px 14px;
    gap: 12px;
    border-bottom: 0.5px solid var(--line);
    background: var(--surface-sunken);
  }
  .qs-trow:last-child { border-bottom: none; }
  .qs-trow:nth-child(even) { background: var(--surface); }
  .qs-tkey, .qs-tval {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .qs-tkey { color: var(--accent); }
  .qs-copy-btn {
    width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px;
    border: 0.5px solid var(--line); border-radius: 4px;
    background: var(--bg); color: var(--ink-faint);
    cursor: pointer; transition: all 0.12s; flex-shrink: 0;
  }
  .qs-copy-btn:hover { color: var(--ink); border-color: var(--line-strong); }
  .qs-copy-btn.done  { color: var(--good); border-color: var(--good); }

  /* build mode: output */
  .qs-out {
    width: 100%;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    padding: 12px 14px;
    border: 0.5px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
    color: var(--ink);
    box-sizing: border-box;
    word-break: break-all;
    min-height: 48px;
    cursor: default;
    white-space: pre-wrap;
  }
  .qs-out.ph { color: var(--ink-faint); }

  @media (max-width: 640px) {
    .qs-body { padding: 16px; }
    .qs-thead, .qs-trow { grid-template-columns: 1fr 1fr 28px; }
  }
</style>

<div class="qs">
  <div class="qs-bar">
    <div class="qs-modes">
      <button class="qs-mode active" data-mode="parse" id="qsModeParse">{t.parse}</button>
      <button class="qs-mode" data-mode="build" id="qsModeBuild">{t.build}</button>
    </div>
    <span class="qs-status" id="qsStatus">{t.pasteParse}</span>
    <span class="local-badge">// client-only</span>
    <button class="qs-action" id="qsCopy"><i class="ti ti-copy"></i>{t.copy}<span class="kbd-hint">⌘⇧C</span></button>
    <button class="qs-action" id="qsClear"><i class="ti ti-x"></i>{t.clear}<span class="kbd-hint">esc</span></button>
  </div>

  <!-- parse mode -->
  <div class="qs-body" id="qsParseBody">
    <input class="qs-input" id="qsParseInput" spellcheck="false" placeholder={t.phParse} />
    <div id="qsTableWrap" style="display:none">
      <div class="qs-table" id="qsTable">
        <div class="qs-thead">
          <span>{t.key}</span>
          <span>{t.value}</span>
          <span></span>
        </div>
        <div id="qsRows"></div>
      </div>
    </div>
  </div>

  <!-- build mode -->
  <div class="qs-body" id="qsBuildBody" style="display:none">
    <textarea class="qs-input" id="qsBuildInput" spellcheck="false" rows="6" placeholder={t.phBuild}></textarea>
    <div class="qs-out ph" id="qsOut">{t.outputPh}</div>
  </div>
</div>

<script is:inline define:vars={{ t }}>
(function () {
  var parseModeBtn  = document.getElementById('qsModeParse');
  var buildModeBtn  = document.getElementById('qsModeBuild');
  var parseBody     = document.getElementById('qsParseBody');
  var buildBody     = document.getElementById('qsBuildBody');
  var parseInput    = document.getElementById('qsParseInput');
  var buildInput    = document.getElementById('qsBuildInput');
  var tableWrap     = document.getElementById('qsTableWrap');
  var rowsEl        = document.getElementById('qsRows');
  var outEl         = document.getElementById('qsOut');
  var statusEl      = document.getElementById('qsStatus');
  var copyBtn       = document.getElementById('qsCopy');
  var clearBtn      = document.getElementById('qsClear');

  var mode       = 'parse';
  var lastOutput = '';

  function setMode(m) {
    mode = m;
    parseModeBtn.classList.toggle('active', m === 'parse');
    buildModeBtn.classList.toggle('active', m === 'build');
    parseBody.style.display = m === 'parse' ? '' : 'none';
    buildBody.style.display = m === 'build' ? '' : 'none';
    statusEl.textContent = m === 'parse' ? t.pasteParse : t.pasteBuild;
    statusEl.className   = 'qs-status';
    lastOutput = '';
  }

  parseModeBtn.addEventListener('click', function () { setMode('parse'); });
  buildModeBtn.addEventListener('click', function () { setMode('build'); });

  function extractQuery(str) {
    str = str.trim();
    var qi = str.indexOf('?');
    if (qi !== -1) str = str.slice(qi + 1);
    var hi = str.indexOf('#');
    if (hi !== -1) str = str.slice(0, hi);
    return str;
  }

  function copyValue(val, btn) {
    navigator.clipboard.writeText(val).then(function () {
      btn.innerHTML = '<i class="ti ti-check"></i>';
      btn.classList.add('done');
      setTimeout(function () {
        btn.innerHTML = '<i class="ti ti-copy"></i>';
        btn.classList.remove('done');
      }, 1400);
    });
  }

  function processParse() {
    var raw = parseInput.value.trim();
    if (!raw) {
      tableWrap.style.display = 'none';
      statusEl.textContent = t.pasteParse;
      statusEl.className   = 'qs-status';
      lastOutput = '';
      return;
    }
    var qs = extractQuery(raw);
    var params;
    try { params = new URLSearchParams(qs); } catch (e) { params = new URLSearchParams(); }

    var entries = Array.from(params.entries());
    if (entries.length === 0) {
      tableWrap.style.display = 'none';
      statusEl.textContent = '0' + t.params;
      statusEl.className   = 'qs-status';
      lastOutput = '';
      return;
    }

    rowsEl.innerHTML = '';
    entries.forEach(function (pair) {
      var row = document.createElement('div');
      row.className = 'qs-trow';
      var keyEl = document.createElement('span'); keyEl.className = 'qs-tkey'; keyEl.textContent = pair[0]; keyEl.title = pair[0];
      var valEl = document.createElement('span'); valEl.className = 'qs-tval'; valEl.textContent = pair[1]; valEl.title = pair[1];
      var btn   = document.createElement('button'); btn.className = 'qs-copy-btn'; btn.title = t.copy; btn.innerHTML = '<i class="ti ti-copy"></i>';
      var val   = pair[1];
      btn.addEventListener('click', function () { copyValue(val, btn); });
      row.appendChild(keyEl); row.appendChild(valEl); row.appendChild(btn);
      rowsEl.appendChild(row);
    });

    tableWrap.style.display = '';
    lastOutput = '?' + params.toString();
    statusEl.textContent = entries.length + t.params;
    statusEl.className   = 'qs-status ok';
    if (window.pushHistory) window.pushHistory('query string parser', statusEl.textContent);
    document.getElementById('qsTable').classList.remove('flash-ok');
    void document.getElementById('qsTable').offsetWidth;
    document.getElementById('qsTable').classList.add('flash-ok');
  }

  function processBuild() {
    var raw = buildInput.value;
    if (!raw.trim()) {
      outEl.textContent = t.outputPh;
      outEl.className   = 'qs-out ph';
      statusEl.textContent = t.pasteBuild;
      statusEl.className   = 'qs-status';
      lastOutput = '';
      return;
    }
    var params = new URLSearchParams();
    var count  = 0;
    raw.split('\n').forEach(function (line) {
      line = line.trim();
      if (!line) return;
      var eq = line.indexOf('=');
      if (eq === -1) {
        params.append(line, '');
      } else {
        params.append(line.slice(0, eq), line.slice(eq + 1));
      }
      count++;
    });
    var result = '?' + params.toString();
    lastOutput = result;
    outEl.textContent = result;
    outEl.className   = 'qs-out';
    statusEl.textContent = t.built + ' · ' + count + t.params;
    statusEl.className   = 'qs-status ok';
    if (window.pushHistory) window.pushHistory('query string parser', statusEl.textContent);
    outEl.classList.remove('flash-ok'); void outEl.offsetWidth; outEl.classList.add('flash-ok');
  }

  parseInput.addEventListener('input', processParse);
  buildInput.addEventListener('input', processBuild);

  copyBtn.addEventListener('click', function () {
    if (!lastOutput) return;
    navigator.clipboard.writeText(lastOutput).then(function () {
      copyBtn.innerHTML = '<i class="ti ti-check"></i>' + t.copied;
      copyBtn.classList.add('done');
      setTimeout(function () {
        copyBtn.innerHTML = '<i class="ti ti-copy"></i>' + t.copy;
        copyBtn.classList.remove('done');
      }, 1600);
    });
  });

  clearBtn.addEventListener('click', function () {
    if (mode === 'parse') {
      parseInput.value = '';
      processParse();
      parseInput.focus();
    } else {
      buildInput.value = '';
      processBuild();
      buildInput.focus();
    }
  });

  document.addEventListener('keydown', function (e) {
    var toolEl = document.querySelector('.qs');
    if (!toolEl || !toolEl.contains(document.activeElement)) return;
    var pal = document.getElementById('whPalette');
    if (pal && pal.classList.contains('active')) return;
    var mod = e.ctrlKey || e.metaKey;
    if (mod && e.shiftKey && e.key.toLowerCase() === 'c') { e.preventDefault(); copyBtn.click(); }
    if (e.key === 'Escape' && !mod && !e.shiftKey && !e.altKey) { clearBtn.click(); }
  });
})();
</script>
