---
interface Props { lang?: 'en' | 'ru'; }
const { lang = 'en' } = Astro.props;
const isRu = lang === 'ru';
const t = {
  paste:    isRu ? '— введите текст или идентификатор' : '— paste text or identifier to start',
  clear:    isRu ? 'очистить'     : 'clear',
  ph:       isRu ? 'введите текст, camelCase, snake_case, kebab-case…' : 'type or paste any text, camelCase, snake_case…',
  words:    isRu ? ' слов'        : ' words',
  copy:     isRu ? 'копировать'   : 'copy',
  copied:   isRu ? 'скопировано'  : 'copied',
};
const CASES = [
  { key: 'camel',    label: 'camelCase'          },
  { key: 'pascal',   label: 'PascalCase'         },
  { key: 'snake',    label: 'snake_case'         },
  { key: 'screaming',label: 'SCREAMING_SNAKE'    },
  { key: 'kebab',    label: 'kebab-case'         },
  { key: 'cobol',    label: 'COBOL-CASE'         },
  { key: 'dot',      label: 'dot.case'           },
  { key: 'title',    label: 'Title Case'         },
  { key: 'sentence', label: 'Sentence case'      },
  { key: 'lower',    label: 'lowercase'          },
  { key: 'upper',    label: 'UPPERCASE'          },
];
---
<style is:global>
  .cn {
    background: var(--surface);
    border: 0.5px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .cn-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 0.5px solid var(--line);
    background: var(--surface-sunken);
    flex-wrap: wrap;
  }
  .cn-status {
    flex: 1;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    color: var(--ink-faint);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cn-status.ok { color: var(--good); }
  .cn-action {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    padding: 5px 10px;
    border: 0.5px solid var(--line);
    border-radius: 5px;
    background: var(--bg);
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.12s;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .cn-action:hover { color: var(--ink); border-color: var(--line-strong); }
  .cn-body { padding: 20px 24px; display: flex; flex-direction: column; gap: 16px; }
  .cn-input {
    width: 100%;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    padding: 10px 14px;
    border: 0.5px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--ink);
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.12s;
  }
  .cn-input:focus { border-color: var(--line-strong); }
  .cn-table {
    border: 0.5px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .cn-row {
    display: grid;
    grid-template-columns: 140px 1fr 32px;
    align-items: center;
    padding: 9px 14px;
    gap: 12px;
    background: var(--surface-sunken);
    border-bottom: 0.5px solid var(--line);
  }
  .cn-row:last-child { border-bottom: none; }
  .cn-row:nth-child(even) { background: var(--surface); }
  .cn-lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .cn-val {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .cn-val.ph { color: var(--ink-faint); }
  .cn-copy-btn {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    border: 0.5px solid var(--line);
    border-radius: 4px;
    background: var(--bg);
    color: var(--ink-faint);
    cursor: pointer;
    transition: all 0.12s;
    flex-shrink: 0;
  }
  .cn-copy-btn:hover { color: var(--ink); border-color: var(--line-strong); }
  .cn-copy-btn.done  { color: var(--good); border-color: var(--good); }
  @media (max-width: 640px) {
    .cn-body { padding: 16px; }
    .cn-row  { grid-template-columns: 110px 1fr 28px; }
  }
</style>

<div class="cn">
  <div class="cn-bar">
    <span class="cn-status" id="cnStatus">{t.paste}</span>
    <span class="local-badge">// client-only</span>
    <button class="cn-action" id="cnClear"><i class="ti ti-x"></i>{t.clear}<span class="kbd-hint">esc</span></button>
  </div>
  <div class="cn-body">
    <input class="cn-input" id="cnInput" spellcheck="false" placeholder={t.ph} />
    <div class="cn-table" id="cnTable">
      {CASES.map(c => (
        <div class="cn-row" id={`cnRow-${c.key}`}>
          <span class="cn-lbl">{c.label}</span>
          <span class="cn-val ph" id={`cnVal-${c.key}`}>—</span>
          <button class="cn-copy-btn" id={`cnCopy-${c.key}`} title={t.copy}><i class="ti ti-copy"></i></button>
        </div>
      ))}
    </div>
  </div>
</div>

<script is:inline define:vars={{ t, CASES }}>
(function () {
  var inputEl  = document.getElementById('cnInput');
  var statusEl = document.getElementById('cnStatus');
  var clearBtn = document.getElementById('cnClear');

  function splitWords(str) {
    var s = str;
    s = s.replace(/([a-z\d])([A-Z])/g, '$1 $2');
    s = s.replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2');
    s = s.replace(/[\-_.\/\s]+/g, ' ');
    return s.trim().split(/\s+/).filter(Boolean);
  }

  function cap(w)  { return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase(); }
  function lo(w)   { return w.toLowerCase(); }
  function up(w)   { return w.toUpperCase(); }

  var CONVERTERS = {
    camel:     function(ws) { return ws.length ? lo(ws[0]) + ws.slice(1).map(cap).join('') : ''; },
    pascal:    function(ws) { return ws.map(cap).join(''); },
    snake:     function(ws) { return ws.map(lo).join('_'); },
    screaming: function(ws) { return ws.map(up).join('_'); },
    kebab:     function(ws) { return ws.map(lo).join('-'); },
    cobol:     function(ws) { return ws.map(up).join('-'); },
    dot:       function(ws) { return ws.map(lo).join('.'); },
    title:     function(ws) { return ws.map(cap).join(' '); },
    sentence:  function(ws) { return ws.length ? cap(ws[0]) + (ws.length > 1 ? ' ' + ws.slice(1).map(lo).join(' ') : '') : ''; },
    lower:     function(ws) { return ws.map(lo).join(' '); },
    upper:     function(ws) { return ws.map(up).join(' '); },
  };

  function copyValue(key) {
    var el  = document.getElementById('cnVal-' + key);
    var btn = document.getElementById('cnCopy-' + key);
    var val = el && el.textContent;
    if (!val || val === '—') return;
    navigator.clipboard.writeText(val).then(function () {
      btn.innerHTML = '<i class="ti ti-check"></i>';
      btn.classList.add('done');
      setTimeout(function () {
        btn.innerHTML = '<i class="ti ti-copy"></i>';
        btn.classList.remove('done');
      }, 1400);
    });
  }

  CASES.forEach(function (c) {
    var btn = document.getElementById('cnCopy-' + c.key);
    if (btn) btn.addEventListener('click', function () { copyValue(c.key); });
  });

  function reset() {
    CASES.forEach(function (c) {
      var el = document.getElementById('cnVal-' + c.key);
      if (el) { el.textContent = '—'; el.className = 'cn-val ph'; }
    });
    statusEl.textContent = t.paste;
    statusEl.className   = 'cn-status';
  }

  function process() {
    var raw = inputEl.value;
    if (!raw.trim()) { reset(); return; }

    var words = splitWords(raw);
    if (!words.length) { reset(); return; }

    CASES.forEach(function (c) {
      var el  = document.getElementById('cnVal-' + c.key);
      var val = CONVERTERS[c.key] ? CONVERTERS[c.key](words) : '—';
      if (el) { el.textContent = val; el.className = 'cn-val'; }
    });

    statusEl.textContent = words.length + t.words;
    statusEl.className   = 'cn-status ok';

    var tableEl = document.getElementById('cnTable');
    if (tableEl) { tableEl.classList.remove('flash-ok'); void tableEl.offsetWidth; tableEl.classList.add('flash-ok'); }
    if (window.pushHistory) window.pushHistory('case normalizer', words.length + t.words);
  }

  inputEl.addEventListener('input', process);

  clearBtn.addEventListener('click', function () {
    inputEl.value = '';
    reset();
    inputEl.focus();
  });

  document.addEventListener('keydown', function (e) {
    var toolEl = document.querySelector('.cn');
    if (!toolEl || !toolEl.contains(document.activeElement)) return;
    var pal = document.getElementById('whPalette');
    if (pal && pal.classList.contains('active')) return;
    var mod = e.ctrlKey || e.metaKey;
    if (e.key === 'Escape' && !mod && !e.shiftKey && !e.altKey) { clearBtn.click(); }
  });
})();
</script>
