---
interface Props {
  lang?: 'en' | 'ru';
}
const { lang = 'en' } = Astro.props;
const isRu = lang === 'ru';
const t = {
  ph: isRu ? 'введите CIDR, например 192.168.1.0/24' : 'enter CIDR, e.g. 192.168.1.0/24',
  copy: isRu ? 'копировать' : 'copy',
  copied: isRu ? 'скопировано' : 'copied',
  clear: isRu ? 'очистить' : 'clear',
  invalid: isRu ? 'неверный формат CIDR' : 'invalid CIDR notation',
  empty: isRu ? '— введите CIDR нотацию' : '— enter CIDR notation',
  network: isRu ? 'Адрес сети' : 'Network Address',
  broadcast: isRu ? 'Широковещательный адрес' : 'Broadcast Address',
  firstHost: isRu ? 'Первый хост' : 'First Host',
  lastHost: isRu ? 'Последний хост' : 'Last Host',
  mask: isRu ? 'Маска подсети' : 'Subnet Mask',
  wildcard: isRu ? 'Wildcard маска' : 'Wildcard Mask',
  prefix: isRu ? 'Префикс CIDR' : 'CIDR Prefix',
  totalHosts: isRu ? 'Всего хостов' : 'Total Hosts',
  usableHosts: isRu ? 'Используемых хостов' : 'Usable Hosts',
  ipClass: isRu ? 'Класс IP' : 'IP Class',
  ipType: isRu ? 'Тип' : 'Type',
  binary: isRu ? 'Двоичный' : 'Binary',
};
---

<style is:global>
  .ci {
    background: var(--surface);
    border: 0.5px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .ci-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 0.5px solid var(--line);
    background: var(--surface-sunken);
    flex-wrap: wrap;
  }

  .ci-input {
    flex: 1;
    min-width: 200px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 15px;
    padding: 5px 10px;
    border: 0.5px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    color: var(--ink);
    outline: none;
    transition: border-color 0.12s;
  }
  .ci-input:focus {
    border-color: var(--accent);
  }
  .ci-input.err {
    border-color: var(--bad);
  }

  .ci-status {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .ci-status.err {
    color: var(--bad);
  }
  .ci-status.ok {
    color: var(--good);
  }

  .ci-action {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    padding: 4px 10px;
    border: 0.5px solid var(--line);
    border-radius: 5px;
    background: var(--bg);
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.12s;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .ci-action:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .ci-body {
    padding: 0;
  }

  .ci-row {
    display: grid;
    grid-template-columns: 200px 1fr 36px;
    align-items: center;
    gap: 0;
    border-bottom: 0.5px solid var(--line);
    padding: 10px 16px;
    transition: background 0.1s;
  }
  .ci-row:last-child {
    border-bottom: none;
  }
  .ci-row:hover {
    background: var(--accent-soft);
  }

  .ci-row-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }

  .ci-row-val {
    font-family: 'JetBrains Mono', monospace;
    font-size: 15px;
    color: var(--ink);
    min-width: 0;
  }
  .ci-row-val.ph {
    color: var(--ink-faint);
    font-size: 13px;
  }
  .ci-row-val.binary {
    font-size: 13px;
    color: var(--ink-soft);
    word-break: break-all;
  }
  .ci-row-val .accent {
    color: var(--accent);
  }

  .ci-copy {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink-faint);
    font-size: 15px;
    display: flex;
    align-items: center;
    padding: 2px;
    border-radius: 4px;
    transition: color 0.1s;
  }
  .ci-copy:hover {
    color: var(--accent);
  }
  .ci-copy.done {
    color: var(--good);
  }
  .ci-copy[disabled] {
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 560px) {
    .ci-row {
      grid-template-columns: 160px 1fr 28px;
    }
    .ci-row-label {
      font-size: 11px;
    }
  }
</style>

<div class="ci">
  <div class="ci-bar">
    <input
      class="ci-input"
      id="ciInput"
      type="text"
      placeholder={t.ph}
      spellcheck="false"
      autocomplete="off"
    />
    <span class="ci-status" id="ciStatus">{t.empty}</span>
    <span class="local-badge">// client-only</span>
    <button class="ci-action" id="ciClear"><i class="ti ti-x"></i>{t.clear}</button>
  </div>
  <div class="ci-body" id="ciBody"></div>
</div>

<script is:inline define:vars={{ t }}>
  (function () {
    var inputEl = document.getElementById('ciInput');
    var statusEl = document.getElementById('ciStatus');
    var bodyEl = document.getElementById('ciBody');
    var clearBtn = document.getElementById('ciClear');

    var ROWS = [
      { key: 'network', label: t.network },
      { key: 'broadcast', label: t.broadcast },
      { key: 'firstHost', label: t.firstHost },
      { key: 'lastHost', label: t.lastHost },
      { key: 'mask', label: t.mask },
      { key: 'wildcard', label: t.wildcard },
      { key: 'prefix', label: t.prefix },
      { key: 'totalHosts', label: t.totalHosts },
      { key: 'usableHosts', label: t.usableHosts },
      { key: 'ipClass', label: t.ipClass },
      { key: 'ipType', label: t.ipType },
      { key: 'binary', label: t.binary, cls: 'binary' },
    ];

    // Build static DOM
    ROWS.forEach(function (row) {
      var div = document.createElement('div');
      div.className = 'ci-row';
      var lbl = document.createElement('span');
      lbl.className = 'ci-row-label';
      lbl.textContent = row.label;
      var val = document.createElement('span');
      val.className = 'ci-row-val ph' + (row.cls ? ' ' + row.cls : '');
      val.id = 'ciR_' + row.key;
      val.textContent = '—';
      var btn = document.createElement('button');
      btn.className = 'ci-copy';
      btn.dataset.key = row.key;
      btn.setAttribute('disabled', '');
      btn.innerHTML = '<i class="ti ti-copy"></i>';
      btn.title = t.copy;
      btn.addEventListener('click', function () {
        var v = document.getElementById('ciR_' + row.key);
        if (!v || v.classList.contains('ph')) return;
        navigator.clipboard.writeText(v.dataset.raw || v.textContent).then(function () {
          btn.innerHTML = '<i class="ti ti-check"></i>';
          btn.classList.add('done');
          setTimeout(function () {
            btn.innerHTML = '<i class="ti ti-copy"></i>';
            btn.classList.remove('done');
          }, 1500);
        });
      });
      div.appendChild(lbl);
      div.appendChild(val);
      div.appendChild(btn);
      bodyEl.appendChild(div);
    });

    function numToIp(n) {
      return [(n >>> 24) & 0xff, (n >>> 16) & 0xff, (n >>> 8) & 0xff, n & 0xff].join('.');
    }
    function ipToNum(ip) {
      var parts = ip.split('.').map(Number);
      if (
        parts.length !== 4 ||
        parts.some(function (p) {
          return isNaN(p) || p < 0 || p > 255;
        })
      )
        return null;
      return ((parts[0] << 24) | (parts[1] << 16) | (parts[2] << 8) | parts[3]) >>> 0;
    }
    function numToBin(n) {
      return ('00000000000000000000000000000000' + n.toString(2)).slice(-32);
    }
    function fmtBin(n, prefix) {
      var b = numToBin(n);
      return b.slice(0, prefix) + '.' + b.slice(prefix);
    }
    function ipClass(first) {
      if (first < 128) return 'A';
      if (first < 192) return 'B';
      if (first < 224) return 'C';
      if (first < 240) return 'D (multicast)';
      return 'E (reserved)';
    }
    function ipType(num) {
      var a = (num >>> 24) & 0xff,
        b = (num >>> 16) & 0xff;
      if (a === 10) return 'Private (RFC1918)';
      if (a === 172 && b >= 16 && b <= 31) return 'Private (RFC1918)';
      if (a === 192 && b === 168) return 'Private (RFC1918)';
      if (a === 127) return 'Loopback';
      if (a === 169 && b === 254) return 'Link-local';
      if (a >= 224 && a < 240) return 'Multicast';
      if (a === 100 && b >= 64 && b <= 127) return 'Shared (RFC6598)';
      return 'Public';
    }

    function setRow(key, val, raw) {
      var el = document.getElementById('ciR_' + key);
      var btn = bodyEl.querySelector('[data-key="' + key + '"]');
      if (!el) return;
      if (val === null) {
        el.textContent = '—';
        el.className = 'ci-row-val ph';
        if (btn) btn.setAttribute('disabled', '');
      } else {
        el.innerHTML = val;
        el.dataset.raw = raw || el.textContent;
        el.className = 'ci-row-val' + (key === 'binary' ? ' binary' : '');
        if (btn) btn.removeAttribute('disabled');
      }
    }

    function clearAll() {
      ROWS.forEach(function (r) {
        setRow(r.key, null);
      });
    }

    function process() {
      var raw = inputEl.value.trim();
      if (!raw) {
        statusEl.textContent = t.empty;
        statusEl.className = 'ci-status';
        inputEl.classList.remove('err');
        clearAll();
        return;
      }
      var m = raw.match(/^(\d+\.\d+\.\d+\.\d+)\/(\d+)$/);
      if (!m) {
        statusEl.textContent = t.invalid;
        statusEl.className = 'ci-status err';
        inputEl.classList.add('err');
        clearAll();
        return;
      }
      var prefix = parseInt(m[2]);
      if (prefix < 0 || prefix > 32) {
        statusEl.textContent = t.invalid;
        statusEl.className = 'ci-status err';
        inputEl.classList.add('err');
        clearAll();
        return;
      }
      var ipNum = ipToNum(m[1]);
      if (ipNum === null) {
        statusEl.textContent = t.invalid;
        statusEl.className = 'ci-status err';
        inputEl.classList.add('err');
        clearAll();
        return;
      }
      inputEl.classList.remove('err');

      var mask = prefix === 0 ? 0 : (0xffffffff << (32 - prefix)) >>> 0;
      var network = (ipNum & mask) >>> 0;
      var broadcast = (network | ~mask) >>> 0;
      var first = prefix < 31 ? network + 1 : network;
      var last = prefix < 31 ? broadcast - 1 : broadcast;
      var total = Math.pow(2, 32 - prefix);
      var usable = prefix < 31 ? total - 2 : total;
      var firstOctet = (network >>> 24) & 0xff;

      var bNet = numToBin(network);
      var bBrd = numToBin(broadcast);
      var binStr =
        '<span class="accent">' +
        bNet.slice(0, prefix) +
        '</span>' +
        bNet.slice(prefix) +
        ' / <span class="accent">' +
        bBrd.slice(0, prefix) +
        '</span>' +
        bBrd.slice(prefix);

      setRow('network', numToIp(network));
      setRow('broadcast', numToIp(broadcast));
      setRow('firstHost', numToIp(first));
      setRow('lastHost', numToIp(last));
      setRow('mask', numToIp(mask));
      setRow('wildcard', numToIp(~mask >>> 0));
      setRow('prefix', '/' + prefix);
      setRow('totalHosts', total.toLocaleString());
      setRow('usableHosts', usable.toLocaleString());
      setRow('ipClass', ipClass(firstOctet));
      setRow('ipType', ipType(network));
      setRow('binary', binStr, bNet + '/' + bBrd);

      statusEl.textContent = numToIp(network) + '/' + prefix;
      statusEl.className = 'ci-status ok';
    }

    inputEl.addEventListener('input', process);
    clearBtn.addEventListener('click', function () {
      inputEl.value = '';
      process();
      inputEl.focus();
    });

    window.toolGetPreset = function () {
      return { input: inputEl.value };
    };
    window.toolSetPreset = function (cfg) {
      inputEl.value = cfg.input ?? '';
      inputEl.dispatchEvent(new Event('input', { bubbles: true }));
    };
  })();
</script>
