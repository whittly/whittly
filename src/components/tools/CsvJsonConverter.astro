---
import PresetsBar from '../PresetsBar.astro';
import BatchPanel from '../BatchPanel.astro';
import FileLoader from '../FileLoader.astro';
interface Props {
  lang?: 'en' | 'ru';
}
const { lang = 'en' } = Astro.props;
const isRu = lang === 'ru';

const t = {
  csvLabel: isRu ? 'CSV' : 'CSV',
  jsonLabel: isRu ? 'JSON' : 'JSON',
  csvPh: isRu ? 'вставьте csv…' : 'paste csv…',
  jsonPh: isRu ? 'вставьте json…' : 'paste json…',
  delimiter: isRu ? 'разделитель' : 'delimiter',
  headers: isRu ? 'первая строка — заголовки' : 'first row is headers',
  autoDetect: isRu ? 'авто' : 'auto',
  convert: isRu ? 'конвертировать →' : 'convert →',
  copy: isRu ? 'копировать' : 'copy',
  copied: isRu ? 'скопировано' : 'copied',
  clear: isRu ? 'очистить' : 'clear',
  csvToJson: isRu ? 'CSV → JSON' : 'CSV → JSON',
  jsonToCsv: isRu ? 'JSON → CSV' : 'JSON → CSV',
  errParse: isRu ? '// ошибка разбора' : '// parse error',
  errNotArr: isRu ? '// json должен быть массивом' : '// json must be an array',
  errEmpty: isRu ? '// вставьте данные' : '// paste data above',
  rows: isRu ? 'строк' : 'rows',
  cols: isRu ? 'столбцов' : 'cols',
};
---

<style is:global>
  .cj {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cj-dir-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cj-dir-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 0.5px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.12s;
  }
  .cj-dir-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .cj-dir-btn:not(.active):hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .cj-opts {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    margin-left: auto;
  }

  .cj-opt-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    color: var(--ink-faint);
  }

  .cj-delim-select {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13.5px;
    background: var(--surface);
    border: 0.5px solid var(--line-strong);
    border-radius: var(--radius-sm);
    padding: 4px 8px;
    color: var(--ink);
    outline: none;
    cursor: pointer;
  }

  .cj-checkbox-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-soft);
    user-select: none;
  }
  .cj-checkbox-wrap input {
    cursor: pointer;
    accent-color: var(--accent);
  }

  .cj-panes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .cj-pane {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cj-pane-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .cj-pane-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    color: var(--ink-faint);
    letter-spacing: 0.05em;
  }

  .cj-pane-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--ink-faint);
  }

  .cj-textarea {
    width: 100%;
    min-height: 280px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    background: var(--surface);
    border: 0.5px solid var(--line-strong);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    color: var(--ink);
    outline: none;
    resize: vertical;
    line-height: 1.6;
    transition: border-color 0.15s;
  }
  .cj-textarea:focus {
    border-color: var(--accent);
  }
  .cj-textarea.err {
    border-color: var(--bad);
    color: var(--bad);
  }
  .cj-textarea[readonly] {
    background: var(--surface-sunken);
    cursor: default;
  }

  .cj-btn-row {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .cj-convert-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13.5px;
    padding: 7px 18px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    border: none;
    cursor: pointer;
    transition: opacity 0.12s;
  }
  .cj-convert-btn:hover {
    opacity: 0.85;
  }

  .cj-copy-btn,
  .cj-clear-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 5px 12px;
    border-radius: 4px;
    border: 0.5px solid var(--line-strong);
    background: none;
    color: var(--ink-faint);
    cursor: pointer;
    transition: all 0.12s;
  }
  .cj-copy-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .cj-clear-btn:hover {
    color: var(--bad);
    border-color: var(--bad);
  }

  @media (max-width: 640px) {
    .cj-panes {
      grid-template-columns: 1fr;
    }
    .cj-opts {
      margin-left: 0;
    }
  }
</style>

<PresetsBar toolName="csv-json" lang={lang} />
<BatchPanel
  toolName="csv-json-converter"
  lang={lang}
  placeholder={isRu ? 'один CSV или JSON на строку…' : 'one CSV or JSON per line…'}
/>
<FileLoader targetId="cjInput" lang={lang} />
<div class="cj" id="cj">
  <div class="cj-dir-row">
    <button class="cj-dir-btn active" id="cjCsvToJson">{t.csvToJson}</button>
    <button class="cj-dir-btn" id="cjJsonToCsv">{t.jsonToCsv}</button>

    <div class="cj-opts">
      <span class="cj-opt-label">{t.delimiter}:</span>
      <select class="cj-delim-select" id="cjDelim">
        <option value="auto">{t.autoDetect}</option>
        <option value=",">,</option>
        <option value=";">;</option>
        <option value="\t">tab</option>
        <option value="|">|</option>
      </select>
      <label class="cj-checkbox-wrap">
        <input type="checkbox" id="cjHeaders" checked />
        {t.headers}
      </label>
    </div>
  </div>

  <div class="cj-panes">
    <div class="cj-pane">
      <div class="cj-pane-head">
        <span class="cj-pane-label" id="cjInputLabel">CSV</span>
        <span class="cj-pane-meta" id="cjInputMeta"></span>
      </div>
      <textarea
        class="cj-textarea"
        id="cjInput"
        data-hist-main-input
        placeholder={t.csvPh}
        spellcheck="false"
        autocomplete="off"></textarea>
      <div class="cj-btn-row">
        <button class="cj-convert-btn" id="cjConvertBtn">{t.convert}</button>
        <button class="cj-clear-btn" id="cjClearBtn">{t.clear}</button>
      </div>
    </div>

    <div class="cj-pane">
      <div class="cj-pane-head">
        <span class="cj-pane-label" id="cjOutputLabel">JSON</span>
        <span class="cj-pane-meta" id="cjOutputMeta"></span>
      </div>
      <textarea class="cj-textarea" id="cjOutput" readonly placeholder={t.jsonPh} spellcheck="false"
      ></textarea>
      <div class="cj-btn-row">
        <button class="cj-copy-btn" id="cjCopyBtn">{t.copy}</button>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ t }}>
  (function () {
    const csvToJsonBtn = document.getElementById('cjCsvToJson');
    const jsonToCsvBtn = document.getElementById('cjJsonToCsv');
    const delimSel = document.getElementById('cjDelim');
    const headersCb = document.getElementById('cjHeaders');
    const inputTA = document.getElementById('cjInput');
    const outputTA = document.getElementById('cjOutput');
    const convertBtn = document.getElementById('cjConvertBtn');
    const clearBtn = document.getElementById('cjClearBtn');
    const copyBtn = document.getElementById('cjCopyBtn');
    const inputLabel = document.getElementById('cjInputLabel');
    const outputLabel = document.getElementById('cjOutputLabel');
    const inputMeta = document.getElementById('cjInputMeta');
    const outputMeta = document.getElementById('cjOutputMeta');

    let mode = 'csv-json'; // 'csv-json' | 'json-csv'

    function setMode(m) {
      mode = m;
      if (m === 'csv-json') {
        csvToJsonBtn.classList.add('active');
        jsonToCsvBtn.classList.remove('active');
        inputLabel.textContent = 'CSV';
        outputLabel.textContent = 'JSON';
        inputTA.placeholder = t.csvPh;
        outputTA.placeholder = t.jsonPh;
      } else {
        jsonToCsvBtn.classList.add('active');
        csvToJsonBtn.classList.remove('active');
        inputLabel.textContent = 'JSON';
        outputLabel.textContent = 'CSV';
        inputTA.placeholder = t.jsonPh;
        outputTA.placeholder = t.csvPh;
      }
      inputTA.value = '';
      outputTA.value = '';
      inputMeta.textContent = '';
      outputMeta.textContent = '';
      inputTA.classList.remove('err');
      outputTA.classList.remove('err');
    }

    csvToJsonBtn.addEventListener('click', () => setMode('csv-json'));
    jsonToCsvBtn.addEventListener('click', () => setMode('json-csv'));

    function detectDelimiter(line) {
      const counts = { ',': 0, ';': 0, '\t': 0, '|': 0 };
      let inQ = false;
      for (const ch of line) {
        if (ch === '"') {
          inQ = !inQ;
          continue;
        }
        if (!inQ && counts[ch] !== undefined) counts[ch]++;
      }
      return Object.entries(counts).sort((a, b) => b[1] - a[1])[0][0];
    }

    function parseCsvLine(line, delim) {
      const result = [];
      let cur = '',
        inQ = false;
      for (let i = 0; i < line.length; i++) {
        const ch = line[i];
        if (ch === '"') {
          if (inQ && line[i + 1] === '"') {
            cur += '"';
            i++;
          } else inQ = !inQ;
        } else if (ch === delim && !inQ) {
          result.push(cur);
          cur = '';
        } else {
          cur += ch;
        }
      }
      result.push(cur);
      return result;
    }

    function csvToJson(csv) {
      const lines = csv.replace(/\r\n/g, '\n').replace(/\r/g, '\n').split('\n');
      const nonEmpty = lines.filter((l) => l.trim());
      if (!nonEmpty.length) return null;

      const rawDelim = delimSel.value;
      const delim =
        rawDelim === 'auto' ? detectDelimiter(nonEmpty[0]) : rawDelim === '\\t' ? '\t' : rawDelim;
      const useHeaders = headersCb.checked;

      let headers, dataLines;
      if (useHeaders) {
        headers = parseCsvLine(nonEmpty[0], delim);
        dataLines = nonEmpty.slice(1);
      } else {
        const colCount = parseCsvLine(nonEmpty[0], delim).length;
        headers = Array.from({ length: colCount }, (_, i) => 'col' + (i + 1));
        dataLines = nonEmpty;
      }

      const rows = dataLines.map((line) => {
        const vals = parseCsvLine(line, delim);
        const obj = {};
        headers.forEach((h, i) => {
          obj[h] = vals[i] !== undefined ? vals[i] : '';
        });
        return obj;
      });

      return { json: JSON.stringify(rows, null, 2), rows: rows.length, cols: headers.length };
    }

    function escCsvField(val) {
      const s = String(val);
      if (
        s.includes(',') ||
        s.includes('"') ||
        s.includes('\n') ||
        s.includes(';') ||
        s.includes('\t') ||
        s.includes('|')
      ) {
        return '"' + s.replace(/"/g, '""') + '"';
      }
      return s;
    }

    function jsonToCsv(jsonStr) {
      let arr;
      try {
        arr = JSON.parse(jsonStr);
      } catch (e) {
        return { err: t.errParse };
      }
      if (!Array.isArray(arr)) return { err: t.errNotArr };
      if (!arr.length) return { csv: '', rows: 0, cols: 0 };

      const rawDelim = delimSel.value;
      const delim = rawDelim === 'auto' ? ',' : rawDelim === '\\t' ? '\t' : rawDelim;

      const useHeaders = headersCb.checked;
      const keys = Object.keys(arr[0]);
      const lines = [];
      if (useHeaders) lines.push(keys.map(escCsvField).join(delim));
      for (const row of arr) {
        lines.push(keys.map((k) => escCsvField(row[k] ?? '')).join(delim));
      }
      return { csv: lines.join('\n'), rows: arr.length, cols: keys.length };
    }

    function convert() {
      const raw = inputTA.value.trim();
      if (!raw) {
        outputTA.value = '';
        outputMeta.textContent = '';
        inputTA.classList.remove('err');
        outputTA.classList.remove('err');
        return;
      }

      if (mode === 'csv-json') {
        const result = csvToJson(raw);
        if (!result) {
          outputTA.value = t.errParse;
          outputTA.classList.add('err');
          return;
        }
        outputTA.value = result.json;
        outputTA.classList.remove('err');
        inputMeta.textContent = result.rows + ' ' + t.rows + ' · ' + result.cols + ' ' + t.cols;
        outputMeta.textContent = result.rows + ' ' + t.rows;
        if (window.pushHistory)
          window.pushHistory(
            'csv ↔ json',
            result.rows + ' rows → json',
            JSON.stringify({
              d: 'c2j',
              delim: delimSel.value,
              h: headersCb.checked,
              t: inputTA.value.trim(),
            })
          );
      } else {
        const result = jsonToCsv(raw);
        if (result.err) {
          outputTA.value = result.err;
          outputTA.classList.add('err');
          inputTA.classList.add('err');
          return;
        }
        inputTA.classList.remove('err');
        outputTA.classList.remove('err');
        outputTA.value = result.csv;
        inputMeta.textContent = result.rows + ' ' + t.rows;
        outputMeta.textContent = result.rows + ' ' + t.rows + ' · ' + result.cols + ' ' + t.cols;
        if (window.pushHistory)
          window.pushHistory(
            'csv ↔ json',
            result.rows + ' rows → csv',
            JSON.stringify({
              d: 'j2c',
              delim: delimSel.value,
              h: headersCb.checked,
              t: inputTA.value.trim(),
            })
          );
      }
    }

    convertBtn.addEventListener('click', convert);
    inputTA.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') convert();
    });

    clearBtn.addEventListener('click', () => {
      inputTA.value = '';
      outputTA.value = '';
      inputMeta.textContent = '';
      outputMeta.textContent = '';
      inputTA.classList.remove('err');
      outputTA.classList.remove('err');
    });

    copyBtn.addEventListener('click', function () {
      const val = outputTA.value;
      if (!val || val === t.errParse || val === t.errNotArr) return;
      navigator.clipboard.writeText(val).then(() => {
        const orig = this.textContent;
        this.textContent = t.copied;
        setTimeout(() => {
          this.textContent = orig;
        }, 1500);
      });
    });

    window.toolGetPreset = function () {
      return {
        input: inputTA.value,
        mode: mode,
        delimiter: delimSel.value,
        hasHeaders: headersCb.checked,
      };
    };
    window.toolSetPreset = function (cfg) {
      inputTA.value = cfg.input ?? '';
      inputTA.dispatchEvent(new Event('input', { bubbles: true }));
    };
    // ── History restore ──
    var _rts = sessionStorage.getItem('wh_restore_ts');
    if (_rts) {
      var _idbReq = indexedDB.open('whittly', 1);
      _idbReq.onsuccess = function (ev) {
        var db = ev.target.result;
        var r = db
          .transaction('hist_inputs', 'readonly')
          .objectStore('hist_inputs')
          .get(Number(_rts));
        r.onsuccess = function () {
          if (!r.result) return;
          try {
            var d = JSON.parse(r.result.input);
            if (!d || d.t === undefined) return;
            if (d.d === 'j2c' && jsonToCsvBtn) jsonToCsvBtn.click();
            else if (csvToJsonBtn) csvToJsonBtn.click();
            if (delimSel) delimSel.value = d.delim || 'auto';
            if (headersCb) headersCb.checked = d.h !== false;
            inputTA.value = d.t;
            var convertBtnEl = document.getElementById('cjConvertBtn');
            if (convertBtnEl) convertBtnEl.click();
            inputTA.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } catch {}
        };
      };
    }
  })();
</script>
