---
import PresetsBar from '../PresetsBar.astro';
import BatchPanel from '../BatchPanel.astro';
interface Props {
  lang?: 'en' | 'ru';
}
const { lang = 'en' } = Astro.props;
const isRu = lang === 'ru';
const t = {
  encode: isRu ? 'кодировать' : 'encode',
  decode: isRu ? 'декодировать' : 'decode',
  pasteEncode: isRu ? '— вставьте html' : '— paste html to start',
  pasteDecode: isRu ? '— вставьте текст с entities' : '— paste text with entities to start',
  swap: isRu ? 'поменять' : 'swap',
  copy: isRu ? 'копировать' : 'copy',
  copied: isRu ? 'скопировано' : 'copied',
  clear: isRu ? 'очистить' : 'clear',
  phEncode: isRu ? 'вставьте html сюда…' : 'paste html or text here…',
  phDecode: isRu ? 'вставьте текст с entities…' : 'paste text with entities here…',
  outputPh: isRu ? '// результат появится здесь' : '// output appears here',
  encoded: isRu ? 'закодировано' : 'encoded',
  decoded: isRu ? 'декодировано' : 'decoded',
  allNonAscii: isRu ? 'все non-ASCII' : 'all non-ASCII',
  sequences: isRu ? ' символов' : ' entities',
};
---

<style is:global>
  .he {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 320px);
    min-height: 480px;
    background: var(--surface);
    border: 0.5px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .he-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 0.5px solid var(--line);
    background: var(--surface-sunken);
    flex-shrink: 0;
    flex-wrap: wrap;
  }
  .he-modes {
    display: flex;
    gap: 4px;
  }
  .he-mode {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    padding: 5px 10px;
    border: 0.5px solid var(--line);
    border-radius: 5px;
    background: var(--bg);
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.12s;
  }
  .he-mode:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .he-mode.active {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .he-check {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--ink-soft);
    cursor: pointer;
    user-select: none;
    padding: 5px 8px;
    border: 0.5px solid transparent;
    border-radius: 5px;
    transition: all 0.12s;
  }
  .he-check:hover {
    color: var(--ink);
    border-color: var(--line);
  }
  .he-check input[type='checkbox'] {
    accent-color: var(--accent);
    cursor: pointer;
  }
  .he-status {
    flex: 1;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--ink-faint);
    text-align: center;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .he-status.ok {
    color: var(--good);
  }
  .he-status.err {
    color: var(--bad);
  }
  .he-action {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    padding: 5px 10px;
    border: 0.5px solid var(--line);
    border-radius: 5px;
    background: var(--bg);
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.12s;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .he-action:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .he-action.done {
    color: var(--good);
    border-color: var(--good);
  }
  .he-swap {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    padding: 5px 10px;
    border: 0.5px solid var(--line);
    border-radius: 5px;
    background: var(--bg);
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.12s;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .he-swap:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .he-panels {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    flex: 1;
    overflow: hidden;
  }
  .he-in {
    padding: 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--ink);
    background: transparent;
    border: none;
    outline: none;
    resize: none;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    overflow: auto;
  }
  .he-sep {
    background: var(--line);
  }
  .he-out {
    padding: 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14.5px;
    line-height: 1.65;
    overflow: auto;
    margin: 0;
    background: var(--surface-sunken);
    white-space: pre-wrap;
    word-break: break-all;
  }
  .he-out .ok {
    color: var(--ink);
  }
  .he-out .ph {
    color: var(--ink-faint);
  }
  .he-out .er {
    color: var(--bad);
  }
  @media (max-width: 760px) {
    .he {
      height: auto;
      min-height: 0;
    }
    .he-panels {
      grid-template-columns: 1fr;
      grid-template-rows: 240px 1px 240px;
    }
    .he-sep {
      width: 100%;
      height: 1px;
    }
    .he-in,
    .he-out {
      height: 240px;
    }
  }
</style>

<PresetsBar toolName="html-entities" lang={lang} />
<BatchPanel toolName="html-entities" lang={lang} />
<div class="he">
  <div class="he-bar">
    <div class="he-modes">
      <button class="he-mode active" data-mode="encode">{t.encode}</button>
      <button class="he-mode" data-mode="decode">{t.decode}</button>
    </div>
    <label class="he-check">
      <input type="checkbox" id="heAllNonAscii" />
      {t.allNonAscii}
    </label>
    <span class="he-status" id="heStatus">{t.pasteEncode}</span>
    <span class="local-badge">// client-only</span>
    <button class="he-swap" id="heSwap"><i class="ti ti-transfer-vertical"></i>{t.swap}</button>
    <button class="he-action" id="heCopy"
      ><i class="ti ti-copy"></i>{t.copy}<span class="kbd-hint">⌘⇧C</span></button
    >
    <button class="he-action" id="heClear"
      ><i class="ti ti-x"></i>{t.clear}<span class="kbd-hint">esc</span></button
    >
  </div>
  <div class="he-panels">
    <textarea
      class="he-in"
      id="heIn"
      data-hist-main-input
      spellcheck="false"
      placeholder={t.phEncode}></textarea>
    <div class="he-sep"></div>
    <pre class="he-out" id="heOut"><span class="ph">{t.outputPh}</span></pre>
  </div>
</div>

<script is:inline define:vars={{ t }}>
  (function () {
    var inEl = document.getElementById('heIn');
    var outEl = document.getElementById('heOut');
    var statusEl = document.getElementById('heStatus');
    var allNonAscii = document.getElementById('heAllNonAscii');
    var swapBtn = document.getElementById('heSwap');
    var copyBtn = document.getElementById('heCopy');
    var clearBtn = document.getElementById('heClear');

    var mode = 'encode';
    var lastOutput = '';

    function esc(s) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function encodeEntities(str, all) {
      var result = '';
      for (var i = 0; i < str.length; i++) {
        var ch = str[i];
        var cp = str.codePointAt(i);
        if (cp > 0xffff) i++; /* surrogate pair */
        if (ch === '&') result += '&amp;';
        else if (ch === '<') result += '&lt;';
        else if (ch === '>') result += '&gt;';
        else if (ch === '"') result += '&quot;';
        else if (ch === "'") result += '&#39;';
        else if (all && cp > 127) result += '&#' + cp + ';';
        else result += ch;
      }
      return result;
    }

    function decodeEntities(str) {
      var ta = document.createElement('textarea');
      ta.innerHTML = str;
      return ta.value;
    }

    function countEntities(encoded) {
      return (encoded.match(/&[^;]+;/g) || []).length;
    }

    function process() {
      var raw = inEl.value;
      if (!raw) {
        outEl.innerHTML = '<span class="ph">' + t.outputPh + '</span>';
        statusEl.textContent = mode === 'encode' ? t.pasteEncode : t.pasteDecode;
        statusEl.className = 'he-status';
        lastOutput = '';
        return;
      }
      try {
        var result;
        if (mode === 'encode') {
          result = encodeEntities(raw, allNonAscii.checked);
          var n = countEntities(result);
          statusEl.textContent = t.encoded + ' · ' + n + t.sequences;
        } else {
          result = decodeEntities(raw);
          statusEl.textContent = t.decoded + ' · ' + result.length + ' chars';
        }
        lastOutput = result;
        outEl.innerHTML = '<span class="ok">' + esc(result) + '</span>';
        statusEl.className = 'he-status ok';
        if (window.pushHistory)
          window.pushHistory(
            'html entity encoder',
            statusEl.textContent,
            JSON.stringify({ m: mode, a: allNonAscii.checked, t: inEl.value.trim() })
          );
        outEl.classList.remove('flash-ok');
        void outEl.offsetWidth;
        outEl.classList.add('flash-ok');
      } catch (e) {
        lastOutput = '';
        outEl.innerHTML = '<span class="er">// ' + esc(e.message) + '</span>';
        statusEl.textContent = e.message;
        statusEl.className = 'he-status err';
      }
    }

    inEl.addEventListener('input', process);
    allNonAscii.addEventListener('change', process);

    document.querySelectorAll('.he-mode').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('.he-mode').forEach(function (b) {
          b.classList.remove('active');
        });
        btn.classList.add('active');
        mode = btn.dataset.mode;
        inEl.placeholder = mode === 'encode' ? t.phEncode : t.phDecode;
        process();
      });
    });

    swapBtn.addEventListener('click', function () {
      if (!lastOutput) return;
      inEl.value = lastOutput;
      mode = mode === 'encode' ? 'decode' : 'encode';
      document.querySelectorAll('.he-mode').forEach(function (b) {
        b.classList.toggle('active', b.dataset.mode === mode);
      });
      process();
    });

    copyBtn.addEventListener('click', function () {
      if (!lastOutput) return;
      navigator.clipboard.writeText(lastOutput).then(function () {
        copyBtn.innerHTML = '<i class="ti ti-check"></i>' + t.copied;
        copyBtn.classList.add('done');
        setTimeout(function () {
          copyBtn.innerHTML = '<i class="ti ti-copy"></i>' + t.copy;
          copyBtn.classList.remove('done');
        }, 1600);
      });
    });

    clearBtn.addEventListener('click', function () {
      inEl.value = '';
      process();
      inEl.focus();
    });

    window.toolGetPreset = function () {
      return { input: inEl.value };
    };
    window.toolSetPreset = function (cfg) {
      inEl.value = cfg.input ?? '';
      inEl.dispatchEvent(new Event('input', { bubbles: true }));
    };

    document.addEventListener('keydown', function (e) {
      var toolEl = document.querySelector('.he');
      if (!toolEl || !toolEl.contains(document.activeElement)) return;
      var pal = document.getElementById('whPalette');
      if (pal && pal.classList.contains('active')) return;
      var mod = e.ctrlKey || e.metaKey;
      if (mod && e.shiftKey && e.key.toLowerCase() === 'c') {
        e.preventDefault();
        if (lastOutput) copyBtn.click();
      }
      if (e.key === 'Escape' && !mod && !e.shiftKey && !e.altKey) {
        inEl.value = '';
        process();
        inEl.focus();
      }
    });

    window.toolBatchProcess = function (lines) {
      var encodeAll = allNonAscii.checked;
      return lines.map(function (line) {
        try {
          return mode === 'decode' ? decodeEntities(line) : encodeEntities(line, encodeAll);
        } catch (e) {
          return '// error: ' + e.message;
        }
      });
    };
    // ── History restore ──
    var _rts = sessionStorage.getItem('wh_restore_ts');
    if (_rts) {
      var _idbReq = indexedDB.open('whittly', 1);
      _idbReq.onsuccess = function (ev) {
        var db = ev.target.result;
        var r = db
          .transaction('hist_inputs', 'readonly')
          .objectStore('hist_inputs')
          .get(Number(_rts));
        r.onsuccess = function () {
          if (!r.result) return;
          try {
            var d = JSON.parse(r.result.input);
            if (!d || d.t === undefined) return;
            var mb = document.querySelector('.he-mode[data-mode="' + (d.m || 'encode') + '"]');
            if (mb) mb.click();
            if (allNonAscii) allNonAscii.checked = !!d.a;
            inEl.value = d.t;
            inEl.dispatchEvent(new Event('input', { bubbles: true }));
            inEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } catch {}
        };
      };
    }
  })();
</script>
