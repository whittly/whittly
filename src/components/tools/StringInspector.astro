---
import PresetsBar from '../PresetsBar.astro';
interface Props { lang?: 'en' | 'ru'; }
const { lang = 'en' } = Astro.props;
const isRu = lang === 'ru';

const t = {
  inputPh:    isRu ? 'вставьте текст…'           : 'paste or type text…',
  chars:      isRu ? 'символы'                   : 'chars',
  bytes:      isRu ? 'байты (utf-8)'             : 'bytes (utf-8)',
  words:      isRu ? 'слова'                     : 'words',
  lines:      isRu ? 'строки'                    : 'lines',
  unique:     isRu ? 'уникальных символов'       : 'unique chars',
  entropy:    isRu ? 'энтропия (бит/символ)'     : 'entropy (bits/char)',
  freqHead:   isRu ? 'частота символов'          : 'character frequency',
  copy:       isRu ? 'копировать'                : 'copy',
  copied:     isRu ? 'скопировано'              : 'copied',
  empty:      isRu ? '—'                         : '—',
};
---
<style is:global>
.si { display: flex; flex-direction: column; gap: 16px; }

.si-input {
  width: 100%;
  font-family: 'JetBrains Mono', monospace; font-size: 14px;
  background: var(--surface); border: 0.5px solid var(--line-strong);
  border-radius: var(--radius-md); padding: 12px 16px; color: var(--ink);
  outline: none; resize: vertical; min-height: 120px;
  transition: border-color 0.15s; line-height: 1.6;
}
.si-input:focus { border-color: var(--accent); }

.si-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--line);
  border: 0.5px solid var(--line);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.si-stat {
  background: var(--surface);
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.si-stat-val {
  font-family: 'JetBrains Mono', monospace;
  font-size: 22px;
  color: var(--ink);
  letter-spacing: -0.02em;
  line-height: 1;
}

.si-stat-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: var(--ink-faint);
  letter-spacing: 0.04em;
}

.si-freq {
  background: var(--surface);
  border: 0.5px solid var(--line);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.si-freq-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 14px;
  border-bottom: 0.5px solid var(--line);
  background: var(--surface-sunken);
  font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px;
  color: var(--ink-faint);
}

.si-freq-body {
  padding: 12px 14px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  min-height: 48px;
}

.si-freq-tag {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: var(--surface-sunken);
  border: 0.5px solid var(--line);
  border-radius: 5px;
  padding: 3px 8px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 13.5px;
  color: var(--ink-soft);
}

.si-freq-tag .si-fchar { color: var(--ink); }
.si-freq-tag .si-fcount { color: var(--ink-faint); font-size: 10.5px; }

.si-freq-empty {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13.5px;
  color: var(--ink-faint);
  align-self: center;
}

@media (max-width: 640px) {
  .si-stats { grid-template-columns: repeat(2, 1fr); }
}
</style>

<PresetsBar toolName="string-inspector" lang={lang} />
<div class="si" id="si">
  <textarea class="si-input" id="siInput" data-hist-main-input placeholder={t.inputPh} spellcheck="false" autocomplete="off"></textarea>

  <div class="si-stats">
    <div class="si-stat">
      <span class="si-stat-val" id="siChars">{t.empty}</span>
      <span class="si-stat-label">{t.chars}</span>
    </div>
    <div class="si-stat">
      <span class="si-stat-val" id="siBytes">{t.empty}</span>
      <span class="si-stat-label">{t.bytes}</span>
    </div>
    <div class="si-stat">
      <span class="si-stat-val" id="siWords">{t.empty}</span>
      <span class="si-stat-label">{t.words}</span>
    </div>
    <div class="si-stat">
      <span class="si-stat-val" id="siLines">{t.empty}</span>
      <span class="si-stat-label">{t.lines}</span>
    </div>
    <div class="si-stat">
      <span class="si-stat-val" id="siUnique">{t.empty}</span>
      <span class="si-stat-label">{t.unique}</span>
    </div>
    <div class="si-stat">
      <span class="si-stat-val" id="siEntropy">{t.empty}</span>
      <span class="si-stat-label">{t.entropy}</span>
    </div>
  </div>

  <div class="si-freq">
    <div class="si-freq-head">
      <span>{t.freqHead}</span>
    </div>
    <div class="si-freq-body" id="siFreqBody">
      <span class="si-freq-empty" id="siFreqEmpty">{t.inputPh}</span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ t }}>
(function () {
  const input    = document.getElementById('siInput');
  const charsEl  = document.getElementById('siChars');
  const bytesEl  = document.getElementById('siBytes');
  const wordsEl  = document.getElementById('siWords');
  const linesEl  = document.getElementById('siLines');
  const uniqueEl = document.getElementById('siUnique');
  const entropyEl= document.getElementById('siEntropy');
  const freqBody = document.getElementById('siFreqBody');
  const freqEmpty= document.getElementById('siFreqEmpty');

  const enc = new TextEncoder();

  function utf8Bytes(str) {
    return enc.encode(str).length;
  }

  function shannonEntropy(str) {
    if (!str.length) return 0;
    const freq = {};
    for (const ch of str) freq[ch] = (freq[ch] || 0) + 1;
    const n = str.length;
    let h = 0;
    for (const c of Object.values(freq)) {
      const p = c / n;
      h -= p * Math.log2(p);
    }
    return h;
  }

  function fmt(n) {
    return n.toLocaleString('en');
  }

  function analyze() {
    const text = input.value;

    if (!text) {
      [charsEl, bytesEl, wordsEl, linesEl, uniqueEl, entropyEl].forEach(e => { e.textContent = t.empty; });
      freqBody.innerHTML = '';
      freqBody.appendChild(freqEmpty);
      return;
    }

    const chars   = [...text].length;
    const bytes   = utf8Bytes(text);
    const words   = text.trim() ? text.trim().split(/\s+/).length : 0;
    const lines   = text.split('\n').length;
    const unique  = new Set([...text]).size;
    const entropy = shannonEntropy(text);

    charsEl.textContent   = fmt(chars);
    bytesEl.textContent   = fmt(bytes);
    wordsEl.textContent   = fmt(words);
    linesEl.textContent   = fmt(lines);
    uniqueEl.textContent  = fmt(unique);
    entropyEl.textContent = entropy.toFixed(3);
    if (window.pushHistory) window.pushHistory('string inspector', chars + ' chars · ' + bytes + ' bytes · ' + words + ' words', input.value.trim());

    const freq = {};
    for (const ch of text) freq[ch] = (freq[ch] || 0) + 1;
    const sorted = Object.entries(freq).sort((a, b) => b[1] - a[1]).slice(0, 40);

    freqBody.innerHTML = '';
    for (const [ch, cnt] of sorted) {
      const tag = document.createElement('span');
      tag.className = 'si-freq-tag';
      const display = ch === ' ' ? '·' : ch === '\n' ? '↵' : ch === '\t' ? '⇥' : ch;
      tag.innerHTML = `<span class="si-fchar">${display}</span><span class="si-fcount">×${cnt}</span>`;
      freqBody.appendChild(tag);
    }
  }

  input.addEventListener('input', analyze);

  window.toolGetPreset = function () {
    return { input: input.value };
  };
  window.toolSetPreset = function (cfg) {
    input.value = cfg.input ?? '';
    input.dispatchEvent(new Event('input', { bubbles: true }));
  };
})();
</script>
