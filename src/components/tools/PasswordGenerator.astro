---
interface Props { lang?: 'en' | 'ru'; }
const { lang = 'en' } = Astro.props;
const isRu = lang === 'ru';
const t = {
  length:     isRu ? 'длина' : 'length',
  upper:      isRu ? 'A–Z'  : 'A–Z',
  lower:      isRu ? 'a–z'  : 'a–z',
  digits:     isRu ? '0–9'  : '0–9',
  symbols:    isRu ? '!@#…' : '!@#…',
  noAmbig:    isRu ? 'без схожих' : 'no ambiguous',
  copy:       isRu ? 'копировать' : 'copy',
  copied:     isRu ? 'скопировано': 'copied',
  regen:      isRu ? 'ещё'        : 'regenerate',
  entropy:    isRu ? 'энтропия'   : 'entropy',
  bits:       isRu ? ' бит'       : ' bits',
  weak:       isRu ? 'слабый'     : 'weak',
  fair:       isRu ? 'средний'    : 'fair',
  strong:     isRu ? 'сильный'    : 'strong',
  veryStrong: isRu ? 'очень сильный' : 'very strong',
  noChars:    isRu ? 'выберите хотя бы один набор символов' : 'enable at least one character set',
};
---
<style is:global>
  .pg {
    background: var(--surface);
    border: 0.5px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .pg-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 0.5px solid var(--line);
    background: var(--surface-sunken);
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  .pg-check {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    color: var(--ink-soft);
    cursor: pointer;
    user-select: none;
    padding: 4px 7px;
    border: 0.5px solid transparent;
    border-radius: 5px;
    transition: all 0.12s;
  }
  .pg-check:hover { color: var(--ink); border-color: var(--line); }
  .pg-check input[type="checkbox"] { accent-color: var(--accent); cursor: pointer; }

  .pg-action {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    padding: 5px 10px;
    border: 0.5px solid var(--line);
    border-radius: 5px;
    background: var(--bg);
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.12s;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .pg-action:hover { color: var(--ink); border-color: var(--line-strong); }
  .pg-action.done  { color: var(--good); border-color: var(--good); }

  .pg-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pg-password-wrap {
    position: relative;
  }

  .pg-password {
    width: 100%;
    font-family: 'JetBrains Mono', monospace;
    font-size: 20px;
    letter-spacing: 0.04em;
    padding: 18px 20px;
    padding-right: 56px;
    border: 0.5px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--ink);
    box-sizing: border-box;
    word-break: break-all;
    line-height: 1.5;
    min-height: 72px;
  }
  .pg-password.err { color: var(--bad); font-size: 13px; }

  .pg-regen-inline {
    position: absolute;
    top: 50%;
    right: 14px;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0.5px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink-faint);
    cursor: pointer;
    font-size: 15px;
    transition: all 0.12s;
  }
  .pg-regen-inline:hover { color: var(--ink); border-color: var(--line-strong); }

  .pg-controls {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .pg-len-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 180px;
  }

  .pg-len-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .pg-slider {
    flex: 1;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .pg-len-val {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--ink);
    min-width: 28px;
    text-align: right;
  }

  .pg-entropy {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 160px;
  }

  .pg-entropy-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .pg-entropy-bar-wrap {
    flex: 1;
    height: 4px;
    background: var(--surface-sunken);
    border-radius: 2px;
    overflow: hidden;
  }

  .pg-entropy-bar {
    height: 100%;
    border-radius: 2px;
    transition: width 0.2s, background-color 0.2s;
    background: var(--ink-faint);
  }

  .pg-entropy-val {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-soft);
    white-space: nowrap;
    min-width: 80px;
    text-align: right;
  }

  @media (max-width: 640px) {
    .pg-body { padding: 16px; }
    .pg-password { font-size: 15px; }
  }
</style>

<div class="pg">
  <div class="pg-bar">
    <label class="pg-check"><input type="checkbox" id="pgUpper" checked />A–Z</label>
    <label class="pg-check"><input type="checkbox" id="pgLower" checked />a–z</label>
    <label class="pg-check"><input type="checkbox" id="pgDigits" checked />0–9</label>
    <label class="pg-check"><input type="checkbox" id="pgSymbols" checked />{t.symbols}</label>
    <label class="pg-check"><input type="checkbox" id="pgNoAmbig" />{t.noAmbig}</label>
    <span class="local-badge">// client-only · webcrypto</span>
    <button class="pg-action" id="pgRegen"><i class="ti ti-refresh"></i>{t.regen}<span class="kbd-hint">⌘↵</span></button>
    <button class="pg-action" id="pgCopy"><i class="ti ti-copy"></i>{t.copy}<span class="kbd-hint">⌘⇧C</span></button>
  </div>
  <div class="pg-body">
    <div class="pg-password-wrap">
      <div class="pg-password" id="pgPassword"></div>
      <button class="pg-regen-inline" id="pgRegenInline" title={t.regen}><i class="ti ti-refresh"></i></button>
    </div>
    <div class="pg-controls">
      <div class="pg-len-wrap">
        <span class="pg-len-label">{t.length}</span>
        <input class="pg-slider" type="range" id="pgLen" min="4" max="128" value="20" />
        <span class="pg-len-val" id="pgLenVal">20</span>
      </div>
      <div class="pg-entropy">
        <span class="pg-entropy-label" id="pgEntropyLabel">{t.entropy}</span>
        <div class="pg-entropy-bar-wrap">
          <div class="pg-entropy-bar" id="pgEntropyBar" style="width:0%"></div>
        </div>
        <span class="pg-entropy-val" id="pgEntropyVal">—</span>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ t }}>
(function () {
  var pwEl       = document.getElementById('pgPassword');
  var lenSlider  = document.getElementById('pgLen');
  var lenVal     = document.getElementById('pgLenVal');
  var regenBtn   = document.getElementById('pgRegen');
  var regenIBtn  = document.getElementById('pgRegenInline');
  var copyBtn    = document.getElementById('pgCopy');
  var upperCb    = document.getElementById('pgUpper');
  var lowerCb    = document.getElementById('pgLower');
  var digitsCb   = document.getElementById('pgDigits');
  var symbolsCb  = document.getElementById('pgSymbols');
  var noAmbigCb  = document.getElementById('pgNoAmbig');
  var barEl      = document.getElementById('pgEntropyBar');
  var valEl      = document.getElementById('pgEntropyVal');

  var UPPER   = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  var LOWER   = 'abcdefghijklmnopqrstuvwxyz';
  var DIGITS  = '0123456789';
  var SYMBOLS = '!@#$%^&*()-_=+[]{}|;:,.<>?';
  var AMBIG   = /[ilI1oO0|]/g;

  var lastPassword = '';

  function buildCharset() {
    var cs = '';
    if (upperCb.checked)   cs += UPPER;
    if (lowerCb.checked)   cs += LOWER;
    if (digitsCb.checked)  cs += DIGITS;
    if (symbolsCb.checked) cs += SYMBOLS;
    if (noAmbigCb.checked) cs = cs.replace(AMBIG, '');
    return cs;
  }

  function randomChar(charset) {
    var arr = new Uint32Array(1);
    var max = Math.floor(0x100000000 / charset.length) * charset.length;
    do { crypto.getRandomValues(arr); } while (arr[0] >= max);
    return charset[arr[0] % charset.length];
  }

  function generatePassword(len, charset) {
    var pw = '';
    for (var i = 0; i < len; i++) pw += randomChar(charset);
    return pw;
  }

  function entropyBits(len, charsetSize) {
    if (charsetSize === 0) return 0;
    return Math.round(len * Math.log2(charsetSize));
  }

  function strengthLabel(bits) {
    if (bits < 40)  return { label: t.weak,       color: 'var(--bad)',   pct: 15 };
    if (bits < 60)  return { label: t.fair,        color: '#E8A23A',      pct: 40 };
    if (bits < 80)  return { label: t.strong,      color: 'var(--good)',  pct: 70 };
                    return { label: t.veryStrong,  color: '#4F8BF9',      pct: 100 };
  }

  function generate() {
    var len     = parseInt(lenSlider.value, 10);
    var charset = buildCharset();

    lenVal.textContent = String(len);

    if (!charset) {
      pwEl.textContent = t.noChars;
      pwEl.className   = 'pg-password err';
      barEl.style.width = '0%';
      valEl.textContent = '—';
      lastPassword = '';
      return;
    }

    var pw      = generatePassword(len, charset);
    lastPassword = pw;
    pwEl.textContent = pw;
    pwEl.className   = 'pg-password';

    var bits    = entropyBits(len, charset.length);
    var str     = strengthLabel(bits);
    barEl.style.width           = str.pct + '%';
    barEl.style.backgroundColor = str.color;
    valEl.textContent = bits + t.bits + ' · ' + str.label;

    pwEl.classList.remove('flash-ok'); void pwEl.offsetWidth; pwEl.classList.add('flash-ok');
    if (window.pushHistory) window.pushHistory('password generator', str.label + ' · ' + bits + t.bits);
  }

  lenSlider.addEventListener('input', generate);
  upperCb.addEventListener('change', generate);
  lowerCb.addEventListener('change', generate);
  digitsCb.addEventListener('change', generate);
  symbolsCb.addEventListener('change', generate);
  noAmbigCb.addEventListener('change', generate);

  function doRegen() { generate(); }
  regenBtn.addEventListener('click', doRegen);
  regenIBtn.addEventListener('click', doRegen);

  copyBtn.addEventListener('click', function () {
    if (!lastPassword) return;
    navigator.clipboard.writeText(lastPassword).then(function () {
      copyBtn.innerHTML = '<i class="ti ti-check"></i>' + t.copied;
      copyBtn.classList.add('done');
      setTimeout(function () {
        copyBtn.innerHTML = '<i class="ti ti-copy"></i>' + t.copy;
        copyBtn.classList.remove('done');
      }, 1600);
    });
  });

  document.addEventListener('keydown', function (e) {
    var toolEl = document.querySelector('.pg');
    if (!toolEl || !toolEl.contains(document.activeElement)) return;
    var pal = document.getElementById('whPalette');
    if (pal && pal.classList.contains('active')) return;
    var mod = e.ctrlKey || e.metaKey;
    if (mod && !e.shiftKey && e.key === 'Enter') { e.preventDefault(); generate(); }
    if (mod && e.shiftKey && e.key.toLowerCase() === 'c') { e.preventDefault(); copyBtn.click(); }
  });

  /* auto-generate on load */
  generate();
})();
</script>
