---
import PresetsBar from '../PresetsBar.astro';
interface Props {
  lang?: 'en' | 'ru';
}
const { lang = 'en' } = Astro.props;
const isRu = lang === 'ru';
---

<style is:global>
  .qc {
    background: var(--surface);
    border: 0.5px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: visible;
  }

  .qc-top {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 16px 18px 12px;
    border-bottom: 0.5px solid var(--line);
    background: var(--surface-sunken);
  }

  .qc-expr-wrap {
    flex: 1;
    min-width: 0;
  }

  .qc-expr {
    width: 100%;
    box-sizing: border-box;
    font-family: 'JetBrains Mono', monospace;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: 0.05em;
    padding: 9px 13px;
    background: var(--bg);
    border: 0.5px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink);
    outline: none;
    transition: border-color 0.15s;
  }
  .qc-expr:focus {
    border-color: var(--accent);
  }
  .qc-expr.qc-err {
    border-color: var(--bad);
  }

  .qc-expr-hint {
    padding: 4px 13px 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }

  .qc-presets-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .qc-presets-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    padding: 9px 12px;
    border: 0.5px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink-soft);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.12s;
    white-space: nowrap;
  }
  .qc-presets-btn:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .qc-presets-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background: var(--surface);
    border: 0.5px solid var(--line-strong);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    z-index: 50;
    min-width: 300px;
    overflow: hidden;
  }

  .qc-preset {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 14px;
    cursor: pointer;
    border-bottom: 0.5px solid var(--line);
    transition: background 0.1s;
  }
  .qc-preset:last-child {
    border-bottom: none;
  }
  .qc-preset:hover {
    background: var(--accent-soft);
  }
  .qc-preset-lbl {
    font-size: 14px;
    color: var(--ink);
  }
  .qc-preset-expr {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-faint);
  }

  .qc-summary {
    padding: 15px 18px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink-soft);
    border-bottom: 0.5px solid var(--line);
    min-height: 54px;
    display: flex;
    align-items: center;
  }
  .qc-summary.ok {
    color: var(--ink);
  }
  .qc-summary.err {
    color: var(--bad);
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    font-weight: 400;
  }

  .qc-fields {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    border-bottom: 0.5px solid var(--line);
  }

  .qc-field {
    padding: 12px 14px 11px;
    border-right: 0.5px solid var(--line);
  }
  .qc-field:last-child {
    border-right: none;
  }

  .qc-fval {
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin-bottom: 3px;
  }
  .qc-fname {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    margin-bottom: 4px;
  }
  .qc-fdesc {
    font-size: 12.5px;
    color: var(--ink-soft);
    line-height: 1.35;
  }

  .qc-runs-head {
    padding: 13px 18px 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.05em;
  }

  .qc-runs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    padding: 0 18px 18px;
  }

  .qc-run {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    background: var(--surface-sunken);
    border-radius: var(--radius-sm);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    color: var(--ink-soft);
  }
  .qc-run-n {
    font-size: 10px;
    color: var(--accent);
    font-weight: 700;
    width: 14px;
    flex-shrink: 0;
  }

  .qc-no-runs {
    grid-column: 1 / -1;
    padding: 12px 0;
    color: var(--ink-faint);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
  }

  .qc-presets-section {
    border-top: 0.5px solid var(--line);
    padding: 13px 18px 20px;
  }
  .qc-presets-head {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.05em;
    margin-bottom: 10px;
  }
  .qc-presets-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
  }

  .qc-preset-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    background: var(--surface-sunken);
    border: 0.5px solid var(--line);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      border-color 0.12s,
      background 0.12s;
  }
  .qc-preset-card:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .qc-preset-card .qc-preset-lbl {
    font-size: 14px;
  }
  .qc-preset-card .qc-preset-expr {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    color: var(--ink-faint);
    flex-shrink: 0;
  }

  @media (max-width: 1100px) {
    .qc-fields {
      grid-template-columns: repeat(4, 1fr);
    }
    .qc-field:nth-child(4) {
      border-right: none;
    }
    .qc-field:nth-child(5),
    .qc-field:nth-child(6),
    .qc-field:nth-child(7) {
      border-top: 0.5px solid var(--line);
    }
    .qc-field:nth-child(7) {
      border-right: none;
    }
  }

  @media (max-width: 700px) {
    .qc-fields {
      grid-template-columns: repeat(2, 1fr);
    }
    .qc-field:nth-child(2n) {
      border-right: none;
    }
    .qc-field:nth-child(n + 3) {
      border-top: 0.5px solid var(--line);
    }
    .qc-runs {
      grid-template-columns: repeat(2, 1fr);
    }
    .qc-presets-grid {
      grid-template-columns: 1fr;
    }
    .qc-top {
      flex-wrap: wrap;
    }
  }
</style>

<PresetsBar toolName="quartz-cron" lang={lang} />
<div class="qc">
  <div class="qc-top">
    <div class="qc-expr-wrap">
      <input
        class="qc-expr"
        id="qcExpr"
        data-hist-main-input
        type="text"
        value="0 0 12 ? * MON-FRI"
        spellcheck="false"
        autocomplete="off"
        autocorrect="off"
      />
      <div class="qc-expr-hint">
        {
          isRu
            ? 'секунды · минуты · часы · день · месяц · день-нед. · [год]'
            : 'seconds · minutes · hours · day-of-month · month · day-of-week · [year]'
        }
        <span class="local-badge" style="margin-left:10px;">// client-only</span>
      </div>
    </div>
    <div class="qc-presets-wrap">
      <button class="qc-presets-btn" id="qcPresetsBtn">
        {isRu ? 'шаблоны' : 'presets'}
        <i class="ti ti-chevron-down"></i>
      </button>
      <div class="qc-presets-menu" id="qcPresetsMenu" style="display:none"></div>
    </div>
  </div>

  <div class="qc-summary" id="qcSummary">
    {isRu ? '— введите quartz cron-выражение' : '— enter a Quartz cron expression'}
  </div>

  <div class="qc-fields">
    <div class="qc-field">
      <div class="qc-fval" id="qcFvSec">0</div>
      <div class="qc-fname">{isRu ? 'секунды' : 'seconds'}</div>
      <div class="qc-fdesc" id="qcFdSec"></div>
    </div>
    <div class="qc-field">
      <div class="qc-fval" id="qcFvMin">0</div>
      <div class="qc-fname">{isRu ? 'минуты' : 'minutes'}</div>
      <div class="qc-fdesc" id="qcFdMin"></div>
    </div>
    <div class="qc-field">
      <div class="qc-fval" id="qcFvHour">12</div>
      <div class="qc-fname">{isRu ? 'часы' : 'hours'}</div>
      <div class="qc-fdesc" id="qcFdHour"></div>
    </div>
    <div class="qc-field">
      <div class="qc-fval" id="qcFvDom">?</div>
      <div class="qc-fname">{isRu ? 'день' : 'day'}</div>
      <div class="qc-fdesc" id="qcFdDom"></div>
    </div>
    <div class="qc-field">
      <div class="qc-fval" id="qcFvMonth">*</div>
      <div class="qc-fname">{isRu ? 'месяц' : 'month'}</div>
      <div class="qc-fdesc" id="qcFdMonth"></div>
    </div>
    <div class="qc-field">
      <div class="qc-fval" id="qcFvDow">MON-FRI</div>
      <div class="qc-fname">{isRu ? 'день нед.' : 'weekday'}</div>
      <div class="qc-fdesc" id="qcFdDow"></div>
    </div>
    <div class="qc-field">
      <div class="qc-fval" id="qcFvYear">*</div>
      <div class="qc-fname">{isRu ? 'год' : 'year'}</div>
      <div class="qc-fdesc" id="qcFdYear"></div>
    </div>
  </div>

  <div class="qc-runs-head">{isRu ? '// следующие 8 запусков' : '// next 8 runs'}</div>
  <div class="qc-runs" id="qcRuns">
    <span class="qc-no-runs">
      {isRu ? '— сначала введите выражение' : '— parse a valid expression first'}
    </span>
  </div>

  <div class="qc-presets-section">
    <div class="qc-presets-head">{isRu ? '// типовые расписания' : '// common schedules'}</div>
    <div class="qc-presets-grid" id="qcPresetsGrid"></div>
  </div>
</div>

<script is:inline define:vars={{ isRuLang: isRu }}>
  (function () {
    /* ── Constants ──────────────────────────────────────── */

    // Quartz DOW: 1=SUN 2=MON 3=TUE 4=WED 5=THU 6=FRI 7=SAT
    var Q_DOW = { SUN: 1, MON: 2, TUE: 3, WED: 4, THU: 5, FRI: 6, SAT: 7 };
    var Q_MON = {
      JAN: 1,
      FEB: 2,
      MAR: 3,
      APR: 4,
      MAY: 5,
      JUN: 6,
      JUL: 7,
      AUG: 8,
      SEP: 9,
      OCT: 10,
      NOV: 11,
      DEC: 12,
    };

    var DOW_S = ['', 'Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    var DOW_L = ['', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    var MON_S = [
      '',
      'Jan',
      'Feb',
      'Mar',
      'Apr',
      'May',
      'Jun',
      'Jul',
      'Aug',
      'Sep',
      'Oct',
      'Nov',
      'Dec',
    ];
    var MON_L = [
      '',
      'January',
      'February',
      'March',
      'April',
      'May',
      'June',
      'July',
      'August',
      'September',
      'October',
      'November',
      'December',
    ];

    var DOW_S_RU = ['', 'вс', 'пн', 'вт', 'ср', 'чт', 'пт', 'сб'];
    var DOW_L_RU = [
      '',
      'воскресенье',
      'понедельник',
      'вторник',
      'среда',
      'четверг',
      'пятница',
      'суббота',
    ];
    var MON_S_RU = [
      '',
      'янв',
      'фев',
      'мар',
      'апр',
      'май',
      'июн',
      'июл',
      'авг',
      'сен',
      'окт',
      'ноя',
      'дек',
    ];
    var MON_L_RU = [
      '',
      'января',
      'февраля',
      'марта',
      'апреля',
      'мая',
      'июня',
      'июля',
      'августа',
      'сентября',
      'октября',
      'ноября',
      'декабря',
    ];

    var PRESETS = [
      { lbl: 'every minute', expr: '0 * * * * ?' },
      { lbl: 'every hour', expr: '0 0 * * * ?' },
      { lbl: 'daily at midnight', expr: '0 0 0 * * ?' },
      { lbl: 'daily at noon', expr: '0 0 12 * * ?' },
      { lbl: 'every 5 minutes', expr: '0 */5 * * * ?' },
      { lbl: 'every 15 minutes', expr: '0 */15 * * * ?' },
      { lbl: 'weekdays at 9 AM', expr: '0 0 9 ? * MON-FRI' },
      { lbl: 'last day of month', expr: '0 0 0 L * ?' },
      { lbl: '1st Monday of month', expr: '0 0 0 ? * MON#1' },
      { lbl: 'every Mon at midnight', expr: '0 0 0 ? * MON' },
    ];

    var PRESETS_RU = [
      { lbl: 'каждую минуту', expr: '0 * * * * ?' },
      { lbl: 'каждый час', expr: '0 0 * * * ?' },
      { lbl: 'ежедневно в полночь', expr: '0 0 0 * * ?' },
      { lbl: 'ежедневно в полдень', expr: '0 0 12 * * ?' },
      { lbl: 'каждые 5 минут', expr: '0 */5 * * * ?' },
      { lbl: 'каждые 15 минут', expr: '0 */15 * * * ?' },
      { lbl: 'будни в 9:00', expr: '0 0 9 ? * MON-FRI' },
      { lbl: 'последний день месяца', expr: '0 0 0 L * ?' },
      { lbl: '1-й понедельник месяца', expr: '0 0 0 ? * MON#1' },
      { lbl: 'каждый пн в полночь', expr: '0 0 0 ? * MON' },
    ];

    var ACTIVE_PRESETS = isRuLang ? PRESETS_RU : PRESETS;

    /* ── Helpers ──────────────────────────────────────── */

    function pad2(n) {
      return String(n).padStart(2, '0');
    }

    function ordinal(n) {
      var s = n % 100;
      if (s >= 11 && s <= 13) return n + 'th';
      switch (n % 10) {
        case 1:
          return n + 'st';
        case 2:
          return n + 'nd';
        case 3:
          return n + 'rd';
      }
      return n + 'th';
    }

    function ru_pl(n, one, few, many) {
      var m10 = n % 10,
        m100 = n % 100;
      if (m100 >= 11 && m100 <= 19) return n + ' ' + many;
      if (m10 === 1) return n + ' ' + one;
      if (m10 >= 2 && m10 <= 4) return n + ' ' + few;
      return n + ' ' + many;
    }

    function fmtHour(h) {
      if (h === 0) return '12 AM';
      if (h === 12) return '12 PM';
      return (h < 12 ? h : h - 12) + (h < 12 ? ' AM' : ' PM');
    }
    function fmtTime(h, m, s) {
      var base = (h % 12 || 12) + ':' + pad2(m) + (h < 12 ? ' AM' : ' PM');
      return s ? base.replace(/ (AM|PM)/, ':' + pad2(s) + ' $1') : base;
    }
    function fmtTimeRu(h, m, s) {
      return pad2(h) + ':' + pad2(m) + (s ? ':' + pad2(s) : '');
    }

    /* ── Quartz field parser ────────────────────────── */

    function resolveAlias(s, aliases) {
      var up = s.toUpperCase();
      if (up in aliases) return aliases[up];
      var n = parseInt(s, 10);
      if (isNaN(n)) throw new Error('invalid value "' + s + '"');
      return n;
    }

    function isSpecial(f) {
      return /[LW#]/.test(f);
    }

    function expand(field, lo, hi, aliases) {
      if (field === '*' || field === '?') return null;
      if (isSpecial(field)) return null;
      var result = [],
        seen = {};
      var segs = field.split(',');
      for (var si = 0; si < segs.length; si++) {
        var seg = segs[si];
        var slash = seg.indexOf('/');
        var rangePart = slash >= 0 ? seg.slice(0, slash) : seg;
        var step = slash >= 0 ? parseInt(seg.slice(slash + 1), 10) : 1;
        if (!step || step < 1) throw new Error('step must be ≥ 1');
        var a, b;
        if (rangePart === '*') {
          a = lo;
          b = hi;
        } else {
          var dash = rangePart.indexOf('-');
          if (dash > 0) {
            a = resolveAlias(rangePart.slice(0, dash), aliases);
            b = resolveAlias(rangePart.slice(dash + 1), aliases);
          } else {
            a = b = resolveAlias(rangePart, aliases);
          }
        }
        for (var v = a; v <= b; v += step) {
          if (!seen[v]) {
            seen[v] = true;
            result.push(v);
          }
        }
      }
      result.sort(function (a, b) {
        return a - b;
      });
      return result;
    }

    function validate(field, lo, hi, aliases, name) {
      if (field === '*' || field === '?') return;
      if (isSpecial(field)) return; // validated structurally in parse
      var vals = expand(field, lo, hi, aliases);
      if (!vals) return;
      for (var i = 0; i < vals.length; i++) {
        if (vals[i] < lo || vals[i] > hi)
          throw new Error(name + ' value ' + vals[i] + ' out of range ' + lo + '–' + hi);
      }
    }

    /* ── Parse cron ─────────────────────────────────── */

    function parseQuartz(expr) {
      var parts = expr.trim().split(/\s+/);
      if (parts.length < 6 || parts.length > 7)
        throw new Error('expected 6 or 7 fields: sec min hour dom month dow [year]');
      var f = {
        sec: parts[0],
        min: parts[1],
        hour: parts[2],
        dom: parts[3],
        month: parts[4],
        dow: parts[5],
        year: parts[6] || '*',
      };

      // ? only valid in dom and dow, and only one of them
      if (f.dom === '?' && f.dow === '?') throw new Error('dom and dow cannot both be ?');
      if (f.dom !== '?' && f.dow !== '?' && f.dom !== '*' && f.dow !== '*') {
        throw new Error(
          'only one of day-of-month or day-of-week may be specified (use ? for the other)'
        );
      }

      validate(f.sec, 0, 59, {}, 'second');
      validate(f.min, 0, 59, {}, 'minute');
      validate(f.hour, 0, 23, {}, 'hour');
      validate(f.dom, 1, 31, {}, 'day-of-month');
      validate(f.month, 1, 12, Q_MON, 'month');
      validate(f.dow, 1, 7, Q_DOW, 'day-of-week');
      return f;
    }

    /* ── Field descriptions (EN) ────────────────────── */

    function descSec(f) {
      if (f === '*') return 'every second';
      var m = f.match(/^\*\/(\d+)$/);
      if (m) return 'every ' + m[1] + 's';
      var vals = expand(f, 0, 59, {});
      if (!vals) return f;
      if (vals.length === 1) return 'at :' + pad2(vals[0]);
      if (vals.length <= 4)
        return vals
          .map(function (v) {
            return ':' + pad2(v);
          })
          .join(', ');
      return vals.length + '× /min';
    }

    function descMin(f) {
      if (f === '*') return 'every minute';
      var m = f.match(/^\*\/(\d+)$/);
      if (m) return 'every ' + m[1] + ' min';
      var vals = expand(f, 0, 59, {});
      if (!vals) return f;
      if (vals.length === 1) return 'at :' + pad2(vals[0]);
      if (vals.length <= 4) return ':' + vals.map(pad2).join(', :');
      return vals.length + '× per hour';
    }

    function descHour(f) {
      if (f === '*') return 'every hour';
      var m = f.match(/^\*\/(\d+)$/);
      if (m) return 'every ' + m[1] + 'h';
      var rm = f.match(/^(\d+)-(\d+)$/);
      if (rm) return fmtHour(+rm[1]) + ' – ' + fmtHour(+rm[2]);
      var vals = expand(f, 0, 23, {});
      if (!vals) return f;
      if (vals.length === 1) return fmtHour(vals[0]);
      if (vals.length <= 3) return vals.map(fmtHour).join(', ');
      return vals.length + '× per day';
    }

    function descDom(f) {
      if (f === '?') return 'see weekday';
      if (f === '*') return 'every day';
      if (f === 'L') return 'last day';
      if (f === 'LW') return 'last weekday';
      var lw = f.match(/^(\d+)W$/);
      if (lw) return 'nearest weekday to ' + ordinal(+lw[1]);
      var vals = expand(f, 1, 31, {});
      if (!vals) return f;
      if (vals.length === 1) return ordinal(vals[0]);
      if (vals.length <= 4) return vals.map(ordinal).join(', ');
      return vals.length + ' dates';
    }

    function descMonth(f) {
      if (f === '*') return 'any month';
      var vals = expand(f, 1, 12, Q_MON);
      if (!vals) return f;
      if (vals.length === 1) return MON_L[vals[0]];
      if (vals.length <= 4)
        return vals
          .map(function (v) {
            return MON_S[v];
          })
          .join(', ');
      return vals.length + ' months';
    }

    function resolveDowNum(s) {
      var up = s.toUpperCase();
      if (up in Q_DOW) return Q_DOW[up];
      var n = parseInt(s, 10);
      return isNaN(n) ? null : n;
    }

    function descDow(f) {
      if (f === '?') return 'see day-of-month';
      if (f === '*') return 'any day';
      var hashM = f.match(/^(\w+)#(\d+)$/);
      if (hashM) {
        var dn = resolveDowNum(hashM[1]);
        return dn ? ordinal(+hashM[2]) + ' ' + DOW_L[dn] : f;
      }
      var lastM = f.match(/^(\w+)L$/);
      if (lastM) {
        var ln = resolveDowNum(lastM[1]);
        return ln ? 'last ' + DOW_L[ln] : f;
      }
      if (f === '2-6') return 'Mon – Fri';
      var vals = expand(f, 1, 7, Q_DOW);
      if (!vals) return f;
      if (vals.length === 1) return DOW_L[vals[0]];
      var isRange = vals.length > 1 && vals[vals.length - 1] - vals[0] === vals.length - 1;
      if (isRange) return DOW_S[vals[0]] + ' – ' + DOW_S[vals[vals.length - 1]];
      if (vals.length <= 4)
        return vals
          .map(function (v) {
            return DOW_S[v];
          })
          .join(', ');
      return vals.length + ' days/week';
    }

    function descYear(f) {
      if (!f || f === '*') return 'any year';
      return f;
    }

    /* ── Field descriptions (RU) ────────────────────── */

    function descSecRu(f) {
      if (f === '*') return 'каждую секунду';
      var m = f.match(/^\*\/(\d+)$/);
      if (m) return 'каждые ' + ru_pl(+m[1], 'сек.', 'сек.', 'сек.');
      var vals = expand(f, 0, 59, {});
      if (!vals) return f;
      if (vals.length === 1) return 'в :' + pad2(vals[0]);
      return vals.length + '× в мин.';
    }

    function descMinRu(f) {
      if (f === '*') return 'каждую минуту';
      var m = f.match(/^\*\/(\d+)$/);
      if (m) return 'каждые ' + ru_pl(+m[1], 'минуту', 'минуты', 'минут');
      var vals = expand(f, 0, 59, {});
      if (!vals) return f;
      if (vals.length === 1) return 'в :' + pad2(vals[0]);
      return vals.length + '× в час';
    }

    function descHourRu(f) {
      if (f === '*') return 'каждый час';
      var m = f.match(/^\*\/(\d+)$/);
      if (m) return 'каждые ' + ru_pl(+m[1], 'час', 'часа', 'часов');
      var rm = f.match(/^(\d+)-(\d+)$/);
      if (rm) return pad2(+rm[1]) + ':00 – ' + pad2(+rm[2]) + ':00';
      var vals = expand(f, 0, 23, {});
      if (!vals) return f;
      if (vals.length === 1) return 'в ' + pad2(vals[0]) + ':00';
      if (vals.length <= 3)
        return vals
          .map(function (v) {
            return pad2(v) + ':00';
          })
          .join(', ');
      return vals.length + '× в день';
    }

    function descDomRu(f) {
      if (f === '?') return 'см. день нед.';
      if (f === '*') return 'каждый день';
      if (f === 'L') return 'последний день';
      if (f === 'LW') return 'последний будний';
      var lw = f.match(/^(\d+)W$/);
      if (lw) return 'ближ. будний к ' + lw[1] + '-му';
      var vals = expand(f, 1, 31, {});
      if (!vals) return f;
      if (vals.length === 1) return vals[0] + '-го';
      if (vals.length <= 4)
        return vals
          .map(function (v) {
            return v + '-го';
          })
          .join(', ');
      return vals.length + ' дат';
    }

    function descMonthRu(f) {
      if (f === '*') return 'любой месяц';
      var vals = expand(f, 1, 12, Q_MON);
      if (!vals) return f;
      if (vals.length === 1) return MON_L_RU[vals[0]];
      if (vals.length <= 4)
        return vals
          .map(function (v) {
            return MON_S_RU[v];
          })
          .join(', ');
      return vals.length + ' месяцев';
    }

    function descDowRu(f) {
      if (f === '?') return 'см. дату';
      if (f === '*') return 'любой день';
      var hashM = f.match(/^(\w+)#(\d+)$/);
      if (hashM) {
        var dn = resolveDowNum(hashM[1]);
        return dn ? +hashM[2] + '-й ' + DOW_L_RU[dn] : f;
      }
      var lastM = f.match(/^(\w+)L$/);
      if (lastM) {
        var ln = resolveDowNum(lastM[1]);
        return ln ? 'посл. ' + DOW_S_RU[ln] : f;
      }
      if (f === '2-6') return 'пн – пт';
      var vals = expand(f, 1, 7, Q_DOW);
      if (!vals) return f;
      if (vals.length === 1) return DOW_L_RU[vals[0]];
      var isRange = vals.length > 1 && vals[vals.length - 1] - vals[0] === vals.length - 1;
      if (isRange) return DOW_S_RU[vals[0]] + ' – ' + DOW_S_RU[vals[vals.length - 1]];
      if (vals.length <= 4)
        return vals
          .map(function (v) {
            return DOW_S_RU[v];
          })
          .join(', ');
      return vals.length + ' дн./нед.';
    }

    /* ── Summary sentence ───────────────────────────── */

    function summarize(f) {
      var parts = [];

      // Time
      var secV = f.sec === '*' ? null : expand(f.sec, 0, 59, {});
      var minV = f.min === '*' ? null : expand(f.min, 0, 59, {});
      var hrV = f.hour === '*' ? null : expand(f.hour, 0, 23, {});
      var secStep = f.sec.match(/^\*\/(\d+)$/);
      var minStep = f.min.match(/^\*\/(\d+)$/);

      if (f.sec === '*' && f.min === '*' && f.hour === '*') {
        parts.push('every second');
      } else if (f.sec === '0' && f.min === '0' && f.hour === '0') {
        parts.push('at midnight');
      } else if (f.sec === '0' && f.min === '0' && f.hour === '12') {
        parts.push('at noon');
      } else if (f.sec === '0' && f.min === '0' && hrV && hrV.length === 1) {
        parts.push('at ' + fmtHour(hrV[0]));
      } else if (f.sec === '0' && f.min === '0' && f.hour === '*') {
        parts.push('every hour on the :00');
      } else if (f.sec === '0' && minStep) {
        parts.push('every ' + minStep[1] + ' minute' + (+minStep[1] === 1 ? '' : 's'));
      } else if (f.sec === '0' && f.min === '0') {
        parts.push('at ' + descHour(f.hour));
      } else if (f.sec === '0' && minV && minV.length === 1 && hrV && hrV.length === 1) {
        parts.push('at ' + fmtTime(hrV[0], minV[0]));
      } else if (secStep) {
        parts.push('every ' + secStep[1] + ' seconds');
      } else {
        parts.push(descSec(f.sec) + ' of ' + descMin(f.min) + ' past ' + descHour(f.hour));
      }

      // Day
      if (f.dom !== '*' && f.dom !== '?') {
        parts.push('on ' + descDom(f.dom));
      }
      if (f.dow !== '*' && f.dow !== '?') {
        var dowD = descDow(f.dow);
        parts.push(dowD === 'Mon – Fri' ? 'Monday to Friday' : 'on ' + dowD);
      }
      if (f.month !== '*') parts.push('in ' + descMonth(f.month));
      if (f.year && f.year !== '*') parts.push('in ' + f.year);

      return parts.join(', ');
    }

    function summarizeRu(f) {
      var parts = [];

      var minV = f.min === '*' ? null : expand(f.min, 0, 59, {});
      var hrV = f.hour === '*' ? null : expand(f.hour, 0, 23, {});
      var secStep = f.sec.match(/^\*\/(\d+)$/);
      var minStep = f.min.match(/^\*\/(\d+)$/);

      if (f.sec === '*' && f.min === '*' && f.hour === '*') {
        parts.push('каждую секунду');
      } else if (f.sec === '0' && f.min === '0' && f.hour === '0') {
        parts.push('в полночь');
      } else if (f.sec === '0' && f.min === '0' && f.hour === '12') {
        parts.push('в полдень');
      } else if (f.sec === '0' && f.min === '0' && hrV && hrV.length === 1) {
        parts.push('в ' + pad2(hrV[0]) + ':00');
      } else if (f.sec === '0' && f.min === '0' && f.hour === '*') {
        parts.push('каждый час в :00');
      } else if (f.sec === '0' && minStep) {
        parts.push('каждые ' + ru_pl(+minStep[1], 'минуту', 'минуты', 'минут'));
      } else if (f.sec === '0' && f.min === '0') {
        parts.push('в ' + descHourRu(f.hour));
      } else if (f.sec === '0' && minV && minV.length === 1 && hrV && hrV.length === 1) {
        parts.push('в ' + fmtTimeRu(hrV[0], minV[0]));
      } else if (secStep) {
        parts.push('каждые ' + ru_pl(+secStep[1], 'секунду', 'секунды', 'секунд'));
      } else {
        parts.push(descSecRu(f.sec) + ' ' + descMinRu(f.min) + ' ' + descHourRu(f.hour));
      }

      if (f.dom !== '*' && f.dom !== '?') parts.push(descDomRu(f.dom));
      if (f.dow !== '*' && f.dow !== '?') {
        var dowD = descDowRu(f.dow);
        parts.push(dowD === 'пн – пт' ? 'в будни' : dowD);
      }
      if (f.month !== '*') parts.push('в ' + descMonthRu(f.month));
      if (f.year && f.year !== '*') parts.push('в ' + f.year);

      return parts.join(', ');
    }

    /* ── Next runs ──────────────────────────────────── */

    function hasSpecials(f) {
      return isSpecial(f.dom) || isSpecial(f.dow);
    }

    function getNextRuns(f, count) {
      if (hasSpecials(f)) return null; // complex expressions not computed

      var secV = f.sec === '*' ? null : expand(f.sec, 0, 59, {});
      var minV = f.min === '*' ? null : expand(f.min, 0, 59, {});
      var hrV = f.hour === '*' ? null : expand(f.hour, 0, 23, {});
      var domV = f.dom === '*' || f.dom === '?' ? null : expand(f.dom, 1, 31, {});
      var monV = f.month === '*' ? null : expand(f.month, 1, 12, Q_MON);
      var rawDow = f.dow === '*' || f.dow === '?' ? null : f.dow;
      var dowArr = rawDow ? expand(rawDow, 1, 7, Q_DOW) : null;
      var dowSet = null;
      if (dowArr) {
        dowSet = {};
        // Quartz DOW 1=Sun...7=Sat → JS getDay() 0=Sun...6=Sat
        for (var i = 0; i < dowArr.length; i++) {
          dowSet[(dowArr[i] - 1) % 7] = true;
        }
      }

      var now = new Date();
      var d = new Date(now);
      d.setMilliseconds(0);
      d.setSeconds(d.getSeconds() + 1);

      var runs = [];
      var limit = new Date(now.getTime() + 366 * 24 * 60 * 60 * 1000);

      var firstSec = secV ? secV[0] : 0;

      while (runs.length < count && d < limit) {
        var s = d.getSeconds(),
          mn = d.getMinutes(),
          hr = d.getHours(),
          dt = d.getDate(),
          mo = d.getMonth() + 1,
          dw = d.getDay();

        if (
          (!secV || secV.indexOf(s) >= 0) &&
          (!minV || minV.indexOf(mn) >= 0) &&
          (!hrV || hrV.indexOf(hr) >= 0) &&
          (!domV || domV.indexOf(dt) >= 0) &&
          (!monV || monV.indexOf(mo) >= 0) &&
          (!dowSet || dowSet[dw])
        ) {
          runs.push(new Date(d));
        }
        d.setSeconds(d.getSeconds() + 1);
      }
      return runs;
    }

    function fmtRun(d) {
      var days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      var mons = [
        'Jan',
        'Feb',
        'Mar',
        'Apr',
        'May',
        'Jun',
        'Jul',
        'Aug',
        'Sep',
        'Oct',
        'Nov',
        'Dec',
      ];
      var hasSeconds = d.getSeconds() !== 0;
      return (
        days[d.getDay()] +
        ' ' +
        mons[d.getMonth()] +
        ' ' +
        d.getDate() +
        ' · ' +
        pad2(d.getHours()) +
        ':' +
        pad2(d.getMinutes()) +
        (hasSeconds ? ':' + pad2(d.getSeconds()) : '')
      );
    }

    function fmtRunRu(d) {
      var days = ['вс', 'пн', 'вт', 'ср', 'чт', 'пт', 'сб'];
      var mons = [
        'янв',
        'фев',
        'мар',
        'апр',
        'май',
        'июн',
        'июл',
        'авг',
        'сен',
        'окт',
        'ноя',
        'дек',
      ];
      var hasSeconds = d.getSeconds() !== 0;
      return (
        days[d.getDay()] +
        ' ' +
        mons[d.getMonth()] +
        ' ' +
        d.getDate() +
        ' · ' +
        pad2(d.getHours()) +
        ':' +
        pad2(d.getMinutes()) +
        (hasSeconds ? ':' + pad2(d.getSeconds()) : '')
      );
    }

    /* ── DOM refs ───────────────────────────────────── */

    var exprEl = document.getElementById('qcExpr');
    var summaryEl = document.getElementById('qcSummary');
    var fvSec = document.getElementById('qcFvSec');
    var fvMin = document.getElementById('qcFvMin');
    var fvHour = document.getElementById('qcFvHour');
    var fvDom = document.getElementById('qcFvDom');
    var fvMonth = document.getElementById('qcFvMonth');
    var fvDow = document.getElementById('qcFvDow');
    var fvYear = document.getElementById('qcFvYear');
    var fdSec = document.getElementById('qcFdSec');
    var fdMin = document.getElementById('qcFdMin');
    var fdHour = document.getElementById('qcFdHour');
    var fdDom = document.getElementById('qcFdDom');
    var fdMonth = document.getElementById('qcFdMonth');
    var fdDow = document.getElementById('qcFdDow');
    var fdYear = document.getElementById('qcFdYear');
    var runsEl = document.getElementById('qcRuns');

    var EMPTY_MSG = isRuLang
      ? '— введите quartz cron-выражение'
      : '— enter a Quartz cron expression';
    var NO_RUNS_MSG = isRuLang ? '— сначала введите выражение' : '— parse a valid expression first';
    var COMPLEX_MSG = isRuLang
      ? 'сложное выражение (L/W/#)'
      : 'complex expression (L/W/# not simulated)';
    var ERR_FIX_MSG = isRuLang ? '— исправьте выражение выше' : '— fix the expression above';

    /* ── Render ─────────────────────────────────────── */

    function render() {
      var raw = exprEl.value.trim();
      if (!raw) {
        summaryEl.textContent = EMPTY_MSG;
        summaryEl.className = 'qc-summary';
        runsEl.innerHTML = '<span class="qc-no-runs">' + NO_RUNS_MSG + '</span>';
        return;
      }

      try {
        var f = parseQuartz(raw);
        exprEl.classList.remove('qc-err');

        summaryEl.textContent = isRuLang ? summarizeRu(f) : summarize(f);
        summaryEl.className = 'qc-summary ok';
        if (window.pushHistory) window.pushHistory('quartz cron', summaryEl.textContent, raw);
        summaryEl.classList.remove('flash-ok');
        void summaryEl.offsetWidth;
        summaryEl.classList.add('flash-ok');

        fvSec.textContent = f.sec;
        fdSec.textContent = isRuLang ? descSecRu(f.sec) : descSec(f.sec);
        fvMin.textContent = f.min;
        fdMin.textContent = isRuLang ? descMinRu(f.min) : descMin(f.min);
        fvHour.textContent = f.hour;
        fdHour.textContent = isRuLang ? descHourRu(f.hour) : descHour(f.hour);
        fvDom.textContent = f.dom;
        fdDom.textContent = isRuLang ? descDomRu(f.dom) : descDom(f.dom);
        fvMonth.textContent = f.month;
        fdMonth.textContent = isRuLang ? descMonthRu(f.month) : descMonth(f.month);
        fvDow.textContent = f.dow;
        fdDow.textContent = isRuLang ? descDowRu(f.dow) : descDow(f.dow);
        fvYear.textContent = f.year;
        fdYear.textContent = descYear(f.year);

        var runs = getNextRuns(f, 8);
        if (!runs) {
          runsEl.innerHTML = '<span class="qc-no-runs">' + COMPLEX_MSG + '</span>';
        } else if (runs.length === 0) {
          runsEl.innerHTML =
            '<span class="qc-no-runs">' +
            (isRuLang ? 'нет запусков в ближайший год' : 'no occurrences in the next year') +
            '</span>';
        } else {
          runsEl.innerHTML = runs
            .map(function (d, i) {
              return (
                '<span class="qc-run"><span class="qc-run-n">' +
                (i + 1) +
                '</span>' +
                (isRuLang ? fmtRunRu(d) : fmtRun(d)) +
                '</span>'
              );
            })
            .join('');
        }
      } catch (e) {
        exprEl.classList.add('qc-err');
        summaryEl.textContent = '// ' + e.message;
        summaryEl.className = 'qc-summary err';
        runsEl.innerHTML = '<span class="qc-no-runs">' + ERR_FIX_MSG + '</span>';
      }
    }

    /* ── Presets ──────────────────────────────────── */

    var menuEl = document.getElementById('qcPresetsMenu');
    menuEl.innerHTML = ACTIVE_PRESETS.map(function (p) {
      return (
        '<div class="qc-preset" data-expr="' +
        p.expr +
        '">' +
        '<span class="qc-preset-lbl">' +
        p.lbl +
        '</span>' +
        '<span class="qc-preset-expr">' +
        p.expr +
        '</span></div>'
      );
    }).join('');

    document.getElementById('qcPresetsBtn').addEventListener('click', function (e) {
      e.stopPropagation();
      menuEl.style.display = menuEl.style.display === 'none' ? 'block' : 'none';
    });
    menuEl.addEventListener('click', function (e) {
      var item = e.target.closest('.qc-preset');
      if (!item) return;
      exprEl.value = item.dataset.expr;
      menuEl.style.display = 'none';
      render();
    });
    document.addEventListener('click', function () {
      menuEl.style.display = 'none';
    });

    var gridEl = document.getElementById('qcPresetsGrid');
    gridEl.innerHTML = ACTIVE_PRESETS.map(function (p) {
      return (
        '<div class="qc-preset-card" data-expr="' +
        p.expr +
        '">' +
        '<span class="qc-preset-lbl">' +
        p.lbl +
        '</span>' +
        '<span class="qc-preset-expr">' +
        p.expr +
        '</span></div>'
      );
    }).join('');
    gridEl.addEventListener('click', function (e) {
      var item = e.target.closest('.qc-preset-card');
      if (!item) return;
      exprEl.value = item.dataset.expr;
      render();
      exprEl.focus();
      exprEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    /* ── Events ─────────────────────────────────────── */

    exprEl.addEventListener('input', render);

    document.addEventListener('keydown', function (e) {
      var toolEl = document.querySelector('.qc');
      if (!toolEl || !toolEl.contains(document.activeElement)) return;
      var pal = document.getElementById('whPalette');
      if (pal && pal.classList.contains('active')) return;
      var mod = e.ctrlKey || e.metaKey;
      if (mod && !e.shiftKey && e.key === 'Enter') {
        e.preventDefault();
        render();
        exprEl.focus();
      }
      if (mod && e.shiftKey && e.key.toLowerCase() === 'c') {
        e.preventDefault();
        var firstRun = runsEl.querySelector('.qc-run');
        if (firstRun)
          navigator.clipboard.writeText(firstRun.textContent.replace(/^\d+/, '').trim());
      }
      if (e.key === 'Escape' && !mod && !e.shiftKey && !e.altKey) {
        exprEl.value = '';
        render();
        exprEl.focus();
      }
    });

    window.toolGetPreset = function () {
      return { expr: exprEl.value };
    };
    window.toolSetPreset = function (cfg) {
      exprEl.value = cfg.expr ?? '';
      exprEl.dispatchEvent(new Event('input', { bubbles: true }));
    };

    render();
  })();
</script>
