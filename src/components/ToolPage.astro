---
import Base from '../layouts/Base.astro';
import { CAT_META, toolSlug, type Tool } from '../data/catalog';
import { toolNameRu, toolDescRu, catLabelRu } from '../data/ru';
import { TOOL_UI, PRO_HINTS, type Lang } from '../data/i18n';
import { API_SNIPPETS } from '../data/apiSnippets';
import JsonFormatter from './tools/JsonFormatter.astro';
import Base64 from './tools/Base64.astro';
import UuidGenerator from './tools/UuidGenerator.astro';
import RegexTester from './tools/RegexTester.astro';
import JwtDecoder from './tools/JwtDecoder.astro';
import CronParser from './tools/CronParser.astro';
import TimestampConverter from './tools/TimestampConverter.astro';
import UrlEncoder from './tools/UrlEncoder.astro';
import HashGenerator from './tools/HashGenerator.astro';
import SlugGenerator from './tools/SlugGenerator.astro';
import PasswordGenerator from './tools/PasswordGenerator.astro';
import BcryptTool from './tools/BcryptTool.astro';
import TextDiff from './tools/TextDiff.astro';
import CaseNormalizer from './tools/CaseNormalizer.astro';
import CurlConverter from './tools/CurlConverter.astro';
import QueryStringParser from './tools/QueryStringParser.astro';
import XmlJsonConverter from './tools/XmlJsonConverter.astro';
import HtmlEntityEncoder from './tools/HtmlEntityEncoder.astro';
import MimeLookup from './tools/MimeLookup.astro';
import NumberBaseConverter from './tools/NumberBaseConverter.astro';
import StringInspector from './tools/StringInspector.astro';
import CsvJsonConverter from './tools/CsvJsonConverter.astro';

interface Props {
  lang: Lang;
  tool: Tool;
}

const { lang, tool } = Astro.props;
const isRu    = lang === 'ru';
const catMeta = CAT_META[tool.cat];
const slug    = toolSlug(tool);
const ui      = TOOL_UI[lang];

const name      = isRu ? (toolNameRu[tool.name] || tool.name) : tool.name;
const desc      = isRu ? (toolDescRu[tool.name] || tool.desc) : tool.desc;
const catLabel  = isRu ? (catLabelRu[tool.cat]  || catMeta.label) : catMeta.label;
const toolsPath = isRu ? '/ru/tools/' : '/tools/';

const hints = PRO_HINTS[lang][slug] ?? [];
const snip  = API_SNIPPETS[slug] ?? null;
---
<style is:global>
  .tool-page { padding: 48px 0 64px; }

  .tool-page-header { margin-bottom: 40px; max-width: 640px; }

  .tool-breadcrumb {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--ink-faint);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tool-breadcrumb a { color: var(--ink-faint); text-decoration: none; transition: color 0.12s; }
  .tool-breadcrumb a:hover { color: var(--ink); }
  .tool-breadcrumb .sep { color: var(--line-strong); }

  .tool-page-header h1 { margin: 0 0 10px; }

  .tool-meta { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }

  .tool-cat-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    color: var(--ink-faint);
    background: var(--surface);
    border: 0.5px solid var(--line);
    padding: 3px 8px;
    border-radius: 999px;
  }

  .tool-new-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 2px 7px;
    border-radius: 3px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .tool-area {
    background: var(--surface);
    border: 0.5px solid var(--line);
    border-radius: var(--radius-lg);
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 12px;
    color: var(--ink-faint);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
  }
  .tool-area i { font-size: 32px; color: var(--line-strong); }

  /* ── API panel ── */
  .tool-api {
    margin-top: 10px;
    border: 0.5px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface);
  }

  .tool-api-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--ink-soft);
    background: var(--surface-sunken);
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background 0.12s;
  }
  .tool-api-toggle:hover { background: var(--accent-soft); }

  .tool-api-pro {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 0.5px solid var(--accent);
    border-radius: 3px;
    padding: 1px 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .tool-api-chevron {
    margin-left: auto;
    font-size: 13px;
    color: var(--ink-faint);
    transition: transform 0.18s;
  }
  .tool-api.open .tool-api-chevron { transform: rotate(180deg); }

  .tool-api-body {
    display: none;
    border-top: 0.5px solid var(--line);
  }
  .tool-api.open .tool-api-body { display: block; }

  .tool-api-tabs {
    display: flex;
    gap: 0;
    border-bottom: 0.5px solid var(--line);
    background: var(--surface-sunken);
  }

  .tool-api-tab {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 7px 14px;
    border: none;
    background: none;
    color: var(--ink-faint);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 0.12s;
    margin-bottom: -0.5px;
  }
  .tool-api-tab:hover { color: var(--ink); }
  .tool-api-tab.active { color: var(--accent); border-bottom-color: var(--accent); }

  .tool-api-snip {
    display: none;
    padding: 14px 18px;
    margin: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    line-height: 1.7;
    color: var(--ink);
    background: var(--surface);
    overflow-x: auto;
    white-space: pre;
  }
  .tool-api-snip.active { display: block; }

  .tool-api-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 14px;
    border-top: 0.5px solid var(--line);
    background: var(--surface-sunken);
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    color: var(--ink-faint);
    gap: 10px;
  }
  .tool-api-footer a { color: var(--accent); text-decoration: none; }
  .tool-api-footer a:hover { text-decoration: underline; }

  .tool-api-copy {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    padding: 3px 10px;
    border-radius: 4px;
    border: 0.5px solid var(--line-strong);
    background: none;
    color: var(--ink-faint);
    cursor: pointer;
    transition: all 0.12s;
    flex-shrink: 0;
  }
  .tool-api-copy:hover { color: var(--accent); border-color: var(--accent); }

  /* ── Pro hint strip ── */
  .tool-pro-strip {
    margin-top: 6px;
    padding: 8px 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    border: 0.5px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
  }

  .tps-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    flex-shrink: 0;
    margin-right: 2px;
  }

  .tps-hint {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    color: var(--ink-faint);
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .tps-pro {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 0.5px solid var(--accent);
    border-radius: 3px;
    padding: 1px 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .tps-sep { color: var(--line-strong); font-size: 11px; }

  .tps-link {
    margin-left: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--accent);
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.12s;
  }
  .tps-link:hover { opacity: 0.7; }
</style>

<Base title={`${name} — whittly`} description={desc}>
  <div class="tool-page">
    <div class="tool-breadcrumb">
      <a href={toolsPath}>{ui.breadcrumbTools}</a>
      <span class="sep">/</span>
      <a href={`${toolsPath}?cat=${tool.cat}`}>{catLabel}</a>
      <span class="sep">/</span>
      <span>{name}</span>
    </div>

    <header class="tool-page-header">
      <div class="tool-meta">
        <span class="tool-cat-badge">// {catLabel}</span>
        {tool.new && <span class="tool-new-badge">new</span>}
      </div>
      <h1>
        <i class={`ti ${tool.icon}`} style="font-size: 0.75em; vertical-align: middle; margin-right: 12px; color: var(--ink-soft);"></i>
        {name}
      </h1>
      <p class="subhead">{desc}</p>
    </header>

    {slug === 'json-formatter'      ? <JsonFormatter lang={lang} />
    : slug === 'base64'             ? <Base64 lang={lang} />
    : slug === 'cron-parser'        ? <CronParser lang={lang} />
    : slug === 'uuid-generator'     ? <UuidGenerator lang={lang} />
    : slug === 'regex-tester'       ? <RegexTester lang={lang} />
    : slug === 'jwt-decoder'        ? <JwtDecoder lang={lang} />
    : slug === 'timestamp-converter'? <TimestampConverter lang={lang} />
    : slug === 'url-encoder'        ? <UrlEncoder lang={lang} />
    : slug === 'hash-generator'     ? <HashGenerator lang={lang} />
    : slug === 'slug-generator'     ? <SlugGenerator lang={lang} />
    : slug === 'password-generator' ? <PasswordGenerator lang={lang} />
    : slug === 'bcrypt'             ? <BcryptTool lang={lang} />
    : slug === 'text-diff'          ? <TextDiff lang={lang} />
    : slug === 'case-normalizer'    ? <CaseNormalizer lang={lang} />
    : slug === 'curl-converter'     ? <CurlConverter lang={lang} />
    : slug === 'query-string-parser'? <QueryStringParser lang={lang} />
    : slug === 'xml-json'           ? <XmlJsonConverter lang={lang} />
    : slug === 'html-entity-encoder'? <HtmlEntityEncoder lang={lang} />
    : slug === 'mime-lookup'              ? <MimeLookup lang={lang} />
    : slug === 'number-base-converter'   ? <NumberBaseConverter lang={lang} />
    : slug === 'string-inspector'        ? <StringInspector lang={lang} />
    : slug === 'csv-json'                ? <CsvJsonConverter lang={lang} />
    : (
      <div class="tool-area">
        <i class={`ti ${tool.icon}`}></i>
        <span>{ui.toolComingSoon}</span>
      </div>
    )}

    {snip && (
      <div class="tool-api" id="toolApiPanel">
        <button class="tool-api-toggle" id="toolApiToggle" type="button">
          <i class="ti ti-code"></i>
          {ui.apiToggleLabel}
          <span class="tool-api-pro">pro</span>
          <i class="ti ti-chevron-down tool-api-chevron"></i>
        </button>
        <div class="tool-api-body">
          <div class="tool-api-tabs">
            <button class="tool-api-tab active" data-tab="curl">curl</button>
            <button class="tool-api-tab"        data-tab="fetch">fetch</button>
            <button class="tool-api-tab"        data-tab="axios">axios</button>
          </div>
          <pre class="tool-api-snip active" id="taSnipCurl">{snip.curl}</pre>
          <pre class="tool-api-snip"        id="taSnipFetch">{snip.fetch}</pre>
          <pre class="tool-api-snip"        id="taSnipAxios">{snip.axios}</pre>
          <div class="tool-api-footer">
            <span>{isRu ? 'API доступен на' : 'API access on'} <a href={ui.proUpgradePath}>Pro</a></span>
            <button class="tool-api-copy" id="toolApiCopy">{isRu ? 'копировать' : 'copy'}</button>
          </div>
        </div>
      </div>
    )}

    {hints.length > 0 && (
      <div class="tool-pro-strip">
        <span class="tps-label">// pro</span>
        {hints.map((h, i) => (
          <>
            {i > 0 && <span class="tps-sep">·</span>}
            <span class="tps-hint">{h} <span class="tps-pro">pro</span></span>
          </>
        ))}
        <a href={ui.proUpgradePath} class="tps-link">{ui.proUpgradeLabel}</a>
      </div>
    )}
  </div>

  <script is:inline define:vars={{ copyLabel: isRu ? 'копировать' : 'copy', copiedLabel: isRu ? 'скопировано' : 'copied' }}>
  (function () {
    var panel     = document.getElementById('toolApiPanel');
    var toggle    = document.getElementById('toolApiToggle');
    var copyBtn   = document.getElementById('toolApiCopy');
    if (!toggle) return;

    var tabs  = document.querySelectorAll('.tool-api-tab');
    var snips = { curl: document.getElementById('taSnipCurl'), fetch: document.getElementById('taSnipFetch'), axios: document.getElementById('taSnipAxios') };
    var activeTab = 'curl';

    toggle.addEventListener('click', function () { panel.classList.toggle('open'); });

    tabs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        tabs.forEach(function (b) { b.classList.remove('active'); });
        Object.values(snips).forEach(function (s) { if (s) s.classList.remove('active'); });
        btn.classList.add('active');
        activeTab = btn.dataset.tab;
        if (snips[activeTab]) snips[activeTab].classList.add('active');
      });
    });

    copyBtn && copyBtn.addEventListener('click', function () {
      var el = snips[activeTab];
      if (!el) return;
      navigator.clipboard.writeText(el.textContent || '').then(function () {
        copyBtn.textContent = copiedLabel;
        setTimeout(function () { copyBtn.textContent = copyLabel; }, 1500);
      });
    });
  })();
  </script>
</Base>
