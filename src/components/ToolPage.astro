---
import Base from '../layouts/Base.astro';
import { CATALOG, CAT_META, toolSlug, type Tool } from '../data/catalog';
import { toolNameRu, toolDescRu, catLabelRu } from '../data/ru';
import { TOOL_UI, PRO_HINTS, type Lang } from '../data/i18n';
import { API_SNIPPETS } from '../data/apiSnippets';
import { SEO_TITLE, SEO_DESC, SEO_DESC_RU } from '../data/seo';
import { TOOL_CONTENT_EN, TOOL_CONTENT_RU } from '../data/toolContent';
import JsonFormatter from './tools/JsonFormatter.astro';
import Base64 from './tools/Base64.astro';
import UuidGenerator from './tools/UuidGenerator.astro';
import RegexTester from './tools/RegexTester.astro';
import JwtDecoder from './tools/JwtDecoder.astro';
import CronParser from './tools/CronParser.astro';
import TimestampConverter from './tools/TimestampConverter.astro';
import UrlEncoder from './tools/UrlEncoder.astro';
import HashGenerator from './tools/HashGenerator.astro';
import SlugGenerator from './tools/SlugGenerator.astro';
import PasswordGenerator from './tools/PasswordGenerator.astro';
import BcryptTool from './tools/BcryptTool.astro';
import TextDiff from './tools/TextDiff.astro';
import CaseNormalizer from './tools/CaseNormalizer.astro';
import CurlConverter from './tools/CurlConverter.astro';
import QueryStringParser from './tools/QueryStringParser.astro';
import XmlJsonConverter from './tools/XmlJsonConverter.astro';
import HtmlEntityEncoder from './tools/HtmlEntityEncoder.astro';
import MimeLookup from './tools/MimeLookup.astro';
import NumberBaseConverter from './tools/NumberBaseConverter.astro';
import StringInspector from './tools/StringInspector.astro';
import CsvJsonConverter from './tools/CsvJsonConverter.astro';
import JsonToTs from './tools/JsonToTs.astro';
import JsonToJava from './tools/JsonToJava.astro';
import MavenGradle from './tools/MavenGradle.astro';
import QuartzCron from './tools/QuartzCron.astro';
import LoremIpsum from './tools/LoremIpsum.astro';
import SqlFormatter from './tools/SqlFormatter.astro';
import HtmlFormatter from './tools/HtmlFormatter.astro';
import CssFormatter from './tools/CssFormatter.astro';
import JsBeautifier from './tools/JsBeautifier.astro';
import JavaDecompiler from './tools/JavaDecompiler.astro';
import JavaStackTrace from './tools/JavaStackTrace.astro';
import PropertiesYaml from './tools/PropertiesYaml.astro';
import JavaFormatString from './tools/JavaFormatString.astro';
import JavaFormatter from './tools/JavaFormatter.astro';
import BytecodeViewer from './tools/BytecodeViewer.astro';
import JwtSign from './tools/JwtSign.astro';
import SslCertInspector from './tools/SslCertInspector.astro';
import ThreadDumpAnalyzer from './tools/ThreadDumpAnalyzer.astro';
import WordCounter from './tools/WordCounter.astro';
import HexEncoder from './tools/HexEncoder.astro';
import HttpStatus from './tools/HttpStatus.astro';
import UnitConverter from './tools/UnitConverter.astro';
import ColorConverter from './tools/ColorConverter.astro';
import ImageWebp from './tools/ImageWebp.astro';
import CidrCalculator from './tools/CidrCalculator.astro';
import MarkdownHtml from './tools/MarkdownHtml.astro';
import YamlJson from './tools/YamlJson.astro';
import QrCode from './tools/QrCode.astro';
import SvgOptimizer from './tools/SvgOptimizer.astro';

const TOOL_MAP: Record<string, any> = {
  'json-formatter': JsonFormatter,
  base64: Base64,
  'cron-parser': CronParser,
  'uuid-generator': UuidGenerator,
  'regex-tester': RegexTester,
  'jwt-decoder': JwtDecoder,
  'timestamp-converter': TimestampConverter,
  'url-encoder': UrlEncoder,
  'hash-generator': HashGenerator,
  'slug-generator': SlugGenerator,
  'password-generator': PasswordGenerator,
  bcrypt: BcryptTool,
  'text-diff': TextDiff,
  'case-normalizer': CaseNormalizer,
  'curl-converter': CurlConverter,
  'query-string-parser': QueryStringParser,
  'xml-json': XmlJsonConverter,
  'html-entity-encoder': HtmlEntityEncoder,
  'mime-lookup': MimeLookup,
  'number-base-converter': NumberBaseConverter,
  'string-inspector': StringInspector,
  'csv-json': CsvJsonConverter,
  'json-typescript': JsonToTs,
  'json-java': JsonToJava,
  'maven-gradle': MavenGradle,
  'quartz-cron': QuartzCron,
  'lorem-ipsum': LoremIpsum,
  'sql-formatter': SqlFormatter,
  'html-formatter': HtmlFormatter,
  'css-formatter': CssFormatter,
  'js-beautifier': JsBeautifier,
  'java-decompiler': JavaDecompiler,
  'java-stack-trace': JavaStackTrace,
  'properties-yaml': PropertiesYaml,
  'java-format-string': JavaFormatString,
  'java-formatter': JavaFormatter,
  'bytecode-viewer': BytecodeViewer,
  'jwt-sign': JwtSign,
  'ssl-cert-inspector': SslCertInspector,
  'thread-dump-analyzer': ThreadDumpAnalyzer,
  'word-counter': WordCounter,
  'hex-encoder': HexEncoder,
  'http-status': HttpStatus,
  'unit-converter': UnitConverter,
  'color-converter': ColorConverter,
  'image-webp': ImageWebp,
  'cidr-calculator': CidrCalculator,
  'markdown-html': MarkdownHtml,
  'yaml-json': YamlJson,
  'qr-code': QrCode,
  'svg-optimizer': SvgOptimizer,
};

interface Props {
  lang: Lang;
  tool: Tool;
}

const { lang, tool } = Astro.props;
const isRu = lang === 'ru';
const catMeta = CAT_META[tool.cat];
const slug = toolSlug(tool);
const ui = TOOL_UI[lang];
const ToolComponent = TOOL_MAP[slug];

const name = isRu ? toolNameRu[tool.name] || tool.name : tool.name;
const desc = isRu ? toolDescRu[tool.name] || tool.desc : tool.desc;
const catLabel = isRu ? catLabelRu[tool.cat] || catMeta.label : catMeta.label;
const toolsPath = '/tools/';

const hints = PRO_HINTS[lang][slug] ?? [];
const snip = API_SNIPPETS[slug] ?? null;

const content = isRu ? (TOOL_CONTENT_RU[slug] ?? null) : (TOOL_CONTENT_EN[slug] ?? null);

const related = CATALOG.filter((t) => t.cat === tool.cat && !t.soon && toolSlug(t) !== slug).slice(
  0,
  3
);

const seoTitleBase = isRu ? name : (SEO_TITLE[slug] ?? name);
const seoTitle = `${seoTitleBase} — whittly`;
const seoDesc = isRu ? (SEO_DESC_RU[slug] ?? desc) : (SEO_DESC[slug] ?? desc);

const SITE = isRu ? 'https://ru.whittly.dev' : 'https://whittly.dev';
const toolUrl = `${SITE}/tools/${slug}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: seoTitleBase,
  description: seoDesc,
  url: toolUrl,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  provider: { '@type': 'Organization', name: 'whittly', url: SITE },
};
---

<style is:global>
  .tool-page {
    padding: 48px 0 64px;
  }

  .tool-related {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 0.5px solid var(--line);
  }

  .tool-related-head {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-soft);
    letter-spacing: 0.06em;
    text-transform: lowercase;
    margin-bottom: 16px;
  }

  .tool-related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .tool-related-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    background: var(--surface);
    border: 0.5px solid var(--line);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.12s,
      transform 0.12s;
  }

  .tool-related-card:hover {
    border-color: var(--line-strong);
    transform: translateY(-1px);
  }
  .tool-related-card i {
    font-size: 20px;
    color: var(--ink-soft);
  }
  .tool-related-name {
    font-size: 15.5px;
    font-weight: 500;
    color: var(--ink);
  }
  .tool-related-desc {
    font-size: 14px;
    color: var(--ink-faint);
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .tool-related-grid {
      grid-template-columns: 1fr;
    }
  }

  .tool-info {
    margin-top: 64px;
    padding-top: 48px;
    border-top: 0.5px solid var(--line);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px 64px;
  }

  .tool-info-faq {
    grid-column: 1 / -1;
  }

  .tool-info-head {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-soft);
    letter-spacing: 0.06em;
    text-transform: lowercase;
    margin-bottom: 16px;
  }

  .tool-info-about p,
  .tool-info-uses ul,
  .tool-info-uses li {
    font-size: 16px;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .tool-info-uses ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tool-info-uses li::before {
    content: '→';
    color: var(--accent);
    margin-right: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
  }

  .tool-faq-item {
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 0.5px solid var(--line);
  }

  .tool-faq-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .tool-faq-q {
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .tool-faq-a {
    font-size: 15.5px;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    .tool-info {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .tool-info-faq {
      grid-column: 1;
    }
  }

  .tool-page-top {
    display: flex;
    align-items: flex-start;
    margin-bottom: 40px;
  }

  .tool-page-header {
    max-width: 640px;
    flex: 1;
  }

  .tool-breadcrumb {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--ink-faint);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tool-breadcrumb a {
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.12s;
  }
  .tool-breadcrumb a:hover {
    color: var(--ink);
  }
  .tool-breadcrumb .sep {
    color: var(--line-strong);
  }

  .tool-page-header h1 {
    margin: 0 0 10px;
  }

  .tool-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .tool-pin-btn {
    margin-left: auto;
    background: none;
    border: 0.5px solid var(--line);
    border-radius: 999px;
    padding: 3px 10px;
    cursor: pointer;
    color: var(--ink-faint);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.12s;
    flex-shrink: 0;
  }
  .tool-pin-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .tool-pin-btn.pinned {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .tool-cat-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    color: var(--ink-faint);
    background: var(--surface);
    border: 0.5px solid var(--line);
    padding: 3px 8px;
    border-radius: 999px;
  }

  .tool-new-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 2px 7px;
    border-radius: 3px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .tool-area {
    background: var(--surface);
    border: 0.5px solid var(--line);
    border-radius: var(--radius-lg);
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 12px;
    color: var(--ink-faint);
    font-family: 'JetBrains Mono', monospace;
    font-size: 15px;
  }
  .tool-area i {
    font-size: 34px;
    color: var(--line-strong);
  }

  /* ── API panel ── */
  .tool-api {
    margin-top: 10px;
    border: 0.5px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface);
  }

  .tool-api-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    color: var(--ink-soft);
    background: var(--surface-sunken);
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background 0.12s;
  }
  .tool-api-toggle:hover {
    background: var(--accent-soft);
  }

  .tool-api-pro {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 0.5px solid var(--accent);
    border-radius: 3px;
    padding: 1px 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .tool-api-chevron {
    margin-left: auto;
    font-size: 15px;
    color: var(--ink-faint);
    transition: transform 0.18s;
  }
  .tool-api.open .tool-api-chevron {
    transform: rotate(180deg);
  }

  .tool-api-body {
    display: none;
    border-top: 0.5px solid var(--line);
  }
  .tool-api.open .tool-api-body {
    display: block;
  }

  .tool-api-tabs {
    display: flex;
    gap: 0;
    border-bottom: 0.5px solid var(--line);
    background: var(--surface-sunken);
  }

  .tool-api-tab {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    padding: 7px 14px;
    border: none;
    background: none;
    color: var(--ink-faint);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 0.12s;
    margin-bottom: -0.5px;
  }
  .tool-api-tab:hover {
    color: var(--ink);
  }
  .tool-api-tab.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .tool-api-snip {
    display: none;
    padding: 14px 18px;
    margin: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink);
    background: var(--surface);
    overflow-x: auto;
    white-space: pre;
  }
  .tool-api-snip.active {
    display: block;
  }

  .tool-api-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 14px;
    border-top: 0.5px solid var(--line);
    background: var(--surface-sunken);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    color: var(--ink-faint);
    gap: 10px;
  }
  .tool-api-footer a {
    color: var(--accent);
    text-decoration: none;
  }
  .tool-api-footer a:hover {
    text-decoration: underline;
  }

  .tool-api-copy {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    padding: 3px 10px;
    border-radius: 4px;
    border: 0.5px solid var(--line-strong);
    background: none;
    color: var(--ink-faint);
    cursor: pointer;
    transition: all 0.12s;
    flex-shrink: 0;
  }
  .tool-api-copy:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ── Share config ── */
  .tool-share-row {
    margin-top: 8px;
  }

  .tool-share-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border: 0.5px solid var(--line);
    border-radius: 5px;
    background: none;
    color: var(--ink-faint);
    cursor: pointer;
    transition:
      color 0.12s,
      border-color 0.12s;
  }
  .tool-share-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .tool-share-btn.done {
    color: var(--good);
    border-color: var(--good);
  }
  .tool-share-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .tool-share-btn:disabled:hover {
    color: var(--ink-faint);
    border-color: var(--line);
  }

  /* ── Pro hint strip ── */
  .tool-pro-strip {
    margin-top: 6px;
    padding: 8px 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    border: 0.5px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
  }

  .tps-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    flex-shrink: 0;
    margin-right: 2px;
  }

  .tps-hint {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13.5px;
    color: var(--ink-faint);
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .tps-pro {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 0.5px solid var(--accent);
    border-radius: 3px;
    padding: 1px 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .tps-sep {
    color: var(--line-strong);
    font-size: 13px;
  }

  .tps-link {
    margin-left: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--accent);
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.12s;
  }
  .tps-link:hover {
    opacity: 0.7;
  }
</style>

<Base title={seoTitle} description={seoDesc} jsonLd={jsonLd}>
  <div class="tool-page">
    <div class="tool-breadcrumb">
      <a href={toolsPath}>{ui.breadcrumbTools}</a>
      <span class="sep">/</span>
      <a href={`/tools/${tool.cat}/`}>{catLabel}</a>
      <span class="sep">/</span>
      <span>{name}</span>
    </div>

    <div class="tool-page-top">
      <header class="tool-page-header">
        <div class="tool-meta">
          <span class="tool-cat-badge">// {catLabel}</span>
          {tool.new && <span class="tool-new-badge">new</span>}
        </div>
        <h1>
          <i
            class={`ti ${tool.icon}`}
            style="font-size: 0.75em; vertical-align: middle; margin-right: 12px; color: var(--ink-soft);"
          ></i>
          {name}
        </h1>
        <p class="subhead">{desc}</p>
      </header>
      <button class="tool-pin-btn" id="toolPinBtn" type="button">
        <i class="ti ti-star"></i>
      </button>
    </div>

    {
      ToolComponent ? (
        <ToolComponent lang={lang} />
      ) : (
        <div class="tool-area">
          <i class={`ti ${tool.icon}`} />
          <span>{ui.toolComingSoon}</span>
        </div>
      )
    }

    <div class="tool-share-row" id="toolShareRow" style="display:none">
      <button class="tool-share-btn" id="toolShareBtn" type="button">
        <i class="ti ti-share-3"></i>
        {isRu ? 'поделиться конфигурацией' : 'share configuration'}
      </button>
    </div>

    {
      snip && (
        <div class="tool-api" id="toolApiPanel">
          <button class="tool-api-toggle" id="toolApiToggle" type="button">
            <i class="ti ti-code" />
            {ui.apiToggleLabel}
            <span class="tool-api-pro">api</span>
            <i class="ti ti-chevron-down tool-api-chevron" />
          </button>
          <div class="tool-api-body">
            <div class="tool-api-tabs">
              <button class="tool-api-tab active" data-tab="curl">
                curl
              </button>
              <button class="tool-api-tab" data-tab="fetch">
                fetch
              </button>
              <button class="tool-api-tab" data-tab="axios">
                axios
              </button>
            </div>
            <pre class="tool-api-snip active" id="taSnipCurl">
              {snip.curl}
            </pre>
            <pre class="tool-api-snip" id="taSnipFetch">
              {snip.fetch}
            </pre>
            <pre class="tool-api-snip" id="taSnipAxios">
              {snip.axios}
            </pre>
            <div class="tool-api-footer">
              <span>
                {isRu ? 'API доступен на тарифе' : 'API access on'}{' '}
                <a href={ui.proUpgradePath}>{isRu ? 'Developer' : 'Developer plan'}</a>
              </span>
              <button class="tool-api-copy" id="toolApiCopy">
                {isRu ? 'копировать' : 'copy'}
              </button>
            </div>
          </div>
        </div>
      )
    }

    {
      hints.length > 0 && (
        <div class="tool-pro-strip">
          <span class="tps-label">// pro</span>
          {hints.map((h, i) => (
            <>
              {i > 0 && <span class="tps-sep">·</span>}
              <span class="tps-hint">
                {h} <span class="tps-pro">pro</span>
              </span>
            </>
          ))}
          <a href={ui.proUpgradePath} class="tps-link">
            {ui.proUpgradeLabel}
          </a>
        </div>
      )
    }
  </div>

  <script
    is:inline
    define:vars={{
      copyLabel: isRu ? 'копировать' : 'copy',
      copiedLabel: isRu ? 'скопировано' : 'copied',
      toolSlug: slug,
      isRu,
    }}
  >
    (function () {
      // hide Pro upsell strip for Pro users
      var plan = window.whApi && window.whApi.getPlan();
      if (plan === 'pro' || plan === 'api') {
        var strip = document.querySelector('.tool-pro-strip');
        if (strip) strip.style.display = 'none';
      }

      // Pin button — must run before early return below
      var PINNED_KEY = 'wh_pinned';
      var pinBtn = document.getElementById('toolPinBtn');
      if (pinBtn) {
        function getPinnedSlugs() {
          try {
            return JSON.parse(localStorage.getItem(PINNED_KEY) || '[]');
          } catch {
            return [];
          }
        }
        function syncPinBtn() {
          var pinned = getPinnedSlugs().includes(toolSlug);
          pinBtn.classList.toggle('pinned', pinned);
          pinBtn.innerHTML =
            '<i class="ti ti-star' +
            (pinned ? '-filled' : '') +
            '"></i><span>' +
            (pinned ? (isRu ? 'в закреплённых' : 'pinned') : isRu ? 'закрепить' : 'pin') +
            '</span>';
        }
        function isProUser() {
          if (!window.whApi || typeof window.whApi.getPlan !== 'function') return false;
          var p = window.whApi.getPlan();
          return p === 'pro' || p === 'api';
        }
        function pushRemotePins(slugs) {
          if (!isProUser()) return;
          window.whApi
            .fetch('/user/pins', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slugs: slugs }),
            })
            .catch(function () {});
        }
        function fetchRemotePins() {
          if (!isProUser()) return;
          window.whApi
            .fetch('/user/pins')
            .then(function (r) {
              return r.json();
            })
            .then(function (data) {
              if (Array.isArray(data.pins)) {
                localStorage.setItem(PINNED_KEY, JSON.stringify(data.pins));
                syncPinBtn();
              }
            })
            .catch(function () {});
        }
        syncPinBtn();
        fetchRemotePins();
        pinBtn.addEventListener('click', function () {
          var slugs = getPinnedSlugs();
          var idx = slugs.indexOf(toolSlug);
          if (idx === -1) slugs.push(toolSlug);
          else slugs.splice(idx, 1);
          localStorage.setItem(PINNED_KEY, JSON.stringify(slugs));
          syncPinBtn();
          pushRemotePins(slugs);
        });
      }

      var panel = document.getElementById('toolApiPanel');
      var toggle = document.getElementById('toolApiToggle');
      var copyBtn = document.getElementById('toolApiCopy');
      if (!toggle) return;

      var tabs = document.querySelectorAll('.tool-api-tab');
      var snips = {
        curl: document.getElementById('taSnipCurl'),
        fetch: document.getElementById('taSnipFetch'),
        axios: document.getElementById('taSnipAxios'),
      };
      var activeTab = 'curl';

      toggle.addEventListener('click', function () {
        panel.classList.toggle('open');
      });

      tabs.forEach(function (btn) {
        btn.addEventListener('click', function () {
          tabs.forEach(function (b) {
            b.classList.remove('active');
          });
          Object.values(snips).forEach(function (s) {
            if (s) s.classList.remove('active');
          });
          btn.classList.add('active');
          activeTab = btn.dataset.tab;
          if (snips[activeTab]) snips[activeTab].classList.add('active');
        });
      });

      copyBtn &&
        copyBtn.addEventListener('click', function () {
          var el = snips[activeTab];
          if (!el) return;
          navigator.clipboard.writeText(el.textContent || '').then(function () {
            copyBtn.textContent = copiedLabel;
            setTimeout(function () {
              copyBtn.textContent = copyLabel;
            }, 1500);
          });
        });
    })();
  </script>

  <script is:inline define:vars={{ isRu }}>
    (function () {
      var shareRow = document.getElementById('toolShareRow');
      var shareBtn = document.getElementById('toolShareBtn');
      if (!shareRow || !shareBtn) return;

      shareRow.style.display = '';

      if (!window.toolGetPreset) {
        shareBtn.disabled = true;
        shareBtn.title = isRu ? 'недоступно для этого инструмента' : 'not available for this tool';
      }

      /* ── restore from URL on load ── */
      var sp = new URLSearchParams(location.search);
      var encoded = sp.get('s');
      if (encoded) {
        requestAnimationFrame(function () {
          try {
            var preset = JSON.parse(atob(decodeURIComponent(encoded)));
            if (window.toolSetPreset) window.toolSetPreset(preset);
          } catch (e) {}
        });
      }

      /* ── share button ── */
      shareBtn.addEventListener('click', function () {
        if (!window.toolGetPreset) return;
        var preset = window.toolGetPreset();
        var s = encodeURIComponent(btoa(JSON.stringify(preset)));
        var url = location.origin + location.pathname + '?s=' + s;
        navigator.clipboard.writeText(url).then(function () {
          shareBtn.classList.add('done');
          shareBtn.innerHTML =
            '<i class="ti ti-check"></i> ' + (isRu ? 'ссылка скопирована' : 'link copied');
          setTimeout(function () {
            shareBtn.classList.remove('done');
            shareBtn.innerHTML =
              '<i class="ti ti-share-3"></i> ' +
              (isRu ? 'поделиться конфигурацией' : 'share configuration');
          }, 2000);
          history.replaceState(null, '', url);
        });
      });
    })();
  </script>

  {
    related.length > 0 && (
      <div class="tool-related">
        <h2 class="tool-related-head">{isRu ? '// похожие инструменты' : '// related tools'}</h2>
        <div class="tool-related-grid">
          {related.map((t) => {
            const rSlug = toolSlug(t);
            const rName = isRu ? (toolNameRu[t.name] ?? t.name) : t.name;
            const rDesc = isRu ? (toolDescRu[t.name] ?? t.desc) : t.desc;
            return (
              <a class="tool-related-card" href={`/tools/${rSlug}/`}>
                <i class={`ti ${t.icon}`} />
                <span class="tool-related-name">{rName}</span>
                <span class="tool-related-desc">{rDesc}</span>
              </a>
            );
          })}
        </div>
      </div>
    )
  }

  {
    content && (
      <div class="tool-info">
        <section class="tool-info-about">
          <h2 class="tool-info-head">{isRu ? '// о инструменте' : '// about this tool'}</h2>
          <p>{content.about}</p>
        </section>

        <section class="tool-info-uses">
          <h2 class="tool-info-head">{isRu ? '// когда использовать' : '// when to use'}</h2>
          <ul>
            {content.useCases.map((u) => (
              <li>{u}</li>
            ))}
          </ul>
        </section>

        {content.faq.length > 0 && (
          <section class="tool-info-faq">
            <h2 class="tool-info-head">// faq</h2>
            {content.faq.map((item) => (
              <div class="tool-faq-item">
                <div class="tool-faq-q">{item.q}</div>
                <div class="tool-faq-a">{item.a}</div>
              </div>
            ))}
          </section>
        )}
      </div>
    )
  }
</Base>
