---
import Base from '@/layouts/Base.astro';
---

<style is:global>
  .nf {
    padding: 80px 0 120px;
    max-width: 540px;
  }

  .nf-code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .nf h1 {
    margin-bottom: 16px;
  }

  .nf-sub {
    font-size: 16px;
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0 0 36px;
  }

  .nf-links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .nf-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 18px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s;
  }

  .nf-link.filled {
    background: var(--accent);
    color: white;
  }
  .nf-link.filled:hover {
    opacity: 0.85;
  }
  .nf-link.outline {
    border: 0.5px solid var(--line-strong);
    color: var(--ink-soft);
  }
  .nf-link.outline:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .nf-path {
    margin-top: 40px;
    padding: 10px 16px;
    background: var(--surface);
    border: 0.5px solid var(--line);
    border-radius: var(--radius-md);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--ink-faint);
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .nf-path .nf-path-url {
    color: var(--bad);
  }
</style>

<Base title="404 — whittly">
  <div class="nf">
    <div class="nf-code">// ошибка 404</div>
    <h1>страница не найдена.</h1>
    <p class="nf-sub">
      такой страницы не существует. возможно, адрес изменился или в нём опечатка.
    </p>
    <div class="nf-links">
      <a class="nf-link filled" href="/">← главная</a>
      <a class="nf-link outline" href="/tools/">все инструменты</a>
    </div>
    <div class="nf-path">
      <span>$</span>
      <span class="nf-path-url" id="nfUrl"></span>
      <span>→ 404</span>
    </div>
  </div>
</Base>

<script is:inline>
  document.getElementById('nfUrl').textContent = location.pathname;
</script>
