---
import Base from '@/layouts/Base.astro';
import '@/styles/account.css';

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3001';
---

<Base title="сброс пароля — whittly" description="Сбросьте пароль от аккаунта whittly.">
  <div class="ac-auth-wrap">
    <div class="ac-auth-card">
      <div class="ac-auth-top">
        <div class="ac-auth-tag">// аккаунт</div>
        <h1 class="ac-auth-title">сброс пароля</h1>
      </div>

      <div class="ac-auth-body">
        <div class="ac-error-msg" id="errMsg"></div>
        <div class="ac-success-msg" id="okMsg"></div>

        <div class="ac-field">
          <label for="email">email</label>
          <input
            class="ac-input"
            id="email"
            type="email"
            autocomplete="email"
            spellcheck="false"
            placeholder="you@example.com"
          />
        </div>

        <button class="ac-btn" id="submitBtn">отправить ссылку</button>

        <div class="ac-footer-row">
          <a class="ac-footer-link" href="/account/login/"><em>← назад к входу</em></a>
        </div>
      </div>
    </div>
  </div>
</Base>

<script is:inline define:vars={{ API }}>
  (function () {
    var emailEl = document.getElementById('email');
    var submitEl = document.getElementById('submitBtn');
    var errEl = document.getElementById('errMsg');
    var okEl = document.getElementById('okMsg');

    function showError(msg) {
      errEl.textContent = msg;
      errEl.classList.add('visible');
    }
    function showOk(msg) {
      okEl.textContent = msg;
      okEl.classList.add('visible');
    }

    async function submit() {
      errEl.classList.remove('visible');
      okEl.classList.remove('visible');
      var email = emailEl.value.trim();
      if (!email) {
        showError('введите email');
        return;
      }

      submitEl.disabled = true;
      submitEl.textContent = 'отправляем…';

      try {
        await fetch(API + '/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, lang: 'ru' }),
        });
        showOk('если такой email зарегистрирован — ссылка отправлена.');
        submitEl.disabled = true;
        submitEl.textContent = 'отправлено';
      } catch {
        showError('сервер недоступен — попробуй позже');
        submitEl.disabled = false;
        submitEl.textContent = 'отправить ссылку';
      }
    }

    submitEl.addEventListener('click', submit);
    emailEl.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') submit();
    });
  })();
</script>
